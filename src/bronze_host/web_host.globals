# Host-globals manifest for a bronze-compiled app hosted by bro.
#
# One identifier per line. Compile the app against it with bronze's
# --host-globals flag:
#
#     bronze build app.js -o app.obj --emit-obj \
#         --host-globals src/bronze_host/web_host.globals
#
# Every name here is registered, in this order, by
# installWebHostGlobals(engine) (dom_globals.cpp, plus the per-family
# install* calls at its foot) — the two lists must stay identical, or a
# compiled read reaches a registry with no value in it.
# console is NOT here: bronze's own runtime provides it.
document
window
self
addEventListener
removeEventListener
dispatchEvent
getComputedStyle
requestAnimationFrame
cancelAnimationFrame
performance
WebGL2RenderingContext
