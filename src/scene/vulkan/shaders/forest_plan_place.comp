#version 450
// The forest planner's passes over the items (scene_forest_gpu_plan.cpp), a
// thread an item (a tree of a view), dispatched over the item blocks in use
// (FP_A_ITEM_DISPATCH). A block holds one view's items, so one search's.
//   PLAN_COST   one round of the budget's search (push.round): each item's
//               vertices against the budget at the round's ask, summed into
//               SHARED (fitDetail's cost(); round 0 keeps each item's at
//               detail 1, round 1 marks those the same at kMaxDetail, which
//               the later rounds skip, as ForestPlan::CostSplit does)
//   PLAN_COUNT  each item's entries a group and leaves a posed group at the
//               settled detail, summed a block (FP_W_SUMS, column-major, a
//               column FP_N_ITEM_GROUPS long, for the scan to place), and
//               the stats' tallies
//   PLAN_WRITE  the entries, each at its place: the block's from the scan,
//               then the items' before it in the block (so a group's
//               entries go in item order, an item's in addTree's)

#include "scene_forest_plan.glsl"

layout(local_size_x = FP_GROUP_SIZE) in;

shared uint sView;

uint viewOfBlock(Item it) {
    if (gl_LocalInvocationID.x == 0u) sView = it.view;
    barrier();
    return sView;
}

// The block's deferred twig jobs (gTwigJob, scene_forest_plan.glsl), their
// clumps end to end shared out a clump a thread. Every thread of the block
// calls it, after its item's addTree. In MODE_COST and MODE_COUNT each
// clump's vertices (and entries, plain and fine) go to its tree's tally,
// added to the thread's own after; in MODE_EMIT each clump's entries are
// written at its tree's twig places in clump order (a chunk of clumps at a
// time, each tree's places running on from the chunk before).
shared uint sTwRun[FP_GROUP_SIZE];      // the jobs' clump counts, then their inclusive scan
shared uint sTwTree[FP_GROUP_SIZE];
shared uint sTwFirst[FP_GROUP_SIZE];
shared uint sTwFlags[FP_GROUP_SIZE];    // 1 shoots, 2 may be fine
shared float sTwMin[2][FP_GROUP_SIZE];  // shoots', fine rows' least
shared uint sTwAcc[3][FP_GROUP_SIZE];   // MODE_COST/COUNT: vertices, plain and fine entries;
                                        // MODE_EMIT: each tree's next plain and fine places
shared float sTwEntry[3][FP_GROUP_SIZE];   // MODE_EMIT: widening, keep, fade
shared uint sTwScan[2][FP_GROUP_SIZE];

TwigJob sharedJob(uint j) {
    TwigJob job;
    job.on = true;
    job.first = sTwFirst[j];
    job.shoots = (sTwFlags[j] & 1u) != 0u;
    job.mayFine = (sTwFlags[j] & 2u) != 0u;
    job.shootMin = sTwMin[0][j];
    job.fineMin = sTwMin[1][j];
    return job;
}

void inclusiveScan(uint t) {
    for (uint step = 1u; step < uint(FP_GROUP_SIZE); step <<= 1) {
        uint add = t >= step ? sTwRun[t - step] : 0u;
        barrier();
        sTwRun[t] += add;
        barrier();
    }
}

// The job whose run holds `w` (the first run ending past it).
uint jobOf(uint w) {
    uint lo = 0u, hi = uint(FP_GROUP_SIZE) - 1u;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1;
        if (sTwRun[mid] > w) hi = mid; else lo = mid + 1u;
    }
    return lo;
}

void twigs(uint t, Item it) {
    TwigJob mine = gTwigJob;
    bool on = it.valid && mine.on && mine.count > 0u;
    sTwRun[t] = on ? mine.count : 0u;
    sTwTree[t] = it.tree;
    sTwFirst[t] = mine.first;
    sTwFlags[t] = (mine.shoots ? 1u : 0u) | (mine.mayFine ? 2u : 0u);
    sTwMin[0][t] = mine.shootMin;
    sTwMin[1][t] = mine.fineMin;
    if (gMode == MODE_EMIT) {
        sTwAcc[0][t] = mine.base[0];
        sTwAcc[1][t] = mine.base[1];
        sTwEntry[0][t] = mine.widening;
        sTwEntry[1][t] = mine.keep;
        sTwEntry[2][t] = mine.fade;
    } else {
        sTwAcc[0][t] = 0u;
        sTwAcc[1][t] = 0u;
        sTwAcc[2][t] = 0u;
    }
    barrier();
    inclusiveScan(t);
    uint total = sTwRun[FP_GROUP_SIZE - 1];
    if (total == 0u) return;
    const uint per = uint(FOREST_TWIG_PIECES_PER_ENTRY);
    if (gMode != MODE_EMIT) {
        for (uint w = t; w < total; w += uint(FP_GROUP_SIZE)) {
            uint j = jobOf(w);
            uint c = sTwFirst[j] + w - (j > 0u ? sTwRun[j - 1u] : 0u);
            uint n;
            bool fine;
            twigClump(sharedJob(j), planTree(sTwTree[j]), c, n, fine);
            uint e = (n + per - 1u) / per;
            atomicAdd(sTwAcc[0][j], e * per * uint(FOREST_TWIG_VERTICES) * (fine ? uint(FOREST_TWIG_FINE_ROWS) : 1u));
            if (e > 0u) atomicAdd(sTwAcc[fine ? 2 : 1][j], e);
        }
        barrier();
        if (on) {
            gVerts += sTwAcc[0][t];
            gCount[G_TWIGS] += sTwAcc[1][t];
            gCount[G_TWIGS_FINE] += sTwAcc[2][t];
        }
        return;
    }
    // MODE_EMIT: a chunk of the block's clumps at a time, their entries'
    // places an inclusive scan (plain, fine) across the chunk.
    for (uint c0 = 0u; c0 < total; c0 += uint(FP_GROUP_SIZE)) {
        uint w = c0 + t;
        uint j = 0u, c = 0u, n = 0u, e = 0u;
        bool fine = false;
        if (w < total) {
            j = jobOf(w);
            c = sTwFirst[j] + w - (j > 0u ? sTwRun[j - 1u] : 0u);
            twigClump(sharedJob(j), planTree(sTwTree[j]), c, n, fine);
            e = (n + per - 1u) / per;
        }
        sTwScan[0][t] = fine ? 0u : e;
        sTwScan[1][t] = fine ? e : 0u;
        barrier();
        for (uint step = 1u; step < uint(FP_GROUP_SIZE); step <<= 1) {
            uint a0 = t >= step ? sTwScan[0][t - step] : 0u;
            uint a1 = t >= step ? sTwScan[1][t - step] : 0u;
            barrier();
            sTwScan[0][t] += a0;
            sTwScan[1][t] += a1;
            barrier();
        }
        if (w < total) {
            // Its tree's clumps in this chunk start at `s` (the chunk's
            // first, or the tree's run's): its places run on from there.
            uint runStart = j > 0u ? sTwRun[j - 1u] : 0u;
            uint s = max(runStart, c0) - c0;
            uint g = fine ? 1u : 0u;
            uint before = sTwScan[g][t] - e - (s > 0u ? sTwScan[g][s - 1u] : 0u);
            uint at = sTwAcc[g][j] + before;
            for (uint p = 0u; p < n; p += per)
                entryAt(at++, sTwTree[j], p, min(p + per, n), c, sTwEntry[0][j], sTwEntry[1][j], 1.0,
                        sTwEntry[2][j], vec3(0.0), 0xffffffffu);
        }
        barrier();
        // Each tree's places past this chunk's: the thread at its last
        // clump here moves them.
        if (w < total) {
            uint runEnd = sTwRun[j];
            bool last = w + 1u == runEnd || t + 1u == uint(FP_GROUP_SIZE) || w + 1u == total;
            if (last) {
                uint runStart = j > 0u ? sTwRun[j - 1u] : 0u;
                uint s = max(runStart, c0) - c0;
                for (uint g = 0u; g < 2u; ++g)
                    sTwAcc[g][j] += sTwScan[g][t] - (s > 0u ? sTwScan[g][s - 1u] : 0u);
            }
        }
        barrier();
    }
}

#if defined(PLAN_WRITE)
// The block's long runs (deferRun, scene_forest_plan.glsl), their entries
// end to end shared out an entry a thread. Every thread of the block calls
// it, after its item's addTree and twigs.
shared uint sRunEnd[FP_RUN_JOBS];   // the jobs' entries, an inclusive scan

void runs(uint t) {
    barrier();
    uint jobs = min(sRunCount, uint(FP_RUN_JOBS));
    if (jobs == 0u) return;
    if (t == 0u) {
        uint acc = 0u;
        for (uint j = 0u; j < jobs; ++j) {
            acc += sRunB[j].w;
            sRunEnd[j] = acc;
        }
    }
    barrier();
    uint total = sRunEnd[jobs - 1u];
    for (uint w = t; w < total; w += uint(FP_GROUP_SIZE)) {
        uint lo = 0u, hi = jobs - 1u;
        while (lo < hi) {
            uint mid = (lo + hi) >> 1;
            if (sRunEnd[mid] > w) hi = mid; else lo = mid + 1u;
        }
        uvec4 a = sRunA[lo], b = sRunB[lo];
        vec4 c = sRunC[lo];
        uint i = w - (lo > 0u ? sRunEnd[lo - 1u] : 0u);
        uint first = i * a.w;
        uint slot = b.z == 0xffffffffu ? 0xffffffffu : b.z + first;
        entryAt(b.y + i, a.x, a.y + first, a.y + min(first + a.w, a.z), b.x, c.x, c.y, c.z, c.w, sRunD[lo].xyz,
                slot);
    }
}
#endif

#if defined(PLAN_COST)
// Per search (the camera's, the shadow's): the block's sum at the ask and
// its fixed trees' (uint64 as lo, carries).
shared uint sSum[2][2], sFixed[2][2];
shared uint sVary, sVaryAt;

void sharedAdd(bool fixedSum, uint q, uint v) {
    if (v == 0u) return;
    uint old = fixedSum ? atomicAdd(sFixed[q][0], v) : atomicAdd(sSum[q][0], v);
    if (old + v < old) {
        if (fixedSum) atomicAdd(sFixed[q][1], 1u); else atomicAdd(sSum[q][1], 1u);
    }
}

// Rounds 0 and 1 walk every item (dispatched over the item blocks); round 1
// lists the items whose cost differs from detail 1's (FP_W_VARY), and the
// later rounds walk those alone (push.offset 1, dispatched over the list):
// a far view's trees are crowns at any detail, and every round walked them
// all (a vista's search 0.37 GPU ms).
void main() {
    planBegin();
    gMode = MODE_COST;
    uint t = gl_LocalInvocationID.x;
    if (t < 2u) { sSum[t][0] = 0u; sSum[t][1] = 0u; sFixed[t][0] = 0u; sFixed[t][1] = 0u; }
    if (t == 0u) sVary = 0u;
    barrier();
    uint round = planPush.round;
    bool listed = planPush.offset != 0u;
    uint index = gl_WorkGroupID.x * uint(FP_GROUP_SIZE) + t;
    uint vary = workRun(FP_W_VARY);
    if (listed) index = index < planWork.w[FP_N_VARY_COUNT] ? planWork.w[vary + index] : FP_NO_ITEM;
    Item it = planItem(index == FP_NO_ITEM ? FP_NO_ITEM : planWork.w[workRun(FP_W_ITEMS) + index]);
    uint q = it.view > 0u ? 1u : 0u;
    Search s = planSearch(q, round);
    bool varies = false;
    bool run = it.valid && !s.done;
    gDeferTwigs = true;
    gTwigJob.on = false;
    if (run) planItemAdd(it, round == 0u ? 1.0 : s.ask);
    twigs(t, it);
    if (run) {
        uint fineAt = workRun(FP_W_FINE) + index;
        uint cost = gVerts - gDrawnOnly;
        if (round == 0u) {
            planWork.w[fineAt] = cost;
        } else if (round == 1u) {
            uint fine = planWork.w[fineAt];
            if (cost == fine) sharedAdd(true, q, fine);
            else varies = true;
        }
        sharedAdd(false, q, cost);
    }
    // (Round 1's varying items listed, a block's at once.)
    uint mine = 0u;
    if (varies) mine = atomicAdd(sVary, 1u);
    barrier();
    if (t == 0u && sVary > 0u) sVaryAt = atomicAdd(planWork.w[FP_N_VARY_COUNT], sVary);
    barrier();
    if (varies) planWork.w[vary + sVaryAt + mine] = index;
    if (t < 2u) {
        uint at = FP_G_SUMS + (t * FP_ROUNDS + round) * 2u;
        if (sSum[t][1] > 0u) atomicAdd(planShared.w[at + 1u], sSum[t][1]);
        sharedAdd64(at, sSum[t][0]);
        if (round == 1u) {
            uint f = FP_G_FIXED + t * 2u;
            if (sFixed[t][1] > 0u) atomicAdd(planShared.w[f + 1u], sFixed[t][1]);
            sharedAdd64(f, sFixed[t][0]);
        }
    }
}

#else   // PLAN_COUNT, PLAN_WRITE
shared uint sCol[FP_COLUMNS][FP_GROUP_SIZE];
#if defined(PLAN_COUNT)
// The stats' tallies a block: trees a tier, then leaves, blooms, vertices
// and shadow vertices (two words each).
shared uint sTiers[3];
shared uint sTally[8];
void tallyAdd(uint at, uint v) {
    if (v == 0u) return;
    uint old = atomicAdd(sTally[at], v);
    if (old + v < old) atomicAdd(sTally[at + 1u], 1u);
}
#endif

void main() {
    planBegin();
    uint t = gl_LocalInvocationID.x;
#if defined(PLAN_COUNT)
    if (t < 3u) sTiers[t] = 0u;
    if (t < 8u) sTally[t] = 0u;
#else
    if (t == 0u) sRunCount = 0u;
#endif
    uint block = gl_WorkGroupID.x;
    uint index = block * uint(FP_GROUP_SIZE) + t;
    Item it = planItem(planWork.w[workRun(FP_W_ITEMS) + index]);
    uint q = viewOfBlock(it) > 0u ? 1u : 0u;
    float d = uintBitsToFloat(planShared.w[FP_G_DETAIL + q]);
    gMode = MODE_COUNT;
    gDeferTwigs = true;
    gTwigJob.on = false;
    uint counts[FP_COLUMNS];
    for (int k = 0; k < FP_COLUMNS; ++k) counts[k] = 0u;
    TreeLod lod;
    if (it.valid) lod = planItemAdd(it, d);
    twigs(t, it);
    // (The twigs' entries the workgroup counted, for the write's places.)
    gTwigTotal[0] = sTwAcc[1][t];
    gTwigTotal[1] = sTwAcc[2][t];
    if (!(it.valid && gTwigJob.on)) { gTwigTotal[0] = 0u; gTwigTotal[1] = 0u; }
    barrier();
    if (it.valid) {
        for (int k = 0; k < FP_COLUMNS; ++k) counts[k] = gCount[k];
#if defined(PLAN_COUNT)
        if (it.view == 0u) {
            if (lod.leaves > 0.0) atomicAdd(sTiers[0], 1u);
            if (lod.clumps > 0.0) atomicAdd(sTiers[1], 1u);
            if (lod.crowns > 0.0) atomicAdd(sTiers[2], 1u);
            tallyAdd(0u, gLeaves);
            tallyAdd(2u, gBlooms);
            tallyAdd(4u, gVerts);
        } else {
            tallyAdd(6u, gVerts);
        }
#endif
    }
    for (int k = 0; k < FP_COLUMNS; ++k) sCol[k][t] = counts[k];
    barrier();
#if defined(PLAN_COUNT)
    // The block's sums a column (thread k sums column k).
    if (t < uint(FP_COLUMNS)) {
        uint sum = 0u;
        for (uint i = 0u; i < uint(FP_GROUP_SIZE); ++i) sum += sCol[t][i];
        planWork.w[workRun(FP_W_SUMS) + t * planWork.w[FP_N_ITEM_GROUPS] + block] = sum;
    }
    if (t < 3u && sTiers[t] > 0u) atomicAdd(planWork.w[FP_N_STATS + FP_S_TREES + t], sTiers[t]);
    if (t < 4u) {
        const uint kStat[4] = uint[4](FP_S_LEAVES, FP_S_BLOOMS, FP_S_VERTICES, FP_S_SHADOW_VERTICES);
        uint at = FP_N_STATS + kStat[t];
        if (sTally[2u * t + 1u] > 0u) atomicAdd(planWork.w[at + 1u], sTally[2u * t + 1u]);
        workAdd64(at, sTally[2u * t]);
    }
#else   // PLAN_WRITE
    // Each column's exclusive scan across the block (Hillis-Steele).
    for (uint step = 1u; step < uint(FP_GROUP_SIZE); step <<= 1) {
        uint add[FP_COLUMNS];
        for (int k = 0; k < FP_COLUMNS; ++k) add[k] = t >= step ? sCol[k][t - step] : 0u;
        barrier();
        for (int k = 0; k < FP_COLUMNS; ++k) sCol[k][t] += add[k];
        barrier();
    }
    gEntryCap = pu(FP_P_ENTRY_CAP);
    gMode = MODE_EMIT;
    gTwigJob.on = false;
    if (it.valid) {
        uint G = planWork.w[FP_N_ITEM_GROUPS];
        uint sums = workRun(FP_W_SUMS);
        for (int k = 0; k < FP_GROUPS; ++k) gAt[k] = planWork.w[sums + uint(k) * G + block] + sCol[k][t] - counts[k];
        // The view's posed groups' slots run on from its first block's.
        uint g0 = planWork.w[FP_N_VIEW_BASE + it.view] / uint(FP_GROUP_SIZE);
        for (int j = 0; j < 2; ++j) {
            int pg = posedGroupOf(it.view, j);
            gSlot[j] = 0u;
            gPosed[j] = false;
            if (pg < 0) continue;
            uint col = sums + uint(FP_GROUPS + j) * G;
            gSlot[j] = planWork.w[FP_N_POSE_BASE + pg] + (planWork.w[col + block] - planWork.w[col + g0]) +
                       sCol[FP_GROUPS + j][t] - counts[FP_GROUPS + j];
            gPosed[j] = planWork.w[FP_N_POSED + pg] != 0u;
        }
        planItemAdd(it, d);
    }
    twigs(t, it);
    runs(t);
#endif
}
#endif
