#version 450
// The GPU cell pass (scene_world_cells_pass.cpp): one provider's cells
// against every view's frustum, top-down, in three dependent steps:
//   CELLS_TOP     one workgroup, a top a thread a block at a time: each top
//                 against every view; the tops some view sees listed in
//                 order with the views that see each, and the leaf step's
//                 dispatch (a workgroup a top in view)
//   CELLS_LEAF    a workgroup a top in view, a thread a leaf: each leaf
//                 against the views that see its top; the leaves some view
//                 sees, with their views, items, eye-relative origin, size
//                 in pixels in each view and band (the provider's
//                 thresholds on the camera's size), gathered at the top's
//                 first leaf's place, and the top's counts
//   CELLS_GATHER  one workgroup: the tops' counts scanned, then every cell
//                 in view moved to its place in one list (WC_V_*), each
//                 band's list, the counts, and the dispatch over the items
//                 in view
// The list keeps the cells' order, so a provider whose items are in cell
// order walks the items in view in its own order. A box is tested as the
// provider tests an item in it (the same planes, the same arithmetic, a box
// round the items' boxes): an item a view sees is in a cell that view sees.

#include "world/world_cells_layout.h"

#if defined(CELLS_LEAF)
layout(local_size_x = WC_TOP_LEAVES) in;
#else
layout(local_size_x = WC_GROUP_SIZE) in;
#endif

layout(std430, set = 0, binding = 0) readonly buffer Cells { uint w[]; } cells;
layout(std430, set = 0, binding = 1) readonly buffer Params { uint w[]; } params;
layout(std430, set = 0, binding = 2) buffer Out { uint w[]; } outs;
layout(std430, set = 0, binding = 3) readonly buffer Origins { float w[]; } origins;

float pf(uint i) { return uintBitsToFloat(params.w[i]); }
vec3 cellV3(uint i) {
    return vec3(uintBitsToFloat(cells.w[i]), uintBitsToFloat(cells.w[i + 1u]), uintBitsToFloat(cells.w[i + 2u]));
}

// bromath::fintersects(frustum, box).
bool intersects(uint view, vec3 bmin, vec3 bmax) {
    if (bmin.x > bmax.x || bmin.y > bmax.y || bmin.z > bmax.z) return false;
    uint planes = WC_P_PLANES + view * 24u;
    for (uint i = 0u; i < 6u; ++i) {
        uint at = planes + 4u * i;
        vec4 p = vec4(pf(at), pf(at + 1u), pf(at + 2u), pf(at + 3u));
        vec3 v = vec3(p.x >= 0.0 ? bmax.x : bmin.x, p.y >= 0.0 ? bmax.y : bmin.y, p.z >= 0.0 ? bmax.z : bmin.z);
        precise float d = p.x * v.x + p.y * v.y + p.z * v.z + p.w;
        if (d < 0.0) return false;
    }
    return true;
}

// The views among `within` that see the box.
uvec2 viewsSeeing(vec3 bmin, vec3 bmax, uvec2 within) {
    uvec2 m = uvec2(0u);
    uint views = min(params.w[WC_P_VIEWS], uint(WC_MAX_VIEWS));
    for (uint v = 0u; v < views; ++v) {
        uint bit = 1u << (v & 31u);
        bool in_ = v < 32u ? (within.x & bit) != 0u : (within.y & bit) != 0u;
        if (!in_ || !intersects(v, bmin, bmax)) continue;
        if (v < 32u) m.x |= bit; else m.y |= bit;
    }
    return m;
}

uint leaves() { return cells.w[WC_H_LEAVES]; }
uint topsRun() { return WC_O_HEADER + leaves() * WC_V_WORDS; }
uint stagedRun() { return topsRun() + cells.w[WC_H_TOPS] * WC_T_WORDS; }
uint bandRun(uint b) { return stagedRun() + leaves() * WC_V_WORDS + b * leaves(); }
uint pixelsRun() { return bandRun(uint(WC_BANDS)); }

// The size in pixels of `metres` at `dist` from the camera's eye in view
// `v` (WC_SCALE_*): world_cells.h's projectedPixels, or over a tile's texel.
float projectedPixels(uint v, float metres, float dist) {
    uint s = WC_P_SCALES + v * WC_SCALE_WORDS;
    float focal = pf(s + WC_SCALE_FOCAL);
    if (focal > 0.0) return metres * focal / max(dist, 1e-3);
    return metres / max(pf(s + WC_SCALE_TEXEL) + pf(s + WC_SCALE_TEXEL_PER_METRE) * dist, 1e-6);
}

// Inclusive scans across the workgroup (Hillis-Steele), WC_SCANS at once.
#if defined(CELLS_TOP)
#define WC_SCANS 1
#define WC_SCAN_SIZE WC_GROUP_SIZE
#elif defined(CELLS_LEAF)
#define WC_SCANS 5
#define WC_SCAN_SIZE WC_TOP_LEAVES
#else
#define WC_SCANS 5
#define WC_SCAN_SIZE WC_GROUP_SIZE
#endif
shared uint sScan[WC_SCANS][WC_SCAN_SIZE];
void scanAll(uint t) {
    barrier();
    for (uint step = 1u; step < uint(WC_SCAN_SIZE); step <<= 1) {
        uint add[WC_SCANS];
        for (int k = 0; k < WC_SCANS; ++k) add[k] = t >= step ? sScan[k][t - step] : 0u;
        barrier();
        for (int k = 0; k < WC_SCANS; ++k) sScan[k][t] += add[k];
        barrier();
    }
}

#if defined(CELLS_TOP)
void main() {
    uint t = gl_LocalInvocationID.x;
    // (The leaf step's tallies, from zero.)
    if (t < uint(WC_MAX_VIEWS)) outs.w[WC_O_VIEW_CELLS + t] = 0u;
    if (t < uint(WC_BANDS)) outs.w[WC_O_BAND_ITEMS + t] = 0u;
    uint tops = cells.w[WC_H_TOPS];
    uint at = cells.w[WC_H_TOP_AT];
    uint run = topsRun();
    uint listed = 0u;
    for (uint base = 0u; base < tops; base += uint(WC_GROUP_SIZE)) {
        uint i = base + t;
        uvec2 m = uvec2(0u);
        if (i < tops) {
            uint c = at + i * WC_CELL_WORDS;
            m = viewsSeeing(cellV3(c + WC_CELL_MIN), cellV3(c + WC_CELL_MAX), uvec2(~0u));
        }
        bool seen = m.x != 0u || m.y != 0u;
        sScan[0][t] = seen ? 1u : 0u;
        scanAll(t);
        if (seen) {
            uint o = run + (listed + sScan[0][t] - 1u) * WC_T_WORDS;
            outs.w[o + WC_T_TOP] = i;
            outs.w[o + WC_T_MASK] = m.x;
            outs.w[o + WC_T_MASK + 1u] = m.y;
        }
        listed += sScan[0][WC_GROUP_SIZE - 1];
        barrier();
    }
    if (t == 0u) {
        outs.w[WC_O_TOPS] = listed;
        outs.w[WC_O_TOP_DISPATCH] = listed;
        outs.w[WC_O_TOP_DISPATCH + 1u] = 1u;
        outs.w[WC_O_TOP_DISPATCH + 2u] = 1u;
    }
}

#elif defined(CELLS_LEAF)
void main() {
    uint t = gl_LocalInvocationID.x;
    uint o = topsRun() + gl_WorkGroupID.x * WC_T_WORDS;
    uint top = cells.w[WC_H_TOP_AT] + outs.w[o + WC_T_TOP] * WC_CELL_WORDS;
    uint firstLeaf = cells.w[top + WC_CELL_FIRST];
    uvec2 within = uvec2(outs.w[o + WC_T_MASK], outs.w[o + WC_T_MASK + 1u]);
    uvec2 m = uvec2(0u);
    uint n = 0u, first = 0u, band = WC_BANDS;
    uint leaf = firstLeaf + t;
    if (t < cells.w[top + WC_CELL_COUNT]) {
        uint c = cells.w[WC_H_LEAF_AT] + leaf * WC_CELL_WORDS;
        vec3 bmin = cellV3(c + WC_CELL_MIN), bmax = cellV3(c + WC_CELL_MAX);
        m = viewsSeeing(bmin, bmax, within);
        if (m.x != 0u || m.y != 0u) {
            n = cells.w[c + WC_CELL_COUNT];
            first = cells.w[c + WC_CELL_FIRST];
            // Its size in pixels in each view that sees it (its bounding
            // radius at its nearest distance from the eye), and its band by
            // the provider's thresholds on the camera's (seen or not).
            vec3 eye = vec3(pf(WC_P_EYE), pf(WC_P_EYE + 1u), pf(WC_P_EYE + 2u));
            float dist = length(clamp(eye, bmin, bmax) - eye);
            float radius = 0.5 * length(bmax - bmin);
            uint views = min(params.w[WC_P_VIEWS], uint(WC_MAX_VIEWS));
            uint px = pixelsRun() + leaf * views;
            for (uint v = 0u; v < views; ++v) {
                bool in_ = v < 32u ? (m.x & (1u << v)) != 0u : (m.y & (1u << (v - 32u))) != 0u;
                outs.w[px + v] = floatBitsToUint(in_ ? projectedPixels(v, radius, dist) : 0.0);
            }
            float cam = projectedPixels(0u, radius, dist);
            band = cam >= pf(WC_P_BAND_NEAR_PX) ? WC_BAND_NEAR : (cam < pf(WC_P_BAND_FAR_PX) ? WC_BAND_FAR : WC_BAND_MID);
        }
    }
    bool seen = n > 0u;
    sScan[0][t] = seen ? 1u : 0u;
    sScan[1][t] = n;
    for (uint b = 0u; b < uint(WC_BANDS); ++b) sScan[2u + b][t] = band == b ? 1u : 0u;
    scanAll(t);
    if (seen) {
        uint v = stagedRun() + (firstLeaf + sScan[0][t] - 1u) * WC_V_WORDS;
        outs.w[v + WC_V_LEAF] = leaf;
        outs.w[v + WC_V_FIRST] = first;
        outs.w[v + WC_V_COUNT] = n;
        outs.w[v + WC_V_PREFIX] = sScan[1][t] - n;
        outs.w[v + WC_V_MASK] = m.x;
        outs.w[v + WC_V_MASK + 1u] = m.y;
        outs.w[v + WC_V_BAND] = band;
        outs.w[v + WC_V_BAND_RANK] = sScan[2u + band][t] - 1u;
        for (uint j = 0u; j < 3u; ++j)
            outs.w[v + WC_V_ORIGIN + j] = floatBitsToUint(origins.w[leaf * WC_ORIGIN_WORDS + j]);
        atomicAdd(outs.w[WC_O_BAND_ITEMS + band], n);
        for (uint b = 0u; b < 32u; ++b)
            if ((m.x & (1u << b)) != 0u) atomicAdd(outs.w[WC_O_VIEW_CELLS + b], 1u);
        if ((m.y & 1u) != 0u) atomicAdd(outs.w[WC_O_VIEW_CELLS + 32u], 1u);
    }
    if (t == uint(WC_TOP_LEAVES) - 1u) {
        outs.w[o + WC_T_CELLS] = sScan[0][t];
        outs.w[o + WC_T_ITEMS] = sScan[1][t];
        for (uint b = 0u; b < uint(WC_BANDS); ++b) outs.w[o + WC_T_BAND_CELLS + b] = sScan[2u + b][t];
    }
}

#else   // CELLS_GATHER
void main() {
    uint t = gl_LocalInvocationID.x;
    uint tops = outs.w[WC_O_TOPS];
    uint run = topsRun();
    // Each top in view's place among the cells in view, its items' among
    // theirs, its cells' in each band's list.
    uint cellsSeen = 0u, items = 0u;
    uint banded[WC_BANDS] = uint[WC_BANDS](0u, 0u, 0u);
    for (uint base = 0u; base < tops; base += uint(WC_GROUP_SIZE)) {
        uint i = base + t;
        uint o = run + i * WC_T_WORDS;
        bool in_ = i < tops;
        sScan[0][t] = in_ ? outs.w[o + WC_T_CELLS] : 0u;
        sScan[1][t] = in_ ? outs.w[o + WC_T_ITEMS] : 0u;
        for (uint b = 0u; b < uint(WC_BANDS); ++b) sScan[2u + b][t] = in_ ? outs.w[o + WC_T_BAND_CELLS + b] : 0u;
        uint own[WC_SCANS];
        for (int k = 0; k < WC_SCANS; ++k) own[k] = sScan[k][t];
        scanAll(t);
        if (in_) {
            outs.w[o + WC_T_CELL_PREFIX] = cellsSeen + sScan[0][t] - own[0];
            outs.w[o + WC_T_ITEM_PREFIX] = items + sScan[1][t] - own[1];
            for (uint b = 0u; b < uint(WC_BANDS); ++b)
                outs.w[o + WC_T_BAND_PREFIX + b] = banded[b] + sScan[2u + b][t] - own[2u + b];
        }
        cellsSeen += sScan[0][WC_GROUP_SIZE - 1];
        items += sScan[1][WC_GROUP_SIZE - 1];
        for (uint b = 0u; b < uint(WC_BANDS); ++b) banded[b] += sScan[2u + b][WC_GROUP_SIZE - 1];
        barrier();
    }
    memoryBarrierBuffer();
    barrier();
    // Every top's cells in view to their places (a top's at most
    // WC_TOP_LEAVES, a thread a slot).
    uint topAt = cells.w[WC_H_TOP_AT], staged = stagedRun();
    for (uint s = t; s < tops * uint(WC_TOP_LEAVES); s += uint(WC_GROUP_SIZE)) {
        uint o = run + (s / uint(WC_TOP_LEAVES)) * WC_T_WORDS, k = s % uint(WC_TOP_LEAVES);
        if (k >= outs.w[o + WC_T_CELLS]) continue;
        uint firstLeaf = cells.w[topAt + outs.w[o + WC_T_TOP] * WC_CELL_WORDS + WC_CELL_FIRST];
        uint from = staged + (firstLeaf + k) * WC_V_WORDS;
        uint index = outs.w[o + WC_T_CELL_PREFIX] + k;
        uint to = WC_O_HEADER + index * WC_V_WORDS;
        for (uint j = 0u; j < uint(WC_V_WORDS); ++j) outs.w[to + j] = outs.w[from + j];
        outs.w[to + WC_V_PREFIX] += outs.w[o + WC_T_ITEM_PREFIX];
        uint band = outs.w[from + WC_V_BAND];
        outs.w[bandRun(band) + outs.w[o + WC_T_BAND_PREFIX + band] + outs.w[from + WC_V_BAND_RANK]] = index;
    }
    if (t < uint(WC_BANDS)) outs.w[WC_O_BAND_CELLS + t] = banded[t];
    if (t == 0u) {
        uint group = max(params.w[WC_P_ITEM_GROUP], 1u);
        outs.w[WC_O_DISPATCH] = max((items + group - 1u) / group, 1u);
        outs.w[WC_O_DISPATCH + 1u] = 1u;
        outs.w[WC_O_DISPATCH + 2u] = 1u;
        outs.w[WC_O_CELLS] = cellsSeen;
        outs.w[WC_O_ITEMS] = items;
    }
}
#endif
