#version 450
// Plants' leaf poses (scene_plants.glsl): each leaf element built once a
// frame, so the corners plants.vert and shadow_plants.vert draw only read
// it. A workgroup a chunk of leaves: push.extra.x the first chunk (its
// index among the frame's chunks), the slot of a chunk's element e being
// chunk * elements a chunk + e.

layout(local_size_x = 32) in;

#include "scene_camera.glsl"
#include "scene_mesh_push.glsl"
#include "scene_plants.glsl"

layout(std430, set = 3, binding = 3) writeonly buffer PlantPoses {
    uvec4 poses[];
} plantPoses;

void main() {
    int perChunk = int(plants.header[0].z);
    int e = int(gl_LocalInvocationID.x);
    if (e >= perChunk) return;
    int chunkIndex = int(push.extra.x) + int(gl_WorkGroupID.x);
    vec4 chunk = plants.records[int(plants.header[1].y) + chunkIndex];
    if (chunk.w > 1.5) return;   // crown discs: built where they are drawn
    PlantLeafPose pose;
    // (chunk.w: 1 a shadow tile's caster.)
    bool drawn = plantLeafPose(int(chunk.x), int(chunk.y) + e, chunk.z, chunk.w > 0.5, pose);
    uvec4 a, b, c, d;
    if (drawn) {
        plantPackPose(pose, true, a, b, c, d);
    } else {
        a = c = d = uvec4(0u);
        b = uvec4(0u);
    }
    int slot = (chunkIndex * perChunk + e) * PLANT_POSE_UVEC4;
    plantPoses.poses[slot] = a;
    plantPoses.poses[slot + 1] = b;
    plantPoses.poses[slot + 2] = c;
    plantPoses.poses[slot + 3] = d;
}
