#version 450
// Forest leaves posed once a leaf (scene_forest_leaf_pose.glsl), for the
// colour draws' vertices to read (mesh_forest_leaf.vert): a vertex then
// only takes its point through its leaf's pose, where it was placing and
// swaying its whole leaf itself. Run over a draw's entries, a workgroup an
// entry (push.extra.z its first), with the draw's push constants and set 3.
// A shadow tile's leaf casters are posed the same way (push.extra.w 1, a
// caster draw's push constants), for shadow_forest_leaf.vert.

layout(local_size_x = 64) in;

#include "scene_camera.glsl"
#include "scene_mesh_push.glsl"
#include "scene_procedural.glsl"
#include "scene_vegetation.glsl"
#define FOREST_POSE_WRITE 1
#include "scene_forest.glsl"
#include "scene_forest_shoot.glsl"
#include "scene_forest_leaf_pose.glsl"

#if defined(FOREST_POSE_INDIRECT)
// The GPU planner's draw (scene_forest_gpu_plan.cpp): dispatched indirectly,
// a workgroup an entry, push.extra.z its posed group, whose first entry the
// planner wrote beside the dispatch (set 1: the planner's set, binding 5).
#include "scene_forest_plan_layout.h"
layout(std430, set = 1, binding = 5) readonly buffer PlanArgs { uint w[]; } planArgs;
int firstEntry() { return int(planArgs.w[FP_A_POSE + 4 * int(push.extra.z + 0.5) + 3]); }
#else
int firstEntry() { return int(push.extra.z + 0.5); }
#endif

void main() {
    forestApplyLook();
    ForestEntry e = forestEntry(firstEntry() + int(gl_WorkGroupID.x));
    if (e.slot < 0) return;
    if (push.extra.w > 0.5) {
        for (int c = int(gl_LocalInvocationID.x); c < e.end - e.first; c += 64)
            forestCasterPoseWrite(e.slot + c, forestCasterPoseLeaf(e, e.first + c));
        return;
    }
    for (int c = int(gl_LocalInvocationID.x); c < e.end - e.first; c += 64)
        forestPoseWrite(e.slot + c, forestPoseLeaf(e, e.first + c));
}
