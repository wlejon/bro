#version 450
// Forest leaves posed once a leaf (scene_forest_leaf_pose.glsl), for the
// colour draws' vertices to read (mesh_forest_leaf.vert): a vertex then
// only takes its point through its leaf's pose, where it was placing and
// swaying its whole leaf itself. Run over a draw's entries, a workgroup an
// entry (push.extra.z its first), with the draw's push constants and set 3.

layout(local_size_x = 64) in;

#include "scene_camera.glsl"
#include "scene_mesh_push.glsl"
#include "scene_procedural.glsl"
#include "scene_vegetation.glsl"
#define FOREST_POSE_WRITE 1
#include "scene_forest.glsl"
#include "scene_forest_leaf_pose.glsl"

void main() {
    forestApplyLook();
    ForestEntry e = forestEntry(int(push.extra.z + 0.5) + int(gl_WorkGroupID.x));
    if (e.slot < 0) return;
    for (int c = int(gl_LocalInvocationID.x); c < e.end - e.first; c += 64)
        forestPoseWrite(e.slot + c, forestPoseLeaf(e, e.first + c));
}
