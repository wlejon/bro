#version 450
// Exposure (scene/exposure.h; scene/vulkan/post/scene_exposure.h), in one
// dispatch. Auto: each workgroup adds a 16 x 16 tile of the HDR frame's
// log2 luminance to a 128-bin histogram, kMinLog2..kMaxLog2 (one pixel of
// every 4 x 4 block, so a 2560-wide frame meters 640 x 341 of them). Pixels
// nothing drew (alpha 0) and those darker than the range (black, or space
// past the air) are left out, so a frame half open space meters on what is
// lit in it. The last workgroup to finish meters the histogram (the
// log-average luminance L of the pixels between the lowPercent and
// highPercent shares, and the EV100 whose scale puts L at middle grey:
// log2(L / (1.2 * 0.18)); the incident meter instead reads the sun through
// the air at the eye, kept near that reflected reading), moves the applied EV toward it exponentially at
// the up or down speed for the frame's time step, writes the scale the
// tonemap multiplies by, and clears the bins for the next frame. Fixed: one
// workgroup writes the CPU's scale (an exact 1 at the default EV).

layout(local_size_x = 16, local_size_y = 16) in;

const float MIDDLE_GREY = 0.18;   // the key the log-average lands on (Reinhard's)

layout(set = 0, binding = 0) uniform sampler2D texHdr;
layout(set = 0, binding = 1) buffer Histogram {
    uint bins[128];
    uint done;        // workgroups finished this frame
} histogram;
layout(set = 0, binding = 2) buffer State {
    float ev;         // the applied EV100 (before compensation)
    float metered;    // this frame's metered EV100 (clamped)
    float scale;      // what the tonemap multiplies the frame by
    uint adapting;    // 1 once the auto mode has a value to adapt from
} state;

layout(push_constant) uniform ExposurePush {
    ivec2 size;        // the HDR frame's
    float minLog2;
    float maxLog2;
    float mode;        // 0 fixed, 1 auto
    float fixedEv;     // fixed: the EV100
    float fixedScale;  // fixed: its scale, exact
    float compensation;
    float dt;          // seconds since the last metered frame
    float speedUp;
    float speedDown;
    float minEv;
    float maxEv;
    float lowPercent;
    float highPercent;
    float incident;    // 1: the incident meter (scene/exposure.h, ExposureSettings::Meter)
    float rb, rt;      // the air's shell
    float r, muS;      // the eye's radius, its sun's mu_s
    float sunLux;      // the sun's luminous illuminance above the air
    float sunRadius;   // its angular radius
    float incidentEvOffset;   // the grey card's EV less log2 E
    float brighter, darker;   // the incident reading's reach about the reflected one
    int volumes;       // the incident meter's readings of the volumes (binding 4)
} push;

// The incident meter's air: the transmittance table (binding 3) and the
// shell from the push.
layout(set = 0, binding = 3) uniform sampler2D texTransmittance;
// What the volumes left the meter (volume.frag): per volume, the radiance
// down from straight up (rgb) and the share of the sun it passes (a), then
// the share of the sky straight up it passes (x).
layout(std430, set = 0, binding = 4) readonly buffer VolumeMeter { vec4 slots[]; } volumeMeter;
// The sky's light table (SceneAtmosphere's skyLight: SH by mu_s and altitude).
layout(set = 0, binding = 5) uniform sampler3D texSkyLight;
#include "common/scene_atmosphere_params.glsl"
AtmosphereGpu atmAir;
#define ATM atmAir
#define ATM_TRANSMITTANCE_TEX texTransmittance
#include "common/scene_atmosphere.glsl"

shared uint tile[128];
shared bool last;

void main() {
    uint i = gl_LocalInvocationIndex;
    if (push.mode < 0.5) {
        if (i == 0u) {
            state.ev = push.fixedEv;
            state.metered = push.fixedEv;
            state.scale = push.fixedScale;
            state.adapting = 0u;
        }
        return;
    }

    if (i < 128u) tile[i] = 0u;
    barrier();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy) * 4 + 1;
    if (all(lessThan(p, push.size))) {
        vec4 c = texelFetch(texHdr, p, 0);
        float lum = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));
        float x = lum > 0.0 ? (log2(lum) - push.minLog2) / (push.maxLog2 - push.minLog2) : -1.0;
        if (c.a > 0.0 && x >= 0.0) atomicAdd(tile[uint(min(x * 128.0, 127.0))], 1u);
    }
    barrier();
    if (i < 128u && tile[i] > 0u) atomicAdd(histogram.bins[i], tile[i]);
    // This group's bins land before it counts itself done.
    memoryBarrierBuffer();
    barrier();
    if (i == 0u) {
        uint groups = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        last = atomicAdd(histogram.done, 1u) == groups - 1u;
    }
    barrier();
    if (!last) return;

    // The last group: every other group's bins are in. Take them, clearing
    // the histogram for the next frame.
    memoryBarrierBuffer();
    if (i < 128u) tile[i] = atomicExchange(histogram.bins[i], 0u);
    barrier();
    if (i != 0u) return;
    histogram.done = 0u;
    uint total = 0u;
    for (int b = 0; b < 128; ++b) total += tile[b];
    float ev = state.ev;
    float metered = state.metered;
    if (total > 0u) {
        // The mean of log2 luminance over the [low, high] share of pixels.
        float lo = push.lowPercent * float(total), hi = push.highPercent * float(total);
        float below = 0.0, sum = 0.0, weight = 0.0;
        float binWidth = (push.maxLog2 - push.minLog2) / 128.0;
        for (int b = 0; b < 128; ++b) {
            float n = float(tile[b]);
            float take = max(0.0, min(below + n, hi) - max(below, lo));
            sum += take * (push.minLog2 + (float(b) + 0.5) * binWidth);
            weight += take;
            below += n;
        }
        if (weight > 0.0) {
            float reflected = sum / weight - log2(1.2 * MIDDLE_GREY);
            metered = reflected;
            if (push.incident > 0.5) {
                // The sun's light arriving at the eye, as an incident meter
                // there reads it: EV100 = log2(E ISO / C).
                atmAir.shell = vec4(push.rb, push.rt, 1.0, 1.0);
                atmAir.sunIlluminance = vec4(0.0, 0.0, 0.0, push.sunRadius);
                vec3 T = atmSunTransmittance(max(push.r, push.rb), push.muS);
                const vec3 lum = vec3(0.2126, 0.7152, 0.0722);
                float E = push.sunLux * dot(T, lum);
                // The sky's on a level surface (the irradiance its SH
                // gives straight up, scene_atmosphere.glsl atmShIrradiance
                // at local z): at dusk it is the light there is, and an
                // eye that read the sun alone would open up as it set
                // until the sky blew out.
                vec2 uv = atmSkyLightUv(max(push.r, push.rb), push.muS);
                vec4 l0 = textureLod(texSkyLight, vec3(uv, 0.1), 0.0);
                vec4 l1 = textureLod(texSkyLight, vec3(uv, 0.3), 0.0);
                vec4 l2 = textureLod(texSkyLight, vec3(uv, 0.5), 0.0);
                vec3 c0 = l0.rgb, c1 = vec3(l0.a, l1.rg), c3 = l2.gba;
                vec3 sky = ATM_PI * c0 * 0.282095 + (2.0 * ATM_PI / 3.0) * c1 * 0.488603 +
                           (ATM_PI / 4.0) * c3 * 0.630784;
                float skyE = push.sunLux / ATM_TABLE_SCALE * max(dot(sky, lum), 0.0);
                // Through the volumes: the share of the sun and of the sky
                // straight up they pass, and their own light from above as a
                // CIE overcast sky's, whose radiance falls from the zenith's
                // Lz as (1 + 2 cos) / 3 and gives a level surface 7/9 pi Lz
                // (Moon and Spencer 1942).
                float sunT = 1.0, skyT = 1.0, down = 0.0;
                for (int k = 0; k < push.volumes; ++k) {
                    vec4 m = volumeMeter.slots[2 * k];
                    sunT *= m.a;
                    skyT *= volumeMeter.slots[2 * k + 1].x;
                    down += dot(m.rgb, lum);
                }
                E = E * sunT + skyE * skyT + (7.0 / 9.0) * 3.14159265 * down;
                float ev = E > 0.0 ? log2(E) + push.incidentEvOffset : reflected - push.brighter;
                // The eye adapts fully only in daylight: its threshold
                // follows the light (Weber) while cones see, down to a grey
                // card at about 3 cd/m^2, and below that as its square root
                // (de Vries-Rose), so each stop less light is half a stop
                // darker. Dusk and night read dim, as they look.
                float knee = log2(3.0 * 3.14159265 / 0.18) + push.incidentEvOffset;
                if (ev < knee) ev = knee - 0.5 * (knee - ev);
                metered = clamp(ev, reflected - push.brighter, reflected + push.darker);
            }
            metered = clamp(metered, push.minEv, push.maxEv);
        }
        if (state.adapting == 0u) {
            ev = metered;
        } else {
            float speed = metered > ev ? push.speedUp : push.speedDown;
            ev += (metered - ev) * (1.0 - exp(-max(push.dt, 0.0) * max(speed, 0.0)));
        }
    }
    state.ev = ev;
    state.metered = metered;
    state.scale = 1.0 / (1.2 * exp2(ev - push.compensation));
    if (total > 0u) state.adapting = 1u;
}
