#version 450
// The volume's light (vulkan/sky/scene_cloud_volume.cpp; sky/clouds_layout.h's
// CL_VOL_*): for a box of a level's cells, the optical depth from the
// cell's centre toward the sun, into the texel's z: through the volume,
// CL_VOL_SUN_STEPS cells of each level from the cell's own on, each step a
// cell of its level and twice the last level's (the finer levels' windows
// lie inside the coarser's, so the ray's first steps are the finest), read
// filtered; and from where it leaves the coarsest window still in the deck,
// the cache's depth toward the sun (sky/clouds_light.comp). Only where the
// cell may hold cloud (its occupancy, w): elsewhere the forms are clear and
// nothing is lit.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"
#include "sky/cloud_forms_at.glsl"
#include "sky/cloud_volume.glsl"

layout(local_size_x = CL_VOL_GROUP, local_size_y = CL_VOL_GROUP, local_size_z = CL_VOL_GROUP) in;

layout(set = 0, binding = CL_B_VOLUME_OUT, rgba16f) uniform image3D vol[CL_VOL_LEVELS];

layout(push_constant) uniform Push {
    ivec4 a;    // x the level, y the first column, z the columns
    ivec4 b;    // x the first row, y the rows, z the first layer, w the layers
} push;

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, ivec3(push.a.z, push.b.y, push.b.w)))) return;
    int k0 = push.a.x;
    ivec3 s = (ivec3(push.a.y, push.b.x, push.b.z) + id) & (kCloudVolSide - 1);
    vec4 t = imageLoad(vol[k0], s);
    if (t.w < 0.5) {
        imageStore(vol[k0], s, vec4(t.xy, 0.0, t.w));
        return;
    }
    ivec3 g = cloudVolCellOf(s, ivec3(clouds.volLevel[k0].xyz));
    vec3 pos = (vec3(g) + 0.5) * cloudVolCell(k0);
    vec3 sv = cloudVolDir(cloudToBody(clouds.sun.xyz));
    float Rt = clouds.shell.y, Rb = clouds.shell.x;
    float tau = 0.0;
    bool left = false;
    for (int k = k0; k < CL_VOL_LEVELS && !left; ++k) {
        float cell = cloudVolCell(k);
        for (int i = 0; i < CL_VOL_SUN_STEPS; ++i) {
            vec3 q = pos + sv * (0.5 * cell);
            if (!cloudVolHolds(q, k)) break;
            float r = length(cloudVolBody(q));
            if (r >= Rt || r <= Rb) {   // (out of the deck: through its top, or under its bottom)
                left = true;
                break;
            }
            tau += cloudVolSample(k, q).x * cell;
            pos += sv * cell;
        }
    }
    if (!left) {
        // Beyond the volume: the cache's depth from where the ray left it.
        ClAt w = clAtBody(cloudVolBody(pos));
        if (w.h > 0.0 && w.h < 1.0) tau += clCache(w, clLod(w, cloudVolCell(CL_VOL_LEVELS - 1))).y;
    }
    imageStore(vol[k0], s, vec4(t.xy, tau, t.w));
}
