#version 450
// The volume's forms (vulkan/sky/scene_cloud_volume.cpp; sky/clouds_layout.h's
// CL_VOL_*): for a box of a level's cells (push: the level, its first cell
// and count along each axis in storage, wrapping), the forms' extinction at
// the cell's centre over the cell's footprint, as the march would draw them
// there (sky/cloud_forms_at.glsl's clFormsAt, from the cache's base), and
// whether the cell may hold cloud as the march draws it at any footprint up
// to its own (the occupancy the distance is made from). The distance's
// passes follow (clouds_volume_dist.comp).
//
// The occupancy: the most base the march may read anywhere in the cell's
// box, over every level of the cache it may read there (from the finest
// whose window holds the point to the cell's footprint's and the one past
// it): the most of the cache's texels about the box (its base is trilinear
// between them), or for a box over very many of them, the centre's base
// raised by how fast the base may rise toward the box's corners (cloudDensity's contract: the least of a field rising 1 an
// edge any way and one rising CLOUD_EDGE_STEEPEST up or down and a fifth
// of that across, so along an axis of the cache's interpolation 1 an edge
// across and CLOUD_EDGE_STEEPEST up), and the heaps' map's columns over
// it (rising no faster than 1 a metre), with the march's own margin
// (clouds.frag's clBaseClear), and
// whether the skin's most out may carry the surface to it at the widest
// blur the footprint gives (cloudMayHold: the field is linear in the blur).
// The forms' extinction is zero wherever the occupancy is, so it is read
// only where the cell may hold cloud.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"
#include "sky/cloud_forms_at.glsl"
#include "sky/cloud_volume.glsl"

layout(local_size_x = CL_VOL_GROUP, local_size_y = CL_VOL_GROUP, local_size_z = CL_VOL_GROUP) in;

layout(set = 0, binding = CL_B_VOLUME_OUT, rgba16f) uniform writeonly image3D volOut[CL_VOL_LEVELS];

layout(push_constant) uniform Push {
    ivec4 a;    // x the level, y the first column, z the columns
    ivec4 b;    // x the first row, y the rows, z the first layer, w the layers
} push;

vec4 cloudLandGrid(int c, vec3 up) { return vec4(0.0); }

// Whether the forms of base at most `base` may hold cloud read over a
// footprint of at most `foot` (clouds_cache.comp's).
bool cloudMayHold(float base, float foot) {
    if (base <= 0.0) return false;
    float w = cloudSurfaceBlurMost(foot);
    float out0 = base + 0.55 * CLOUD_SKIN - 0.5;
    float outW = base + 0.55 * CLOUD_SKIN * (1.0 - w) - 0.5 + 0.5 * w;
    return max(out0, outW) > 0.0;
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, ivec3(push.a.z, push.b.y, push.b.w)))) return;
    int k = push.a.x;
    ivec3 s = (ivec3(push.a.y, push.b.x, push.b.z) + id) & (kCloudVolSide - 1);
    ivec3 g = cloudVolCellOf(s, ivec3(clouds.volLevel[k].xyz));
    float cell = cloudVolCell(k);
    vec3 v = (vec3(g) + 0.5) * cell;
    ClAt w = clAtBody(cloudVolBody(v));
    float thick = clouds.shell.y - clouds.shell.x;
    // (The box's reach from its centre, of the deck's height: a box whose
    // centre is out of the deck may still reach into it.)
    float reach = 0.87 * cell / thick;
    vec4 o = vec4(0.0);
    if (w.h > -reach && w.h < 1.0 + reach) {
        // The footprints the march reads the forms here over: its pixel's
        // at this distance from the eye, the cell's, half again for the eye's
        // move until the cell is baked again.
        float footMax = 1.5 * max(cell, clouds.volEye.w * length(v - clouds.volEye.xyz));
        ClAt wc = w;
        wc.h = clamp(w.h, 0.0, 1.0);
        int kLo = int(clLod(wc, 1e-3));
        int kHi = min(int(clLod(wc, footMax)) + 1, CL_CACHE_LEVELS - 1);
        float most = -1.0;
        // The box on the chart (its half-width whatever its turn to the
        // chart's axes) and up the deck.
        float rx = 0.71 * cell, dh = 0.5 * cell / thick;
        const float B = float(CL_CACHE_BINS);
        int b0 = clamp(int(floor((w.h - dh) * B - 0.5)), 0, CL_CACHE_BINS - 1);
        int b1 = clamp(int(ceil((w.h + dh) * B - 0.5)), 0, CL_CACHE_BINS - 1);
        for (int j = kLo; j <= kHi; ++j) {
            float tex = cloudCacheCell(j);
            ivec2 i0 = ivec2(floor((wc.xy - rx) / tex - 0.5)), i1 = ivec2(ceil((wc.xy + rx) / tex - 0.5));
            ivec3 n = ivec3(i1 - i0 + 1, b1 - b0 + 1);
            if (n.x * n.y * n.z <= 128) {
                // The cache's base is trilinear between its texels, a convex
                // mix of theirs: the most of the texels about the box bounds
                // it over the box.
                // (The slabs' base and the heaps' share alike.)
                for (int iy = i0.y; iy <= i1.y; ++iy)
                    for (int ix = i0.x; ix <= i1.x; ++ix)
                        for (int b = b0; b <= b1; ++b) {
                            vec4 t = texelFetch(cloudSigmaMap, ivec3(ix & (CL_CACHE_SIDE - 1),
                                                iy & (CL_CACHE_SIDE - 1), j * CL_CACHE_BINS + b), 0);
                            most = max(most, max(t.g, t.a));
                        }
            } else {
                // (A box over many texels: the centre's, raised by how fast
                // the base may rise to the box's corner along each axis of
                // the interpolation, 1 an edge across and
                // CLOUD_EDGE_STEEPEST up.)
                vec4 t = textureLod(cloudSigmaMap, cloudCacheCoord(wc.xy, wc.h, j), 0.0);
                float rise = 0.5 * (2.0 + CLOUD_EDGE_STEEPEST) * cell / clouds.forms.w;
                most = max(most, max(t.g, t.a) + rise);
            }
        }
        // The heaps as the march reads them from their map at the box's
        // footprints: how far the centre is inside them, and the box's
        // reach and a texel's more (the map's columns rise no faster than
        // 1 a metre, and a texel's interpolation of them is off by less).
        if (cloudHeapMapSide() > 0.0) {
            vec2 hxy = cloudChartAt(normalize(cloudDrift(w.p)));
            for (int i = 0; i < 2; ++i) {
                float f = i == 0 ? cell : footMax, texel;
                vec4 col = cloudHeapMapColumn(hxy, f, texel);
                if (cloudHeapsFar(f, texel) < 1.0)
                    most = max(most, 0.5 + (cloudHeapColumnIn(col, wc.h * thick) + 0.87 * cell + texel) / clouds.forms.w);
            }
        }
        most += 0.04 * abs(most) + 0.004;
        bool holds = cloudMayHold(most, footMax);
        if (holds) {
            float sigma = w.h > 0.0 && w.h < 1.0 ? clFormsAt(w, clLod(w, cell), cell, cell, true).sigma : 0.0;
            o = vec4(sigma, 0.0, 0.0, 1.0);
        }
    }
    imageStore(volOut[k], s, o);
}
