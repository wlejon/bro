#version 450
// The cache's distance to cloud (vulkan/sky/scene_clouds.cpp; sky/
// clouds_layout.h): for the texels clouds_cache.comp baked (the same rows),
// how far (metres) any point of the texel's cell is sure to be from cloud,
// out to CL_CACHE_REACH cells across and the whole column up; the march
// crosses that much clear air in one step (Nubis 3's empty-space skipping).
// Whether a cell may hold cloud is as clouds_cache.comp left it
// (CL_B_HOLDS), read at points of the cell, so a cell is taken to hold
// cloud when it or one beside it may (along each axis), and the distance is
// the gap between the cell's box and the nearest such, the most of the gaps
// along the chart's two axes and up (a ball that wide about any point of the
// cell is clear). The usual separable transform, an axis a pass
// (push.rows.w): along the first axis into the first scratch, the second
// into the second, then up the deck into the cache's w. A cell past its
// level's window counts as cloud (what is there is not held); air above and
// below the deck as clear.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

layout(local_size_x = CL_CACHE_GROUP, local_size_y = CL_CACHE_GROUP) in;

layout(set = 0, binding = CL_B_CACHE_OUT, rgba16f) uniform image3D cacheOut;
layout(set = 0, binding = CL_B_DIST_A, r16f) uniform image3D distA;
layout(set = 0, binding = CL_B_DIST_B, r16f) uniform image3D distB;
layout(set = 0, binding = CL_B_HOLDS, r16f) uniform readonly image3D holds;

layout(push_constant) uniform Push {
    ivec4 rows;    // x the first level, y the first row, z the step between rows, w the pass (0 .. 2)
} push;

// The gap (cells) between a cell's box and one `i` cells off that may hold
// cloud, less the one beside it.
float clGap(int i) { return float(max(abs(i) - 2, 0)); }

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = push.rows.y + int(gl_GlobalInvocationID.y) * push.rows.z;
    int k = push.rows.x + int(gl_GlobalInvocationID.z) / CL_CACHE_BINS;
    int bin = int(gl_GlobalInvocationID.z) % CL_CACHE_BINS;
    if (x >= CL_CACHE_SIDE || y >= CL_CACHE_SIDE || k >= CL_CACHE_LEVELS) return;
    float cell = cloudCacheCell(k);
    int z = k * CL_CACHE_BINS + bin;
    const int R = CL_CACHE_REACH;
    float far = clGap(R + 1) * cell;
    if (push.rows.w == 0) {
        int c = int(clouds.cacheLevel[k].x), g = cloudCacheCellOf(x, c);
        float d = far;
        for (int i = -R; i <= R; ++i) {
            int gi = g + i;
            bool held = gi >= c - CL_CACHE_SIDE / 2 && gi < c + CL_CACHE_SIDE / 2;
            ivec3 at = ivec3((x + i) & (CL_CACHE_SIDE - 1), y, z);
            if (!held || imageLoad(holds, at).r > 0.5)
                d = min(d, clGap(i) * cell);
        }
        imageStore(distA, ivec3(x, y, z), vec4(d));
    } else if (push.rows.w == 1) {
        int c = int(clouds.cacheLevel[k].y), g = cloudCacheCellOf(y, c);
        float d = far;
        for (int j = -R; j <= R; ++j) {
            int gj = g + j;
            bool held = gj >= c - CL_CACHE_SIDE / 2 && gj < c + CL_CACHE_SIDE / 2;
            float a = held ? imageLoad(distA, ivec3(x, (y + j) & (CL_CACHE_SIDE - 1), z)).r : 0.0;
            d = min(d, max(clGap(j) * cell, a));
        }
        imageStore(distB, ivec3(x, y, z), vec4(d));
    } else {
        float binH = clouds.cacheE1.w;
        // (Every bin of the column: a column clear over all of the deck is
        // as far from cloud as the cells across say.)
        float d = far;
        for (int b = 0; b < CL_CACHE_BINS; ++b)
            d = min(d, max(clGap(b - bin) * binH, imageLoad(distB, ivec3(x, y, k * CL_CACHE_BINS + b)).r));
        vec4 v = imageLoad(cacheOut, ivec3(x, y, z));
        imageStore(cacheOut, ivec3(x, y, z), vec4(v.xyz, d));
    }
}
