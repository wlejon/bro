#version 450
// The cache's base (vulkan/sky/scene_clouds.cpp; sky/clouds_layout.h): the
// world's cloudDensity at each texel's centre, its footprint the cell, and
// the extinction the engine's forms make of it there at that footprint
// (the deck's mean over the cell: what the light and the shadow read). A
// dispatch bakes rows `y0`, `y0 + yStep`, ... of the levels from `first`
// on (z: a level's bins one after another), each texel's cell the one of
// its level's window that its storage index holds (toroidally).
//
// With it, whether the cell may hold any cloud as the march sees it,
// however near (CL_B_HOLDS: what the band and the distance to cloud are
// made from): whether the base the march reads there (between this bin's
// and the next ones', with a margin) is near enough a half that the skin
// may carry the surface out to it. The forms' mean over the cell will not
// do: it leaves out cloud too small to lift the cell's mean.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

layout(local_size_x = CL_CACHE_GROUP, local_size_y = CL_CACHE_GROUP) in;

layout(set = 0, binding = CL_B_SIGMA_OUT, rgba16f) uniform writeonly image3D sigmaOut;
layout(set = 0, binding = CL_B_HOLDS, r16f) uniform writeonly image3D holdsOut;

layout(push_constant) uniform Push {
    ivec4 rows;    // x the first level, y the first row, z the step between rows
    ivec4 cols;    // x the first column, y the columns, z the rows (both wrap about the side)
} push;

vec4 cloudLandGrid(int c, vec3 up) { return vec4(0.0); }

#include "sky/cloud_module.glsl"

// Whether the forms of base at most `base` may hold cloud read over a
// footprint of at most `foot` (the skin's most out, the surface's blur at
// its widest or none: the field is linear in the blur).
bool cloudMayHold(float base, float foot) {
    if (base <= 0.0) return false;
    float w = cloudSurfaceBlurMost(foot);
    float out0 = base + 0.55 * CLOUD_SKIN - 0.5;
    float outW = base + 0.55 * CLOUD_SKIN * (1.0 - w) - 0.5 + 0.5 * w;
    return max(out0, outW) > 0.0;
}

void main() {
    if (int(gl_GlobalInvocationID.x) >= push.cols.y || int(gl_GlobalInvocationID.y) >= push.cols.z) return;
    int x = (push.cols.x + int(gl_GlobalInvocationID.x)) & (CL_CACHE_SIDE - 1);
    int y = (push.rows.y + int(gl_GlobalInvocationID.y) * push.rows.z) & (CL_CACHE_SIDE - 1);
    int k = push.rows.x + int(gl_GlobalInvocationID.z) / CL_CACHE_BINS;
    int bin = int(gl_GlobalInvocationID.z) % CL_CACHE_BINS;
    if (k >= CL_CACHE_LEVELS) return;
    vec2 c = clouds.cacheLevel[k].xy;
    float cell = cloudCacheCell(k);
    vec2 xy = (vec2(cloudCacheCellOf(x, int(c.x)), cloudCacheCellOf(y, int(c.y))) + 0.5) * cell;
    vec3 up = cloudChartDir(xy);
    float h = (float(bin) + 0.5) / float(CL_CACHE_BINS);
    float r = mix(clouds.shell.x, clouds.shell.y, h);
    vec4 cover = cloudCoverAt(up);
    CloudPoint q = CloudPoint(up * r, up, h, r - clouds.shell.z, cover, cell, clouds.shell.w);
    // (The base the march reads: under 0 as the world gives it, how far
    // the clear air is from cloud, which it steps by; and a share cut into
    // clouds where the cell is wide. The extinction the cell's mean, of the
    // share.)
    vec3 pd = cloudDrift(q.p);
    float share = min(cloudDensity(q), 1.0);
    float baseRaw = cloudCutBase(share, pd, cell);
    float sigma = cloudForms(pd, max(share, 0.0), 0.5, cell, false);
    ivec3 at = ivec3(x, y, k * CL_CACHE_BINS + bin);
    // The base the march may read in the cell: it mixes the bins' about it
    // (and quickly changes up, as at a cloud's flat base), so the most of
    // this bin's and the next ones' up and down, with a margin.
    float binH = clouds.cacheE1.w, most = baseRaw;
    float gLo = baseRaw, gHi = baseRaw, hLo = r, hHi = r;
    for (int j = -1; j <= 1; j += 2) {
        float rj = r + float(j) * binH;
        float hj = (rj - clouds.shell.x) / (clouds.shell.y - clouds.shell.x);
        if (hj <= 0.0 || hj >= 1.0) continue;
        CloudPoint qj = CloudPoint(up * rj, up, hj, rj - clouds.shell.z, cover, cell, clouds.shell.w);
        float gj = cloudCutBase(min(cloudDensity(qj), 1.0), cloudDrift(qj.p), cell);
        most = max(most, gj);
        if (j < 0) { gLo = gj; hLo = rj; } else { gHi = gj; hHi = rj; }
    }
    most = min(most + 0.1 * abs(most) + 0.01, 1.0);
    // How much of the skin's move the march shows here (z): none where the
    // base rises up steeply (a cloud's flat underside, rising up to
    // CLOUD_EDGE_STEEPEST times an edge's rate under it), so a cumulus' base
    // stays a flat grey plane and its lobes are on its walls and its top.
    float rise = (gHi - gLo) / max(hHi - hLo, 1.0) * clouds.forms.w;
    float shows = 1.0 - smoothstep(0.5, 0.8, rise / CLOUD_EDGE_STEEPEST);
    imageStore(sigmaOut, at, vec4(sigma, baseRaw, shows, 0.0));
    // (What lies between texels, across the chart, the distance's margin of
    // a cell about each that may takes in.)
    imageStore(holdsOut, at, vec4(cloudMayHold(most, cell) ? 1.0 : 0.0));
}
