#version 450
// The cache's base (vulkan/sky/scene_clouds.cpp; sky/clouds_layout.h): the
// world's cloudDensity at each texel's centre, its footprint the cell, and
// the extinction the engine's forms make of it there at that footprint
// (the deck's mean over the cell: what the light and the shadow read). A
// dispatch bakes rows `y0`, `y0 + yStep`, ... of the levels from `first`
// on (z: a level's bins one after another), each texel's cell the one of
// its level's window that its storage index holds (toroidally).
//
// With it, whether the cell may hold any cloud as the march sees it,
// however near (CL_B_HOLDS: what the band and the distance to cloud are
// made from): whether the base the march reads there (between this bin's
// and the next ones', with a margin) is near enough a half that the skin
// may carry the surface out to it. The forms' mean over the cell will not
// do: it leaves out cloud too small to lift the cell's mean.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

// A group: CL_CACHE_GROUP columns of a row, each its CL_CACHE_BINS bins (z),
// so a bin's neighbours up and down are the group's own and the world's
// module is evaluated once a texel (their bases shared below).
layout(local_size_x = CL_CACHE_GROUP, local_size_y = 1, local_size_z = CL_CACHE_BINS) in;

shared float sBase[CL_CACHE_GROUP][CL_CACHE_BINS];

layout(set = 0, binding = CL_B_SIGMA_OUT, rgba16f) uniform writeonly image3D sigmaOut;
layout(set = 0, binding = CL_B_HOLDS, r16f) uniform writeonly image3D holdsOut;

layout(push_constant) uniform Push {
    ivec4 rows;    // x the first level, y the first row, z the step between rows
    ivec4 cols;    // x the first column, y the columns, z the rows (both wrap about the side)
} push;

vec4 cloudLandGrid(int c, vec3 up) { return vec4(0.0); }

#include "sky/cloud_module.glsl"
#include "sky/cloud_heaps.glsl"

// Whether the forms of base at most `base` may hold cloud read over a
// footprint of at most `foot` (the skin's most out, the surface's blur at
// its widest or none: the field is linear in the blur).
bool cloudMayHold(float base, float foot) {
    if (base <= 0.0) return false;
    float w = cloudSurfaceBlurMost(foot);
    float out0 = base + 0.55 * CLOUD_SKIN - 0.5;
    float outW = base + 0.55 * CLOUD_SKIN * (1.0 - w) - 0.5 + 0.5 * w;
    return max(out0, outW) > 0.0;
}

// The heaps of the 3 x 3 cells of the lattice about each column (made by
// its first nine bins, read by all of them), and its nearest wall (of a
// cell): sky/cloud_heaps.glsl's cloudHeapsIn, the world asked once a cell.
shared CloudHeap sHeap[CL_CACHE_GROUP][9];
shared vec4 sCell[CL_CACHE_GROUP][9][2];   // its middle's direction (xyz, w 1: it holds one), its east (north from them)
shared float sWall[CL_CACHE_GROUP];

void main() {
    // (A column past the bake's still evaluates, for the group's barriers,
    // and stores nothing; a group is one row and one level.)
    if (int(gl_GlobalInvocationID.y) >= push.cols.z) return;
    bool inside = int(gl_GlobalInvocationID.x) < push.cols.y;
    int x = (push.cols.x + int(gl_GlobalInvocationID.x)) & (CL_CACHE_SIDE - 1);
    int y = (push.rows.y + int(gl_GlobalInvocationID.y) * push.rows.z) & (CL_CACHE_SIDE - 1);
    int k = push.rows.x + int(gl_GlobalInvocationID.z) / CL_CACHE_BINS;
    int bin = int(gl_GlobalInvocationID.z) % CL_CACHE_BINS;
    if (k >= CL_CACHE_LEVELS) return;
    vec2 c = clouds.cacheLevel[k].xy;
    float cell = cloudCacheCell(k);
    vec2 xy = (vec2(cloudCacheCellOf(x, int(c.x)), cloudCacheCellOf(y, int(c.y))) + 0.5) * cell;
    vec3 up = cloudChartDir(xy);
    float h = (float(bin) + 0.5) / float(CL_CACHE_BINS);
    float r = mix(clouds.shell.x, clouds.shell.y, h);
    float thick = clouds.shell.y - clouds.shell.x;
    vec4 cover = cloudCoverAt(up);
    CloudPoint q = CloudPoint(up * r, up, h, r - clouds.shell.z, cover, cell, clouds.shell.w);
    vec3 pd = cloudDrift(q.p);
    uint col = gl_LocalInvocationID.x;
    // The slabs: the world's base, the march's (under 0 as the world gives
    // it, how far the clear air is from cloud, which it steps by).
    float slab = min(cloudDensity(q), 1.0);
    // The heaps: where the cell is finer than they are, the heaps
    // themselves (their surface at a half, rising over the edge across it,
    // as the world's shapes); where it is as wide, the world's share of
    // them. What the light and the shadow read, and what the march reads of
    // them where they are finer than its pixel; elsewhere it reads the
    // heaps' map (sky/clouds_layout.h).
    float hs = cloudHeapSide();
    bool lattice = hs > 0.0 && cell < hs;   // (uniform over the group)
    float heapIn = -1e5;
#ifdef CLOUD_HEAPS
    if (lattice) {
        if (bin < 9) {
            vec3 fe;
            ivec2 c0;
            float wall;
            vec3 upd = normalize(cloudDrift(up * mix(clouds.shell.x, clouds.shell.y, 0.5)));
            cloudHeapAbout(upd, fe, c0, wall);
            if (bin == 0) sWall[col] = wall;
            CloudHeapCell hc = cloudHeapCell(cloudHeapOwn(ivec3(int(fe.z), c0 + ivec2(bin % 3, bin / 3) - 1)));
            CloudHeap hh;
            bool any = cloudHeap(hc, hh);
            if (!any)
                for (int l = 0; l < CL_HEAP_LOBES; ++l) hh.lobe[l] = vec4(0.0);
            sHeap[col][bin] = hh;
            sCell[col][bin][0] = vec4(hc.up, any ? 1.0 : 0.0);
            sCell[col][bin][1] = vec4(hc.east, 0.0);
        }
        barrier();
        vec3 upd = normalize(pd);
        heapIn = -sWall[col] * hs;
        for (int n = 0; n < 9; ++n) {
            vec4 cu = sCell[col][n][0];
            if (cu.w < 0.5) continue;
            vec3 e = sCell[col][n][1].xyz, nn = cross(cu.xyz, e);
            vec3 v3 = (upd - cu.xyz) * clouds.shell.x;
            heapIn = max(heapIn, cloudHeapIn(sHeap[col][n], vec2(dot(v3, e), dot(v3, nn)), h * thick));
        }
    }
#endif
    float near = hs > 0.0 ? 1.0 - smoothstep(0.15 * hs, 0.6 * hs, cell) : 0.0;
    float heapShare = near < 1.0 ? cloudHeapsShareAt(q) : 0.0;
    float heaps = mix(min(heapShare, 1.0), min(0.5 + heapIn / clouds.forms.w, 1.0), near);
    float baseRaw = slab;
    // (The extinction the cell's mean, of slabs and heaps.)
    float sigma = cloudForms(pd, max(max(slab, heaps), 0.0), 0.5, cell, false);
    ivec3 at = ivec3(x, y, k * CL_CACHE_BINS + bin);
    sBase[col][bin] = baseRaw;
    barrier();
    if (!inside) return;
    // The base the march may read in the cell: it mixes the bins' about it
    // (and quickly changes up, as at a cloud's flat base), so the most of
    // this bin's and the next ones' up and down (the bins a bin's height
    // away: the column's own), with a margin.
    float binH = clouds.cacheE1.w, most = baseRaw;
    float gLo = baseRaw, gHi = baseRaw, hLo = r, hHi = r;
    if (bin > 0) {
        gLo = sBase[col][bin - 1];
        hLo = r - binH;
        most = max(most, gLo);
    }
    if (bin < CL_CACHE_BINS - 1) {
        gHi = sBase[col][bin + 1];
        hHi = r + binH;
        most = max(most, gHi);
    }
    most = min(most + 0.1 * abs(most) + 0.01, 1.0);
    // How much of the skin's move the march shows here (z): none where the
    // base rises up steeply (a cloud's flat underside, rising up to
    // CLOUD_EDGE_STEEPEST times an edge's rate under it), so a cumulus' base
    // stays a flat grey plane and its lobes are on its walls and its top.
    float rise = (gHi - gLo) / max(hHi - hLo, 1.0) * clouds.forms.w;
    float shows = 1.0 - smoothstep(0.5, 0.8, rise / CLOUD_EDGE_STEEPEST);
    imageStore(sigmaOut, at, vec4(sigma, baseRaw, shows, heaps));
    // Whether the heaps may reach into the cell as the march draws them:
    // where the lattice is searched, a heap's surface within the cell's box
    // (half its diagonal across, half a bin up), its skin's most out and
    // its blur at the cell's footprint of it; else wherever the world says
    // they fill any share.
    bool heapHolds = lattice ? heapIn + 1.25 * cell + 0.5 * binH + 0.2 * clouds.forms.w > 0.0 : heapShare > 0.0;
    // (What lies between texels, across the chart, the distance's margin of
    // a cell about each that may takes in.)
    imageStore(holdsOut, at, vec4(cloudMayHold(most, cell) || heapHolds ? 1.0 : 0.0));
}
