#version 450
// The cache's light (vulkan/sky/scene_clouds.cpp; sky/clouds_layout.h): for
// the texels clouds_cache.comp baked (the same rows), the deck's optical
// depth from the texel's centre toward the sun and straight up, out of the
// deck, through the cache's extinction: steps each a share longer than the
// last from half a cell, each read at the level as coarse as the step is
// long, so the depth toward the sun is a cumulus's own near the texel and
// its field's mean a few kilometres off, and no small cloud flickers in a
// shadow afar. Written with the texel's base, which the march cuts into
// its forms; and each column's band (sky/clouds_layout.h's CL_B_BAND).

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

// A group: CL_CACHE_GROUP columns of a row, each its CL_CACHE_BINS bins (z),
// so the columns' bands are made by all of their bins at once (below).
layout(local_size_x = CL_CACHE_GROUP, local_size_y = 1, local_size_z = CL_CACHE_BINS) in;

// For each of the group's columns and the nine about it (its own the
// fifth): each bin's extinction, the column's sum of them, and the lowest
// and highest bins that may hold cloud of all nine.
shared float sSigma[CL_CACHE_GROUP][9][CL_CACHE_BINS];
shared float sColumn[CL_CACHE_GROUP][9];
shared float sSlab[CL_CACHE_GROUP][CL_CACHE_BINS];   // the column's own slabs' extinction (no heaps)
shared uint sLo[CL_CACHE_GROUP], sHi[CL_CACHE_GROUP];

layout(set = 0, binding = CL_B_CACHE_OUT, rgba16f) uniform writeonly image3D cacheOut;
layout(set = 0, binding = CL_B_BAND_OUT, rgba16f) uniform writeonly image2DArray bandOut;
layout(set = 0, binding = CL_B_HOLDS, r16f) uniform readonly image3D holds;

layout(push_constant) uniform Push {
    ivec4 rows;    // x the first level, y the first row, z the step between rows
    ivec4 cols;    // x the first column, y the columns, z the rows (both wrap about the side)
} push;

// The cache's extinction at body point `p`, its mean over `foot` at least
// (none past the deck or the cache).
float cloudSigmaAt(vec3 p, float foot) {
    float r = length(p);
    float h = (r - clouds.shell.x) / (clouds.shell.y - clouds.shell.x);
    if (h <= 0.0 || h >= 1.0) return -1.0;
    vec2 xy = cloudChartAt(p / r);
    int k = cloudCacheLevel(xy, foot);
    if (k >= CL_CACHE_LEVELS) return -1.0;
    return textureLod(cloudSigmaMap, cloudCacheCoord(xy, h, k), 0.0).r;
}

// The same of the slabs alone (the heaps' none).
float cloudSlabSigmaAt(vec3 p, float foot) {
    float r = length(p);
    float h = (r - clouds.shell.x) / (clouds.shell.y - clouds.shell.x);
    if (h <= 0.0 || h >= 1.0) return -1.0;
    vec2 xy = cloudChartAt(p / r);
    int k = cloudCacheLevel(xy, foot);
    if (k >= CL_CACHE_LEVELS) return -1.0;
    float cell = cloudCacheCell(k);
    float base = textureLod(cloudSigmaMap, cloudCacheCoord(xy, h, k), 0.0).g;
    return cloudSigmaOf(base, 0.0, cloudSurfaceBlur(cell), cell);
}

// The depth from `p` toward `d` (the body's frame): `n` steps, each `grow`
// times the last, from `first`, read no finer than `cell`; to where the
// way leaves the deck. Of the slabs alone if `slabs`.
float cloudDepthToward(vec3 p, vec3 d, float first, float grow, int n, float cell, bool slabs) {
    float tau = 0.0, at = 0.0, len = first;
    for (int i = 0; i < n; ++i) {
        vec3 q = p + d * (at + 0.5 * len);
        float s = slabs ? cloudSlabSigmaAt(q, max(len, cell)) : cloudSigmaAt(q, max(len, cell));
        if (s < 0.0) break;
        tau += s * len;
        at += len;
        len *= grow;
    }
    return tau;
}

void main() {
    // (A column past the bake's still takes part in its group's band, for
    // the barriers, and stores nothing; a group is one row and one level.)
    if (int(gl_GlobalInvocationID.y) >= push.cols.z) return;
    bool inside = int(gl_GlobalInvocationID.x) < push.cols.y;
    int x = (push.cols.x + int(gl_GlobalInvocationID.x)) & (CL_CACHE_SIDE - 1);
    int y = (push.rows.y + int(gl_GlobalInvocationID.y) * push.rows.z) & (CL_CACHE_SIDE - 1);
    int k = push.rows.x + int(gl_GlobalInvocationID.z) / CL_CACHE_BINS;
    int bin = int(gl_GlobalInvocationID.z) % CL_CACHE_BINS;
    if (k >= CL_CACHE_LEVELS) return;
    vec2 c = clouds.cacheLevel[k].xy;
    float cell = cloudCacheCell(k);
    vec2 xy = (vec2(cloudCacheCellOf(x, int(c.x)), cloudCacheCellOf(y, int(c.y))) + 0.5) * cell;
    vec3 up = cloudChartDir(xy);
    float h = (float(bin) + 0.5) / float(CL_CACHE_BINS);
    vec3 p = up * mix(clouds.shell.x, clouds.shell.y, h);
    ivec3 at = ivec3(x, y, k * CL_CACHE_BINS + bin);
    float base = max(texelFetch(cloudSigmaMap, at, 0).g, 0.0);
    vec3 sun = normalize(cloudToBody(clouds.sun.xyz));
    // (From half a cell, or of a bin straight up: the texel's own.)
    float first = 0.5 * min(cell, clouds.cacheE1.w * 2.0);
    float toSun = cloudDepthToward(p, sun, first, 1.35, 28, cell, false);
    float toUp = cloudDepthToward(p, up, 0.5 * clouds.cacheE1.w, 1.35, 12, cell, false);
    // (The bottom bin's slabs' alone: the land's shadow, the heaps' own from
    // their map over it where they are drawn as themselves.)
    float slabsToSun = bin == 0 ? cloudDepthToward(p, sun, first, 1.35, 28, cell, true) : toSun;
    if (inside) imageStore(cacheOut, at, vec4(slabsToSun, toSun, toUp, 0.0));
    // The column's band (the march's probe): the heights where it and the
    // columns about it may hold cloud (CL_B_HOLDS; so a lookup between
    // texels holds every column it may stand for), and the most any of them
    // holds (their optical depth up the deck; none only where none may).
    // Each bin reads its own of the nine columns; the sums are each
    // column's bins in order, as one thread would add them.
    uint col = gl_LocalInvocationID.x;
    if (bin == 0) {
        sLo[col] = uint(CL_CACHE_BINS);
        sHi[col] = 0u;
    }
    sSlab[col][bin] = cloudSigmaOf(base, 0.0, cloudSurfaceBlur(cell), cell);
    barrier();
    bool held = false;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            ivec3 nb = ivec3(ivec2(x + i, y + j) & (CL_CACHE_SIDE - 1), k * CL_CACHE_BINS + bin);
            held = held || imageLoad(holds, nb).r > 0.5;
            sSigma[col][(j + 1) * 3 + i + 1][bin] = texelFetch(cloudSigmaMap, nb, 0).r;
        }
    }
    if (held) {
        atomicMin(sLo[col], uint(bin));
        atomicMax(sHi[col], uint(bin + 1));
    }
    barrier();
    if (bin < 9) {
        float column = 0.0;
        for (int b = 0; b < CL_CACHE_BINS; ++b) column += sSigma[col][bin][b];
        sColumn[col][bin] = column;
    }
    barrier();
    if (bin != 0 || !inside) return;
    float lo = 1.0, hi = 0.0, most = 0.0;
    if (sHi[col] > 0u) {
        lo = float(sLo[col]) / float(CL_CACHE_BINS);
        hi = float(sHi[col]) / float(CL_CACHE_BINS);
    }
    for (int n = 0; n < 9; ++n) most = max(most, sColumn[col][n] * clouds.cacheE1.w);
    if (hi > lo) most = max(most, 1e-3);
    imageStore(bandOut, ivec3(x, y, k), vec4(lo, hi, most, 0.0));
    // The column as a layer (the march's, where the deck is a few pixels
    // thick or less; cloudColumnAdd): the mean of the depth over what it
    // sends (the light's way up and, slanted, toward the sun: the column is
    // far wider than it is deep, so its neighbours are as it is) and of the
    // height.
    // And its slabs' alone (from 2 CL_CACHE_LEVELS on: where the layer
    // draws the heaps as themselves, from their map, over them).
    CloudColumn layer = cloudColumnNone(), slabs = cloudColumnNone();
    for (int b = CL_CACHE_BINS - 1; b >= 0; --b) {
        float hb = (float(b) + 0.5) / float(CL_CACHE_BINS);
        cloudColumnAdd(layer, sSigma[col][4][b] * clouds.cacheE1.w, hb, clouds.cacheE1.w, cloudShareLike(cell));
        cloudColumnAdd(slabs, sSlab[col][b] * clouds.cacheE1.w, hb, clouds.cacheE1.w, cloudShareLike(cell));
    }
    imageStore(bandOut, ivec3(x, y, CL_CACHE_LEVELS + k), cloudColumnLayer(layer));
    imageStore(bandOut, ivec3(x, y, 2 * CL_CACHE_LEVELS + k), cloudColumnLayer(slabs));
}
