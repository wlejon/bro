#version 450
// The clouds' shadow on the land (vulkan/sky/scene_clouds.cpp; read by
// common/scene_lighting.glsl's sceneCloudSun): for each texel of each level
// (a level a z of the dispatch, about the body's point under the eye, on
// the plane tangent to it there), what the deck leaves of the sun at the
// datum's point under it: the cache's depth toward the sun where the sun's
// ray from there enters the deck (sky/clouds_light.comp), read at the level
// as coarse as the texel, so a level holds a shadow as sharp as its texels
// and no sharper, and the land is shadowed by what lights the clouds.
// Where the heaps are drawn as themselves (cloudHeapsFar), the slabs'
// alone, and the heaps' own: their map's columns read along the ray, so a
// heap seen from far off casts its own shadow, not its share's.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

layout(local_size_x = CL_SHADOW_GROUP, local_size_y = CL_SHADOW_GROUP) in;

layout(set = 0, binding = CL_B_SHADOW_OUT, r32f) uniform writeonly image2DArray shadowOut;   // what is left of the sun

// Where a ray from inside a sphere of radius R about the centre leaves it.
float cloudSphereOut(vec3 ro, vec3 rd, float R) {
    float b = dot(ro, rd);
    float d = b * b - (dot(ro, ro) - R * R);
    return -b + sqrt(max(d, 0.0));
}

// What the heaps leave of the sun along the body's ray from `e` (on the
// deck's bottom) toward `sb`, its sine of elevation `sinE`, their columns
// read over `texel`: CL_SHADOW_HEAP_STEPS heights up the deck.
const int CL_SHADOW_HEAP_STEPS = 16;
const float CL_SHADOW_THROUGH = 0.5;
float cloudHeapsLeave(vec3 e, vec3 sb, float sinE, float texel) {
    float thick = clouds.shell.y - clouds.shell.x;
    float dz = thick / float(CL_SHADOW_HEAP_STEPS);
    float len = dz / max(sinE, 0.1);
    float tau = 0.0;
    for (int i = 0; i < CL_SHADOW_HEAP_STEPS; ++i) {
        float t = (float(i) + 0.5) * len;
        vec3 p = e + sb * t;
        float z = length(p) - clouds.shell.x;
        if (z >= thick) break;
        float mt;
        vec4 col = cloudHeapMapColumn(cloudChartAt(normalize(cloudDrift(p))), texel, mt);
        float in_ = cloudHeapColumnIn(col, z);
        tau += clouds.forms.x * len * smoothstep(-0.5, 0.5, in_ / max(max(texel, mt), 1.0));
        if (tau > 12.0) break;
    }
    // (And the sun it scatters through, forward and out of its base into
    // its own shadow: of what a thick cloud passes, 1 / (1 + fall tau),
    // CL_SHADOW_THROUGH comes out of a heap's base, the rest its sides.
    // Without it a heap's shadow was the blue sky's light alone, navy
    // ellipses on a green land under white heaps.)
    float T = exp(-tau);
    return T + CL_SHADOW_THROUGH * max(1.0 / (1.0 + CLOUD_DIFFUSE_FALL * tau) - T, 0.0);
}

void main() {
    uvec2 t = gl_GlobalInvocationID.xy;
    uint z = gl_GlobalInvocationID.z;
    int l = int(clouds.shadowBake[z >> 2][z & 3u]);
    if (t.x >= uint(CL_SHADOW_SIDE) || t.y >= uint(CL_SHADOW_SIDE)) return;
    float texel = clouds.shadowN[l].w;
    vec2 c = (vec2(t) + 0.5 - 0.5 * float(CL_SHADOW_SIDE)) * texel;
    float R = clouds.shell.z;
    vec3 d = normalize(clouds.shadowN[l].xyz * R + clouds.shadowE1[l].xyz * c.x + clouds.shadowE2[l].xyz * c.y);
    vec3 s = clouds.sun.xyz;
    float T = 1.0;
    float mu = dot(d, s);
    if (mu > -0.05) {
        // Where the sun's ray enters the deck, on the chart.
        vec3 a = d * R;
        vec3 e = cloudToBody(a + s * cloudSphereOut(a, s, clouds.shell.x));
        vec3 up = normalize(e);
        vec2 xy = cloudChartAt(up);
        int k = cloudCacheLevel(xy, texel);
        if (k < CL_CACHE_LEVELS) {
            vec3 at = cloudCacheCoord(xy, 0.0, k);
            vec2 taus = textureLod(cloudCacheMap, at, 0.0).xy;
            vec4 sig = textureLod(cloudSigmaMap, at, 0.0);
            vec3 sb = normalize(cloudToBody(s));
            float sinE = dot(up, sb);
            // (The texel's depth is from its bin's middle: the half bin below it.)
            float below = 0.5 * clouds.cacheE1.w / max(sinE, 0.05);
            T = exp(-(taus.y + sig.r * below));
            if (cloudHeapMapSide() > 0.0) {
                float mt;
                cloudHeapMapColumn(cloudChartAt(normalize(cloudDrift(e))), texel, mt);
                float see = 1.0 - cloudHeapsFar(texel, mt);
                if (see > 0.0) {
                    float cell = cloudCacheCell(k);
                    float slab = cloudSigmaOf(sig.g, 0.0, cloudSurfaceBlur(cell), cell);
                    float own = exp(-(taus.x + slab * below)) * cloudHeapsLeave(e, sb, sinE, texel);
                    T = mix(T, own, see);
                }
            }
        }
    }
    imageStore(shadowOut, ivec3(t, l), vec4(T));
}
