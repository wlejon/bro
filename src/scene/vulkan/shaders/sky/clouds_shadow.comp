#version 450
// The clouds' shadow on the land (vulkan/sky/scene_clouds.cpp; read by
// common/scene_lighting.glsl's sceneCloudSun): for each texel of each level
// (a level a z of the dispatch, about the body's point under the eye, on
// the plane tangent to it there), what the deck leaves of the sun at the
// datum's point under it: the cache's depth toward the sun where the sun's
// ray from there enters the deck (sky/clouds_light.comp), read at the level
// as coarse as the texel, so a level holds a shadow as sharp as its texels
// and no sharper, and the land is shadowed by what lights the clouds.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

layout(local_size_x = CL_SHADOW_GROUP, local_size_y = CL_SHADOW_GROUP) in;

layout(set = 0, binding = CL_B_SHADOW_OUT, r32f) uniform writeonly image2DArray shadowOut;

// Where a ray from inside a sphere of radius R about the centre leaves it.
float cloudSphereOut(vec3 ro, vec3 rd, float R) {
    float b = dot(ro, rd);
    float d = b * b - (dot(ro, ro) - R * R);
    return -b + sqrt(max(d, 0.0));
}

void main() {
    uvec2 t = gl_GlobalInvocationID.xy;
    int l = int(gl_GlobalInvocationID.z);
    if (t.x >= uint(CL_SHADOW_SIDE) || t.y >= uint(CL_SHADOW_SIDE)) return;
    float texel = clouds.shadowE1.w * pow(clouds.shadowN.w, float(l));
    vec2 c = (vec2(t) + 0.5 - 0.5 * float(CL_SHADOW_SIDE)) * texel;
    float R = clouds.shell.z;
    vec3 d = normalize(clouds.shadowN.xyz * R + clouds.shadowE1.xyz * c.x + clouds.shadowE2.xyz * c.y);
    vec3 s = clouds.sun.xyz;
    float T = 1.0;
    float mu = dot(d, s);
    if (mu > -0.05) {
        // Where the sun's ray enters the deck, on the chart.
        vec3 a = d * R;
        vec3 e = cloudToBody(a + s * cloudSphereOut(a, s, clouds.shell.x));
        vec3 up = normalize(e);
        vec2 xy = cloudChartAt(up);
        int k = cloudCacheLevel(xy, texel);
        if (k < CL_CACHE_LEVELS) {
            vec3 at = cloudCacheCoord(xy, 0.0, k);
            float tau = textureLod(cloudCacheMap, at, 0.0).y;
            float sigma = textureLod(cloudSigmaMap, at, 0.0).r;
            // (The texel's depth is from its bin's middle: the half bin below it.)
            float below = 0.5 * clouds.cacheE1.w / max(dot(up, normalize(cloudToBody(s))), 0.05);
            T = exp(-(tau + sigma * below));
        }
    }
    imageStore(shadowOut, ivec3(t, l), vec4(T));
}
