#version 450
// The billows' distance field (vulkan/sky/scene_clouds.cpp; sky/
// clouds_layout.h's CL_SDF_*): made once with the noise, after its level 0.
// The billows hold cloud where the noise's x is over the threshold a base
// sets (sky/scene_cloud_layer.glsl's cloudFormsThreshold); turned about, at
// each texel the least base under which they may (cloudNoiseAbove's soft
// edge included). A cell (the cube between eight texel centres) may hold
// cloud at a base when one of its corners does, for a lookup between texels
// mixes its corners (and the threshold is linear in the noise, so where the
// mix is over it one corner is). Then, for each of CL_SDF_BASES (passes 0
// to 3) and CL_SDF_BASES_HI (4 to 7), the distance from each cell to the
// nearest that may (the gap between their cubes, so it holds for any point
// of the cell), in cells, out to CL_SDF_REACH: an exact Euclidean
// transform, an axis a pass (push.pass, its two low bits):
//   0  each cell's least base (its corners'), into dst's x
//   1  along x: the squared distance to the nearest cell under each base
//   2  along y, 3 along z (and the root): what the march reads
// The march steps by it through clear air knowing it passes over no billow
// at any base up to the one it reads at (the engine's detail only erodes).

#include "sky/clouds_layout.h"

layout(local_size_x = CL_NOISE_GROUP, local_size_y = CL_NOISE_GROUP, local_size_z = CL_NOISE_GROUP) in;

layout(set = 0, binding = 1, rgba8) uniform readonly image3D noise;
layout(set = 0, binding = 2, rgba16f) uniform readonly image3D src;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image3D dst;

layout(push_constant) uniform SdfPush {
    int pass;
    int side;
} pc;

// The least base under which the billows may hold cloud where the noise is
// `n`: cloudFormsThreshold turned about, less cloudNoiseAbove's soft edge
// (it holds some cloud 2.5 of its least spreads under the threshold).
float clNeed(vec4 n) {
    float lift = (n.y * 0.65 + n.z * 0.35 - 1.0) * 0.5;
    return 1.0 - (n.x + 0.025 - lift) / (1.0 - lift);
}

void main() {
    ivec3 t = ivec3(gl_GlobalInvocationID);
    int S = pc.side;
    if (any(greaterThanEqual(t, ivec3(S)))) return;
    int m = S - 1;
    int pass = pc.pass & 3;
    if (pass == 0) {
        float need = 1e9;
        for (int k = 0; k < 8; ++k)
            need = min(need, clNeed(imageLoad(noise, (t + ivec3(k & 1, (k >> 1) & 1, k >> 2)) & m)));
        imageStore(dst, t, vec4(need));
        return;
    }
    vec4 bases = pc.pass < 4 ? CL_SDF_BASES : CL_SDF_BASES_HI;
    const int R = CL_SDF_REACH;
    const float far = float(R * R);
    vec4 d = vec4(pass == 1 ? far : 3.0 * far);
    ivec3 axis = pass == 1 ? ivec3(1, 0, 0) : pass == 2 ? ivec3(0, 1, 0) : ivec3(0, 0, 1);
    for (int i = -R; i <= R; ++i) {
        vec4 s = imageLoad(src, (t + axis * i) & m);
        // (The gap between the cells' cubes along the axis.)
        float gi = float(max(abs(i) - 1, 0));
        float i2 = gi * gi;
        if (pass == 1)
            d = min(d, mix(vec4(far), vec4(i2), lessThan(vec4(s.x), bases)));
        else
            d = min(d, s + i2);
    }
    imageStore(dst, t, pass == 3 ? sqrt(min(d, vec4(far))) : d);
}
