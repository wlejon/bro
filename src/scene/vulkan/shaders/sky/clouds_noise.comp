#version 450
// The engine's cloud noise (sky/scene_cloud_layer.glsl's cloudNoise): one
// tile of tiling noise, made once when a scene first has clouds. Level 0 is
// the noise itself; each level after it the mean of the eight texels under
// each of its own in the level before (the push block's level > 0), so a
// lookup at a footprint wider than a texel reads the noise's mean there.
//
//   x  Perlin-Worley: Perlin's fbm (4 a tile, four octaves) lifted by
//      Worley's cells (1 - F1, 4 a tile with two finer octaves): soft
//      billows with round edges, a cloud's body
//   y  Worley's cells at 4 a tile, two finer octaves
//   z  the same at 8 a tile
//   w  x squared: its mips' mean less x's mean squared is how x varies
//      within a footprint (cloudNoiseAbove: the share of it over a threshold)

#include "sky/clouds_layout.h"

layout(local_size_x = CL_NOISE_GROUP, local_size_y = CL_NOISE_GROUP, local_size_z = CL_NOISE_GROUP) in;

// (Eight bits a channel: the march reads it many times a pixel, and half
// the bytes of a texel is the march's cache misses halved.)
layout(set = 0, binding = 0, rgba8) uniform writeonly image3D dst;
layout(set = 0, binding = 1, rgba8) uniform readonly image3D src;

layout(push_constant) uniform NoisePush {
    int level;   // 0: make the noise; else the mean of the level before
    int side;    // this level's side (texels)
} pc;

uvec3 clHash(uvec3 v) {   // pcg3d
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 clRand(ivec3 c, int period, uint seed) {
    uvec3 w = uvec3((c % period + period) % period) + uvec3(seed * 7919u, seed * 104729u, seed * 1299709u);
    return vec3(clHash(w)) / 4294967295.0;
}

// Perlin's gradient noise of `period` cells a tile, at `x` in tiles (-1 .. 1, about).
float clPerlin(vec3 x, int period, uint seed) {
    vec3 p = x * float(period);
    ivec3 i = ivec3(floor(p));
    vec3 f = p - vec3(i);
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float r = 0.0;
    float v[8];
    for (int k = 0; k < 8; ++k) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
        vec3 g = normalize(clRand(i + o, period, seed) * 2.0 - 1.0 + 1e-4);
        v[k] = dot(g, f - vec3(o));
    }
    float x0 = mix(mix(v[0], v[1], u.x), mix(v[2], v[3], u.x), u.y);
    float x1 = mix(mix(v[4], v[5], u.x), mix(v[6], v[7], u.x), u.y);
    return mix(x0, x1, u.z) * 1.6;
}

// Worley's 1 - F1 (the nearest feature point's distance, in cells) of
// `period` cells a tile.
float clWorley(vec3 x, int period, uint seed) {
    vec3 p = x * float(period);
    ivec3 i = ivec3(floor(p));
    vec3 f = p - vec3(i);
    float d = 1e9;
    for (int k = 0; k < 27; ++k) {
        ivec3 o = ivec3(k % 3, (k / 3) % 3, k / 9) - 1;
        vec3 r = vec3(o) + clRand(i + o, period, seed) - f;
        d = min(d, dot(r, r));
    }
    return 1.0 - clamp(sqrt(d), 0.0, 1.0);
}

float clWorleyFbm(vec3 x, int period, uint seed) {
    return clWorley(x, period, seed) * 0.625 + clWorley(x, period * 2, seed + 1u) * 0.25 +
           clWorley(x, period * 4, seed + 2u) * 0.125;
}

void main() {
    ivec3 t = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(t, ivec3(pc.side)))) return;
    if (pc.level > 0) {
        vec4 s = vec4(0.0);
        for (int k = 0; k < 8; ++k) s += imageLoad(src, t * 2 + ivec3(k & 1, (k >> 1) & 1, k >> 2));
        imageStore(dst, t, s * 0.125);
        return;
    }
    vec3 x = (vec3(t) + 0.5) / float(pc.side);
    float perlin = 0.0, amp = 1.0, norm = 0.0;
    for (int o = 0; o < 4; ++o) {
        perlin += clPerlin(x, 4 << o, uint(o)) * amp;
        norm += amp;
        amp *= 0.5;
    }
    perlin = clamp(perlin / norm * 0.5 + 0.5, 0.0, 1.0);
    float w4 = clWorleyFbm(x, 4, 10u);
    // (Perlin remapped from [0, 1] onto [worley, 1]: Hillaire's.)
    float pw = clamp(w4 + perlin * (1.0 - w4), 0.0, 1.0);
    imageStore(dst, t, vec4(pw, w4, clWorleyFbm(x, 8, 20u), pw * pw));
}
