#version 450
// The shells' sort (vulkan/sky/scene_clouds.cpp; sky/clouds_layout.h's
// CL_SHELL_*), after the plan: `mode` 0 (one invocation) lays the bins out
// farthest first and writes the draw's arguments; 1 moves each heap the
// plan listed into its bin's next slot, so the heaps are drawn far to near.

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

layout(local_size_x = CL_SHELL_SORT_GROUP) in;

layout(std430, set = 0, binding = CL_B_SHELLS) buffer Shells {
    uint head[CL_SHELL_HEAD];
    vec4 rec[];
} shells;

layout(push_constant) uniform Push {
    ivec4 mode;    // x 0 lay out, 1 move
    ivec4 unused;
} push;

void main() {
    uint count = min(shells.head[CL_SHELL_H_COUNT], uint(CL_SHELL_MOST));
    if (push.mode.x == 0) {
        if (gl_GlobalInvocationID.x != 0u) return;
        uint at = 0u;
        for (int b = CL_SHELL_BINS - 1; b >= 0; --b) {
            shells.head[CL_SHELL_H_START + b] = at;
            shells.head[CL_SHELL_H_CURSOR + b] = 0u;
            at += shells.head[CL_SHELL_H_BIN + b];
        }
        shells.head[CL_SHELL_H_ARGS + 0] = uint(CL_SHELL_VERTS);
        shells.head[CL_SHELL_H_ARGS + 1] = count;
        shells.head[CL_SHELL_H_ARGS + 2] = 0u;
        shells.head[CL_SHELL_H_ARGS + 3] = 0u;
        return;
    }
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    uint from = uint(CL_SHELL_MOST + int(i)) * uint(CL_SHELL_VEC4S);
    int bin = floatBitsToInt(shells.rec[from + 2u].w);
    uint to = (shells.head[CL_SHELL_H_START + bin] + atomicAdd(shells.head[CL_SHELL_H_CURSOR + bin], 1u)) * uint(CL_SHELL_VEC4S);
    for (uint k = 0u; k < uint(CL_SHELL_VEC4S); ++k) shells.rec[to + k] = shells.rec[from + k];
}
