#version 450
// The volume's distance to cloud (vulkan/sky/scene_cloud_volume.cpp;
// sky/clouds_layout.h's CL_VOL_*): for a box of a level's cells, how far
// (m) any point of a cell is sure to be from every cell that may hold
// cloud (clouds_volume.comp's occupancy, the texel's w), out to
// CL_VOL_REACH cells: the gap between the cells' boxes along the axis they
// are furthest apart on (the boxes' Chebyshev gap, never more than the
// Euclidean, so a ball that wide about any point of the cell is clear).
// The separable transform, an axis a pass (push.a.w): along x into the
// first scratch (in cells), y into the second, then z into the texel's y
// (m). A cell past its level's window counts as one that holds cloud
// (what is there is not held).

#define CLOUD_SET 0
#include "sky/scene_cloud_layer.glsl"

layout(local_size_x = CL_VOL_GROUP, local_size_y = CL_VOL_GROUP, local_size_z = CL_VOL_GROUP) in;

layout(set = 0, binding = CL_B_VOLUME_OUT, rgba16f) uniform image3D vol[CL_VOL_LEVELS];
layout(set = 0, binding = CL_B_VOLUME_DA, r16f) uniform image3D distA[CL_VOL_LEVELS];
layout(set = 0, binding = CL_B_VOLUME_DB, r16f) uniform image3D distB[CL_VOL_LEVELS];

layout(push_constant) uniform Push {
    ivec4 a;    // x the level, y the first column, z the columns, w the axis (0 .. 2)
    ivec4 b;    // x the first row, y the rows, z the first layer, w the layers
} push;

const ivec3 kSide = ivec3(CL_VOL_SIDE, CL_VOL_SIDE, CL_VOL_DEPTH);

// The gap (cells) between a cell's box and one `i` cells off.
float clGap(int i) { return float(max(abs(i) - 1, 0)); }

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, ivec3(push.a.z, push.b.y, push.b.w)))) return;
    int k = push.a.x, axis = push.a.w;
    ivec3 s = (ivec3(push.a.y, push.b.x, push.b.z) + id) & (kSide - 1);
    ivec3 c = ivec3(clouds.volLevel[k].xyz);
    // The cell along the axis, and the window's range of cells there.
    int n = kSide[axis];
    int lo = c[axis] - n / 2;
    int g = lo + ((s[axis] - lo) & (n - 1));
    const int R = CL_VOL_REACH;
    float d = float(R);
    for (int i = -R; i <= R; ++i) {
        int gi = g + i;
        bool inWindow = gi >= lo && gi < lo + n;
        ivec3 at = s;
        at[axis] = (s[axis] + i) & (n - 1);
        if (axis == 0) {
            if (!inWindow || imageLoad(vol[k], at).w > 0.5) d = min(d, clGap(i));
        } else {
            float e = !inWindow ? 0.0 : axis == 1 ? imageLoad(distA[k], at).r : imageLoad(distB[k], at).r;
            d = min(d, max(clGap(i), e));
        }
    }
    if (axis == 0) {
        imageStore(distA[k], s, vec4(d));
    } else if (axis == 1) {
        imageStore(distB[k], s, vec4(d));
    } else {
        vec4 t = imageLoad(vol[k], s);
        imageStore(vol[k], s, vec4(t.x, d * clouds.volA.w * exp2(float(k)), t.zw));
    }
}
