#version 450
// The probe grid's traces (scene_probe_grid.cpp): a ray an invocation, a
// probe's rays (PG_RAYS_FRESH for a probe fresh to its square, else
// PG_RAYS) 64 to a workgroup (its parts, gl_WorkGroupID.y), spread evenly
// over the sphere (a Fibonacci set, turned at random each trace) and
// marched through the world made for them, then each part's projected to
// l <= 1 SH and written to the traces' buffer for the blend
// (probe_blend.comp) to sum, so what this dispatch reads of the probes is
// what they held before it. (A ray a thread: the marches are long and
// serial, so a box's time is one ray's latency, not its rays' count.)
//
// A ray marches the finest cascade's world it is in at each step, from the
// probe's own (so a finer cascade's rays leave its square through the
// coarser ones), as the sun's does (probe_sun.comp): half a voxel a step,
// shorter across the canopy's layers, a stride down to it from above. In
// the canopy the medium scatters (isotropic, its albedo): the sun's light
// through it (the sun's volume) and the light about it (the probes' mean
// there); it ends at the ground, lit by the sun (its shade the sun's volume
// at its foot) and by the probes over it, or escapes to the sky: the
// atmosphere's light, the environment's or the flat ambient.

layout(local_size_x = 64) in;

#include "lighting/scene_probe_grid_compute.glsl"

#define ATM block.atm
#define ATM_TRANSMITTANCE_TEX pgAtmTransmittance
#define ATM_SKYLIGHT_TEX pgAtmSkyLight
#include "common/scene_atmosphere.glsl"

const float PI = 3.14159265359;
const int kMaxSteps = 256;

// The sky's light: its SH where the probe is (the atmosphere's), shared by
// every ray of the workgroup.
vec3 skyC[6];
mat3 skyFrame;

vec3 skyRadiance(vec3 d) {
    float mode = block.sky.w;
    if (mode > 1.5) return atmShRadiance(skyC, skyFrame, d);
    if (mode > 0.5) {
        float a = block.environment.y, c = cos(a), s = sin(a);
        vec3 r = vec3(c * d.x + s * d.z, d.y, -s * d.x + c * d.z);
        return textureLod(pgPrefiltered, r, block.environment.z).rgb * block.environment.x;
    }
    return block.sky.rgb;
}

// The probes' SH in cascade c at (xz, h above the ground).
void probeSh(int c, vec2 xz, float h, out vec4 r, out vec4 g, out vec4 b) {
    vec3 uvw = pgProbeUvw(c, xz, h);
    r = textureLod(pgShR, uvw, 0.0);
    g = textureLod(pgShG, uvw, 0.0);
    b = textureLod(pgShB, uvw, 0.0);
}

// The light a lit point of the ground at camera-relative `p` in cascade c
// sends back (its albedo over pi times what falls on it).
vec3 groundRadiance(int c, vec3 p, vec3 sunE, vec3 L) {
    float e = 0.25 * PG.cascade[c].z;   // a texel
    float hx = pgBase(pgGround(c, p.xz + vec2(e, 0.0))) - pgBase(pgGround(c, p.xz - vec2(e, 0.0)));
    float hz = pgBase(pgGround(c, p.xz + vec2(0.0, e))) - pgBase(pgGround(c, p.xz - vec2(0.0, e)));
    vec3 n = normalize(vec3(-hx, 2.0 * e, -hz));
    float sunT = textureLod(pgSun, pgVolumeUvw(c, p.xz, 0.0), 0.0).r;
    vec4 r, g, b;
    probeSh(c, p.xz, 0.0, r, g, b);
    vec3 E = sunE * (max(dot(n, L), 0.0) * sunT / PI) + pgShIrradiance(r, g, b, n);
    return block.ground.rgb * E;
}

vec3 trace(int c, vec3 p, vec3 d, vec3 sunE, vec3 L) {
    float top = pgTop();
    float voxY = top / float(PG_LAYERS_Y);
    vec3 radiance = vec3(0.0);
    float T = 1.0;
    int cc = c;
    for (int n = 0; n < kMaxSteps; ++n) {
        cc = pgCascadeAt(p.xz, cc);
        if (cc < 0) break;
        float g = pgGround(cc, p.xz);
        float h = p.y - pgBase(g);
        if (!pgHole(g) && h < 0.0) return radiance + T * groundRadiance(cc, p, sunE, L);
        // Under a hole's base, going down: no ground and no canopy to meet
        // (none is splatted under it), only the sky's below.
        if (h < 0.0 && d.y <= 0.0) break;
        if (h >= top && d.y >= 0.0) break;
        float vox = 0.5 * PG.cascade[cc].z;
        float step = 0.5 * vox;
        if (h >= top) {
            // Down to the canopy's top (which follows the ground: a stride at most).
            step = max(step, min((h - top) / -d.y, 8.0 * vox));
        } else if (h >= 0.0) {
            step = min(step, 0.5 * voxY / max(abs(d.y), 0.05));
            vec3 m = p + d * (0.5 * step);
            float hm = m.y - pgBase(pgGround(cc, m.xz));
            if (hm >= 0.0 && hm < top) {
                vec3 uvw = pgVolumeUvw(cc, m.xz, hm);
                vec4 medium = textureLod(pgMedium, uvw, 0.0);
                if (medium.r > 0.0) {
                    float sunT = textureLod(pgSun, uvw, 0.0).r;
                    vec4 r, gg, b;
                    probeSh(cc, m.xz, hm, r, gg, b);
                    vec3 S = medium.gba * (sunE * (sunT / (4.0 * PI)) + pgShMean(r, gg, b));
                    float a = 1.0 - exp(-medium.r * step);
                    radiance += T * S * a;
                    T *= 1.0 - a;
                    if (T < 1e-3) return radiance;
                }
            }
        }
        p += d * step;
    }
    return radiance + T * skyRadiance(d);
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}
float rand(uint x) { return float(hash(x) >> 8) * (1.0 / 16777216.0); }

shared vec3 partial[64][4];

void main() {
    uint index = gl_WorkGroupID.x, part = gl_WorkGroupID.y;
    if (index >= push.job.y) return;
    PgProbe probe = pgProbe(pgProbes.list[index]);
    int rays = probe.fresh ? PG_RAYS_FRESH : PG_RAYS;
    if (int(part) * 64 >= rays) return;
    int c = probe.cascade;
    vec4 cas = PG.cascade[c];
    vec2 xz = cas.xy + (vec2(probe.column) + 0.5) * cas.z;
    vec3 p = vec3(xz.x, pgBase(pgGround(c, xz)) + pgLayerHeight(float(probe.layer)), xz.y);

    // The sun on the probe (what the air leaves of it), and the sky's light there.
    vec3 L = normalize(PG.sun.xyz);
    vec3 sunE = block.sunLight.w > 0.5 ? block.sunLight.rgb : vec3(0.0);
    if (block.sky.w > 1.5) {
        vec3 o = atmOrigin(p);
        float r = length(o);
        sunE *= atmSunTransmittance(r, dot(o, ATM.sunDir.xyz) / r);
        atmSkyLightSh(p, skyC, skyFrame);
    }

    // The rays' turn: a random rotation (Arvo's), new each trace.
    uint seed = hash(pgProbes.list[index] * 747796405u + floatBitsToUint(block.ground.w));
    float u1 = rand(seed), u2 = rand(seed + 1u), u3 = rand(seed + 2u);
    float th = 2.0 * PI * u1, ph = 2.0 * PI * u2;
    vec3 v = vec3(cos(ph) * sqrt(u3), sin(ph) * sqrt(u3), sqrt(1.0 - u3));
    mat3 spin = mat3(cos(th), sin(th), 0.0, -sin(th), cos(th), 0.0, 0.0, 0.0, 1.0);
    mat3 turn = (2.0 * outerProduct(v, v) - mat3(1.0)) * spin;

    int i = int(part) * 64 + int(gl_LocalInvocationIndex);
    float z = 1.0 - (2.0 * float(i) + 1.0) / float(rays);
    float a = float(i) * 2.39996323;
    float s = sqrt(max(1.0 - z * z, 0.0));
    vec3 d = turn * vec3(cos(a) * s, z, sin(a) * s);
    vec3 radiance = trace(c, p, d, sunE, L);
    uint t = gl_LocalInvocationIndex;
    partial[t][0] = radiance * PG_SH_Y00;
    partial[t][1] = radiance * (PG_SH_Y1 * d.x);
    partial[t][2] = radiance * (PG_SH_Y1 * d.y);
    partial[t][3] = radiance * (PG_SH_Y1 * d.z);
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1) {
        if (t < stride)
            for (int k = 0; k < 4; ++k) partial[t][k] += partial[t + stride][k];
        barrier();
    }
    if (t == 0u) {
        float w = 4.0 * PI / float(rays);
        vec3 c0 = partial[0][0] * w, cx = partial[0][1] * w, cy = partial[0][2] * w, cz = partial[0][3] * w;
        uint at = (index * PG_TRACE_PARTS + part) * 3u;
        pgTraces.sh[at + 0u] = vec4(c0.r, cx.r, cy.r, cz.r);
        pgTraces.sh[at + 1u] = vec4(c0.g, cx.g, cy.g, cz.g);
        pgTraces.sh[at + 2u] = vec4(c0.b, cx.b, cy.b, cz.b);
    }
}
