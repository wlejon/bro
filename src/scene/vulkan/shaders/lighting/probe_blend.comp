#version 450
// The probe grid's traces into its probes (scene_probe_grid.cpp), a probe an
// invocation: a fresh one's as traced, a refreshed one's blended into what
// it held (PG_REFRESH_BLEND of the new), so the rays' noise settles over a
// few refreshes and a change in the light comes in over them.

layout(local_size_x = 64) in;

#include "lighting/scene_probe_grid_compute.glsl"

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= push.job.y) return;
    PgProbe probe = pgProbe(pgProbes.list[index]);
    ivec3 texel = pgProbeTexel(probe);
    float a = probe.fresh ? 1.0 : PG_REFRESH_BLEND;
    // Its trace's parts summed (a refresh's rays fill fewer of them).
    uint parts = uint((probe.fresh ? PG_RAYS_FRESH : PG_RAYS) / 64);
    vec4 sh[3] = vec4[3](vec4(0.0), vec4(0.0), vec4(0.0));
    for (uint part = 0u; part < parts; ++part)
        for (uint k = 0u; k < 3u; ++k) sh[k] += pgTraces.sh[(index * PG_TRACE_PARTS + part) * 3u + k];
    imageStore(pgShRImage, texel, mix(imageLoad(pgShRImage, texel), sh[0], a));
    imageStore(pgShGImage, texel, mix(imageLoad(pgShGImage, texel), sh[1], a));
    imageStore(pgShBImage, texel, mix(imageLoad(pgShBImage, texel), sh[2], a));
}
