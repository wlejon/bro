#version 450
// The probe grid's sun (scene_probe_grid.cpp): what reaches each voxel of
// the job's box of the sun's light, through the canopy's medium and past
// the ground, a voxel an invocation. Its ray climbs toward the sun through
// the finest cascade's world it is in at each step (so a finer cascade's
// rays leave its square through the coarser ones), in steps of half that
// cascade's voxel (shorter where a steep sun crosses the layers sooner),
// and ends at the ground (in its shade) or past every cascade (lit by what
// got through). Its second channel is the land's shade alone (the ray goes
// on through a canopy that has taken all the light): what the lit shaders
// add to the sun's shadow pages (scene_lighting.glsl's sceneLandSun).

layout(local_size_x = 8, local_size_y = 8) in;

#include "lighting/scene_probe_grid_compute.glsl"

const int kMaxSteps = 512;
// The sun's penumbra past what shades it, half its width a metre away: the
// disc's 0.27 degrees, widened to soften the land's shade over a voxel.
const float kPenumbra = 0.02;

void main() {
    int c = pgJobCascade();
    ivec4 box = pgJobBox() * (PG_VOXELS / PG_COLUMNS);
    ivec2 v = box.xy + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(v, box.zw))) return;
    float top = pgTop();
    float voxY = top / float(PG_LAYERS_Y);
    vec4 cas = PG.cascade[c];
    float vox = cas.z / float(PG_VOXELS / PG_COLUMNS);
    vec2 xz = cas.xy + (vec2(v) + 0.5) * vox;
    float k = float(gl_WorkGroupID.z);
    vec3 p = vec3(xz.x, pgBase(pgGround(c, xz)) + (k + 0.5) * voxY, xz.y);
    vec3 L = normalize(PG.sun.xyz);

    float T = 1.0;
    // The land's own shade: the least the ray clears the ground by over the
    // way it has come, as a share of the sun's penumbra there.
    float clear = 1e6, t = 0.0;
    int cc = c;
    for (int n = 0; n < kMaxSteps; ++n) {
        cc = pgCascadeAt(p.xz, cc);
        if (cc < 0) break;
        float g = pgGround(cc, p.xz);
        float h = p.y - pgBase(g);
        // (A hole has no ground to shade the ray, but a canopy over it
        // stands on the eye's own, as the splat put it.)
        if (!pgHole(g)) {
            if (h < 0.0) {
                T = 0.0;
                clear = 0.0;
                break;
            }
            if (t > 0.0) clear = min(clear, h / (t * kPenumbra));
        }
        float stepVox = 0.5 * PG.cascade[cc].z;
        float step = 0.5 * stepVox;
        if (T > 1e-3 && h >= 0.0 && h < top) {
            step = min(step, 0.5 * voxY / max(abs(L.y), 0.05));
            // The medium at the step's middle.
            vec3 m = p + L * (0.5 * step);
            float gm = pgGround(cc, m.xz);
            float hm = m.y - pgBase(gm);
            if (hm >= 0.0 && hm < top) T *= exp(-texture(pgMedium, pgVolumeUvw(cc, m.xz, hm)).r * step);
        }
        p += L * step;
        t += step;
    }
    float land = smoothstep(0.0, 1.0, clear);
    imageStore(pgSunImage, ivec3(pgVoxelStored(c, v), c * PG_LAYERS_Y + int(k)), vec4(T, land, 0.0, 0.0));
}
