#version 450
// The sky-view table (Hillaire 2020 §5.3), (azimuth from the sun, zenith
// angle) at the eye's radius (block.job.x) and sun angle (block.job.y): the
// sky's in-scattered radiance for a sun of 1, the horizon at the middle of
// v (scene/world/atmosphere.h). From above the shell it covers the shell and
// the planet's disc. Made per frame on the frame's compute stream when the
// sun or the eye's height moved enough to matter (scene_atmosphere.cpp).

layout(local_size_x = 8, local_size_y = 8) in;

#define ATM_READS_TABLES
#include "lighting/atmosphere_compute.glsl"

layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outSkyView;

const int STEPS = 48;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(ATM_SKYVIEW_SIZE)))) return;
    vec2 uv = (vec2(px) + 0.5) / ATM_SKYVIEW_SIZE;
    float r = block.job.x, muS = block.job.y;
    float cosZ, cosAz;
    atmSkyViewDirection(r, uv, cosZ, cosAz);
    float sinZ = sqrt(max(1.0 - cosZ * cosZ, 0.0));
    float sinAz = sqrt(max(1.0 - cosAz * cosAz, 0.0));
    vec3 rd = vec3(sinZ * cosAz, sinZ * sinAz, cosZ);
    vec3 ro = vec3(0.0, 0.0, r);
    vec3 sun = vec3(sqrt(max(1.0 - muS * muS, 0.0)), 0.0, muS);
    vec3 L = vec3(0.0);
    float t0, t1;
    bool ground;
    if (atmSegment(ro, rd, t0, t1, ground)) {
        vec3 T = vec3(1.0);
        L = atmMarch(ro, rd, sun, t0, t1, STEPS, T);
    }
    imageStore(outSkyView, px, vec4(L * ATM_TABLE_SCALE, 1.0));
}
