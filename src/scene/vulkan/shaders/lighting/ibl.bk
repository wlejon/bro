// Environment IBL bake stages (scene/vulkan/lighting/scene_environment.cpp):
//  - bake_vert:       fullscreen triangle emitting UV in [0, 2]
//  - env_convert_frag: equirectangular HDR -> environment cubemap face
//  - irradiance_frag:  cosine-weighted hemisphere convolution -> irradiance cubemap
//  - prefilter_frag:   GGX importance-sampled specular convolution -> prefiltered cubemap
//  - brdf_lut_frag:    Karis split-sum specular BRDF LUT

const PI: f32 = 3.14159265358979;
const TWO_PI: f32 = 6.28318530717958;

struct BakePush {
    face: i32,
    roughness: f32,
    env_size: f32,
}

fn cube_dir(face: i32, uv: vec2<f32>) -> vec3<f32> {
    if (face == 0) { return normalize(vec3<f32>( 1.0, -uv.y, -uv.x)); }
    if (face == 1) { return normalize(vec3<f32>(-1.0, -uv.y,  uv.x)); }
    if (face == 2) { return normalize(vec3<f32>( uv.x,  1.0,  uv.y)); }
    if (face == 3) { return normalize(vec3<f32>( uv.x, -1.0, -uv.y)); }
    if (face == 4) { return normalize(vec3<f32>( uv.x, -uv.y,  1.0)); }
    return normalize(vec3<f32>(-uv.x, -uv.y, -1.0));
}

fn hammersley(i: u32, n: u32) -> vec2<f32> {
    var bits: u32 = i;
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return vec2<f32>((i as f32) / (n as f32), (bits as f32) * 2.3283064365386963e-10);
}

fn importance_sample_ggx(xi: vec2<f32>, n: vec3<f32>, roughness: f32) -> vec3<f32> {
    let a = roughness * roughness;
    let phi = 2.0 * PI * xi.x;
    let cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    let sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    let h = vec3<f32>(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
    let up = abs(n.z) < 0.999 ? vec3<f32>(0.0, 0.0, 1.0) : vec3<f32>(1.0, 0.0, 0.0);
    let tangent = normalize(cross(up, n));
    let bitangent = cross(n, tangent);
    return normalize(tangent * h.x + bitangent * h.y + n * h.z);
}

fn bad_f32(x: f32) -> bool {
    return isnan(x) || isinf(x);
}

fn sanitize(s_in: vec3<f32>) -> vec3<f32> {
    let s = max(s_in, vec3<f32>(0.0));
    return (bad_f32(s.x) || bad_f32(s.y) || bad_f32(s.z)) ? vec3<f32>(0.0) : s;
}

@vertex fn bake_vert() {
    let vid = vertex_index();
    let uv = vec2<f32>(((vid << 1) & 2) as f32, (vid & 2) as f32);
    set_vertex_output(0, uv);
    set_vertex_position(vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0));
}

@fragment fn env_convert_frag(
    @location(0) in_uv: vec2<f32>,
    @binding(0, 0) tex_equirect: sampler2d<vec4<f32>>,
    bake: BakePush
) {
    let d = cube_dir(bake.face, in_uv * 2.0 - 1.0);
    let phi = atan2(d.z, d.x);
    let theta = asin(clamp(d.y, -1.0, 1.0));
    let eq = vec2<f32>(phi / TWO_PI + 0.5, 0.5 - theta / PI);
    set_frag_output(0, vec4<f32>(sanitize(tex_equirect.sample(eq).xyz), 1.0));
}

@fragment fn irradiance_frag(
    @location(0) in_uv: vec2<f32>,
    @binding(0, 0) tex_env: sampler_cube<vec4<f32>>,
    bake: BakePush
) {
    let n = cube_dir(bake.face, in_uv * 2.0 - 1.0);
    let up0 = abs(n.y) < 0.999 ? vec3<f32>(0.0, 1.0, 0.0) : vec3<f32>(0.0, 0.0, 1.0);
    let right = normalize(cross(up0, n));
    let up = cross(n, right);

    var irradiance: vec3<f32> = vec3<f32>(0.0);
    var samples: i32 = 0;
    let sample_delta = 0.025;
    for (var phi: f32 = 0.0; phi < TWO_PI; phi += sample_delta) {
        for (var theta: f32 = 0.0; theta < 0.5 * PI; theta += sample_delta) {
            let t = vec3<f32>(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            let s = sanitize(tex_env.sample(t.x * right + t.y * up + t.z * n).xyz);
            irradiance += s * cos(theta) * sin(theta);
            samples += 1;
        }
    }
    let out_rgb = samples > 0 ? PI * irradiance / (samples as f32) : vec3<f32>(0.0);
    set_frag_output(0, vec4<f32>(out_rgb, 1.0));
}

fn distribution_ggx(n_dot_h: f32, roughness: f32) -> f32 {
    let a = roughness * roughness;
    let a2 = a * a;
    let denom = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0;
    return a2 / (PI * denom * denom);
}

@fragment fn prefilter_frag(
    @location(0) in_uv: vec2<f32>,
    @binding(0, 0) tex_env: sampler_cube<vec4<f32>>,
    bake: BakePush
) {
    let n = cube_dir(bake.face, in_uv * 2.0 - 1.0);
    let v = n;
    let roughness = bake.roughness;

    let sample_count = 1024u;
    var total_weight: f32 = 0.0;
    var prefiltered: vec3<f32> = vec3<f32>(0.0);
    let sa_texel = 4.0 * PI / (6.0 * bake.env_size * bake.env_size);
    for (var i: u32 = 0u; i < sample_count; i += 1u) {
        let h = importance_sample_ggx(hammersley(i, sample_count), n, roughness);
        let l = normalize(2.0 * dot(v, h) * h - v);
        let n_dot_l = max(dot(n, l), 0.0);
        if (n_dot_l <= 0.0) {
            continue;
        }
        let n_dot_h = max(dot(n, h), 0.0);
        let h_dot_v = max(dot(h, v), 0.0001);
        let pdf = distribution_ggx(n_dot_h, roughness) * n_dot_h / (4.0 * h_dot_v) + 0.0001;
        let sa_sample = 1.0 / ((sample_count as f32) * pdf);
        let mip_level = roughness == 0.0 ? 0.0 : clamp(0.5 * log2(max(sa_sample / sa_texel, 1e-8)), 0.0, 16.0);
        prefiltered += sanitize(tex_env.sample_lod(l, mip_level).xyz) * n_dot_l;
        total_weight += n_dot_l;
    }
    prefiltered = total_weight > 0.0 ? prefiltered / total_weight : max(tex_env.sample_lod(n, 16.0).xyz, vec3<f32>(0.0));
    set_frag_output(0, vec4<f32>(prefiltered, 1.0));
}

fn geometry_ibl(n_dot_x: f32, roughness: f32) -> f32 {
    let k = roughness * roughness / 2.0;
    return n_dot_x / (n_dot_x * (1.0 - k) + k);
}

@fragment fn brdf_lut_frag(@location(0) in_uv: vec2<f32>) {
    let n_dot_v = max(in_uv.x, 0.0001);
    let roughness = max(in_uv.y, 0.0001);
    let v = vec3<f32>(sqrt(1.0 - n_dot_v * n_dot_v), 0.0, n_dot_v);
    let n = vec3<f32>(0.0, 0.0, 1.0);

    var a: f32 = 0.0;
    var b: f32 = 0.0;
    let sample_count = 1024u;
    for (var i: u32 = 0u; i < sample_count; i += 1u) {
        let h = importance_sample_ggx(hammersley(i, sample_count), n, roughness);
        let l = normalize(2.0 * dot(v, h) * h - v);
        let n_dot_l = max(l.z, 0.0);
        let n_dot_h = max(h.z, 0.0);
        let v_dot_h = max(dot(v, h), 0.0);
        if (n_dot_l > 0.0) {
            let g = geometry_ibl(n_dot_v, roughness) * geometry_ibl(n_dot_l, roughness);
            let g_vis = g * v_dot_h / (n_dot_h * n_dot_v);
            let fc = pow(1.0 - v_dot_h, 5.0);
            a += (1.0 - fc) * g_vis;
            b += fc * g_vis;
        }
    }
    let scale = 1.0 / (sample_count as f32);
    set_frag_output(0, vec2<f32>(a * scale, b * scale));
}
