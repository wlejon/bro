#version 450
// The probe grid's canopy (scene_probe_grid.cpp): the splat's fixed-point
// sums made into the medium, a voxel of the job's box an invocation: its
// extinction (1/m) and the albedo of what fills it (black where nothing
// does). The sums it reads it zeroes, so they are zero again for the next
// splat over them.

layout(local_size_x = 8, local_size_y = 8) in;

#include "lighting/scene_probe_grid_compute.glsl"

void main() {
    int c = pgJobCascade();
    ivec4 box = pgJobBox() * (PG_VOXELS / PG_COLUMNS);
    ivec2 v = box.xy + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(v, box.zw))) return;
    ivec3 at = ivec3(pgVoxelStored(c, v), c * PG_LAYERS_Y + int(gl_WorkGroupID.z));
    int idx = (at.z * PG_VOXELS + at.y) * PG_VOXELS + at.x;
    uvec4 q = uvec4(pgSums.sums[idx * 4 + 0], pgSums.sums[idx * 4 + 1], pgSums.sums[idx * 4 + 2],
                    pgSums.sums[idx * 4 + 3]);
    for (int k = 0; k < 4; ++k) pgSums.sums[idx * 4 + k] = 0u;
    float sigma = float(q.x) / PG_FIXED;
    vec3 albedo = q.x > 0u ? vec3(q.yzw) / float(q.x) : vec3(0.0);
    imageStore(pgMediumImage, at, vec4(sigma, albedo));
}
