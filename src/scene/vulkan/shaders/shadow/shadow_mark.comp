#version 450
// The shadow pages' marking (vulkan/shadow/pass_shadow_mark.h): each
// invocation reads the depth at the centre of its block of pixels, takes it
// back to a camera-relative position, and for each shadowed light sets the
// request bit of every page the lit shaders' lookup of that point wants
// (common/scene_lighting.glsl's lightShadow): the sun's clipmap level its
// footprint picks (or the first coarser one whose window holds it) and the
// guard SP_GUARD_LEVELS coarser; a local light's mip and its one-page top. A
// point near its page's edge marks the neighbour the filter and the normal
// offset may reach.

layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_shadow_pages.glsl"

layout(std140, set = 0, binding = 0) uniform ShadowMarkUBO {
    mat4 invViewProj;   // Vulkan clip (reversed depth) -> camera-relative
    vec4 grid;          // target width, height, pixels a block, lights
    vec4 view;          // metres a pixel a metre (perspective), metres a pixel (ortho), finest texel, levels
    vec4 lights[32];    // first map, maps, kind (0 sun, 1 spot, 2 point), reach (0: none)
    vec4 lightPos[32];  // camera-relative position, range
    ShadowMapGpu maps[SP_MARK_MAPS];
} u;

layout(set = 0, binding = 1) uniform sampler2D sceneDepth;

layout(std430, set = 0, binding = 2) buffer ShadowRequests {
    uint bits[];
} requests;

void markEntry(int e) {
    uint w = uint(e) >> 5u, m = 1u << (uint(e) & 31u);
    if ((requests.bits[w] & m) == 0u) atomicOr(requests.bits[w], m);
}

// Mark the page of clipmap map `m` under `pos`, and its neighbours within a
// border of it; false when `pos` lies outside the level's window.
bool markClipmap(int m, vec3 pos) {
    ShadowMapGpu map = u.maps[m];
    vec2 pc = (map.matrix * vec4(pos, 1.0)).xy * float(SP_WINDOW);
    if (any(lessThan(pc, vec2(0.0))) || any(greaterThanEqual(pc, vec2(float(SP_WINDOW))))) return false;
    ivec2 p = ivec2(floor(pc));
    markEntry(shadowClipmapEntry(map, p));
    vec2 t = (pc - vec2(p)) * float(SP_PAGE);
    ivec2 d = ivec2(t.x < float(SP_BORDER) ? -1 : (t.x > float(SP_PAGE - SP_BORDER) ? 1 : 0),
                    t.y < float(SP_BORDER) ? -1 : (t.y > float(SP_PAGE - SP_BORDER) ? 1 : 0));
    if (d.x != 0 && p.x + d.x >= 0 && p.x + d.x < SP_WINDOW) markEntry(shadowClipmapEntry(map, p + ivec2(d.x, 0)));
    if (d.y != 0 && p.y + d.y >= 0 && p.y + d.y < SP_WINDOW) markEntry(shadowClipmapEntry(map, p + ivec2(0, d.y)));
    return true;
}

void main() {
    ivec2 size = ivec2(u.grid.xy);
    int step = int(u.grid.z);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy) * step + step / 2;
    if (px.x >= size.x || px.y >= size.y) return;
    float depth = texelFetch(sceneDepth, px, 0).r;
    if (depth <= 0.0) return;   // the sky (reversed depth: far is 0)
    vec2 ndc = (vec2(px) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec4 h = u.invViewProj * vec4(ndc, depth, 1.0);
    vec3 pos = h.xyz / h.w;
    float dist = length(pos);
    float footprint = u.view.x > 0.0 ? dist * u.view.x : u.view.y;

    int lights = int(u.grid.w);
    for (int k = 0; k < lights; ++k) {
        vec4 L = u.lights[k];
        int first = int(L.x), count = int(L.y), kind = int(L.z);
        if (L.w > 0.0 && dist > L.w) continue;
        if (kind == 0) {
            // The sun: the level a texel a pixel, else the first coarser
            // whose window holds it; the guard.
            float lf = log2(max(footprint / u.view.z, 1e-9));
            int level = clamp(int(floor(lf)), 0, count - 1);
            while (level < count && !markClipmap(first + level, pos)) ++level;
            if (level >= count) continue;
            markClipmap(first + min(level + SP_GUARD_LEVELS, count - 1), pos);
            continue;
        }
        vec3 toFrag = pos - u.lightPos[k].xyz;
        float ld = length(toFrag);
        if (ld > u.lightPos[k].w) continue;
        int m = first + (kind == 2 ? shadowCubeFace(toFrag) : 0);
        ShadowMapGpu map = u.maps[m];
        vec4 c = map.matrix * vec4(pos, 1.0);
        if (c.w <= 0.0) continue;
        vec2 uv = c.xy / c.w;
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0)))) continue;
        float texel0 = max(map.bias.w * ld, 1e-9);
        int mip = clamp(int(floor(log2(max(footprint / texel0, 1e-9)))), 0, SP_LOCAL_MIPS - 1);
        int n = SP_LOCAL >> mip;
        markEntry(shadowLocalEntry(map, mip, min(ivec2(uv * float(n)), ivec2(n - 1))));
        markEntry(shadowLocalEntry(map, SP_LOCAL_MIPS - 1, ivec2(0)));
    }
}
