#version 450
// The land's tiles (scene_mesh_drawer_land.cpp): the world's land module
// run over each texel of the tiles the world service granted this frame,
// its heights into one array (with the canopy's top beside them), its
// surface (albedo, herbs) into another, what covers it into the third, and
// the canopy of the plants standing on it (their leaves' albedo, their
// cover; world/plant_canopy.h) into the fourth, a slot an array layer. A
// tile's texel (i, j), its border included, is centred at its corner plus
// (i + 0.5, j + 0.5) texels (world/surface_layers.h: the border lies
// outside the tile's own square).

#include "ground/land_body.glsl"
#include "ground/scene_land_layout.h"

layout(local_size_x = LF_GROUP, local_size_y = LF_GROUP) in;

layout(set = 0, binding = 0, rg32f) uniform writeonly image2DArray landHeights;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray landSurfaces;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2DArray landCovers;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2DArray landCanopies;
layout(std430, set = 0, binding = 2) readonly buffer LandFills { vec4 fills[]; };
layout(std430, set = 0, binding = 3) readonly buffer LandData { vec4 words[]; } landDataBuffer;
layout(push_constant) uniform LandFillPush { uint words[LF_P_WORDS]; } pc;

// The land's processes' grid (scene_land_process.h), its layout the land's
// (ground/land_grid_config.glsl); with no processes, never read.
#include "ground/land_grid_config.glsl"
layout(set = 0, binding = 6, rgba32f) uniform readonly image2DArray landGridImage;
vec4 landGridLoad(ivec3 t) { return imageLoad(landGridImage, t); }
#include "ground/land_grid.glsl"

// The module's noise sampled a texel apart (brokit's noise_glsl): a coarse
// tile's texel holds the detail it can carry, its finer octaves at their
// mean, not a point of them each (a far mountain's snow and a coast from
// orbit flecked texel by texel).
float landFootprint = 0.0;
#define FN_FOOTPRINT landFootprint
#include "ground/scene_land_layer.glsl"

vec4 landData(int i) { return landDataBuffer.words[clamp(i, 0, 63)]; }

#include "ground/land_module.glsl"
#include "ground/land_canopy.glsl"

#ifdef LAND_ROUND
// A round body's tile (LF_TILE_WORDS): its texels on its cube face, each
// relative to the tile's middle, whose datum point is the noise's origin.
struct RoundTile {
    vec4 mid;          // tan(x / R), tan(z / R), cos(x / R), cos(z / R) of the middle
    vec3 n, u, v;      // the face's axes (body frame)
    float R;
};

// The datum's point at chart offset `o` (m) from the tile's middle, less
// the middle's (R n_c): R (d - d_c) from the differences of the tangents
// and of the norms, so that it keeps its precision near the middle.
vec3 roundDatum(RoundTile T, vec2 o, out vec3 d) {
    vec2 a = o / T.R;
    // tan(x_c + a) - tan(x_c) = sin(a) / (cos(x_c + a) cos(x_c))
    vec2 c = vec2(cos(atan(T.mid.x) + a.x), cos(atan(T.mid.y) + a.y));
    vec2 dt = sin(a) / (c * T.mid.zw);
    vec3 wc = T.n + T.mid.x * T.u + T.mid.y * T.v;
    vec3 dw = dt.x * T.u + dt.y * T.v;
    float lc = length(wc);
    float l = length(wc + dw);
    // 1/l - 1/lc = (lc^2 - l^2) / (l lc (l + lc)), lc^2 - l^2 = -(2 wc.dw + dw.dw)
    float k = -(2.0 * dot(wc, dw) + dot(dw, dw)) / (l * lc * (l + lc));
    d = (wc + dw) / l;
    return T.R * (dw / l + wc * k);
}

// The ground at chart offset `o`: its height over the datum and the point
// of it (relative to the middle's datum point).
vec3 roundGround(RoundTile T, vec2 o, out float h, out vec3 d) {
    vec3 at = roundDatum(T, o, d);
    h = landHeight(at);
    return at + h * d;
}
#endif

void main() {
    uint stride = pc.words[LF_P_STRIDE];
    uint tile = gl_WorkGroupID.z;
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (tile >= pc.words[LF_P_TILES] || texel.x >= stride || texel.y >= stride) return;
    vec4 f = fills[tile * (LF_TILE_WORDS / 4)];
    float t = f.z;
    vec2 p = f.xy + (vec2(texel) + 0.5) * t;
    landFootprint = t;

#ifdef LAND_ROUND
    uint b = tile * (LF_TILE_WORDS / 4);
    RoundTile T;
    T.mid = fills[b + 1];
    T.n = fills[b + 2].xyz;
    T.R = fills[b + 2].w;
    T.u = fills[b + 3].xyz;
    T.v = fills[b + 4].xyz;
    landOx = fills[b + 5].xy;
    landOy = fills[b + 5].zw;
    landOz = fills[b + 6].xy;
    float h, hx0, hx1, hz0, hz1;
    vec3 up, dn;
    vec3 datum = roundDatum(T, p, up);
    h = landHeight(datum);
    // The normal from the ground's points a texel either way (outward: half
    // the faces' u, n, v are left-handed), in the frame of the up there: x
    // along the face's u, z its v.
    vec3 px0 = roundGround(T, p - vec2(t, 0.0), hx0, dn), px1 = roundGround(T, p + vec2(t, 0.0), hx1, dn);
    vec3 pz0 = roundGround(T, p - vec2(0.0, t), hz0, dn), pz1 = roundGround(T, p + vec2(0.0, t), hz1, dn);
    vec3 nb = normalize(cross(pz1 - pz0, px1 - px0)) * sign(dot(cross(T.v, T.u), T.n));
    vec3 east = normalize(T.u - dot(T.u, up) * up), north = normalize(T.v - dot(T.v, up) * up);
    vec3 n = vec3(dot(nb, east), dot(nb, up), dot(nb, north));
    // (The chart's point: the middle's plus the offset.)
    p += fills[b + 6].zw;
    LandSurface s = landSurface(LandPoint(p, h, n, datum, up, t));
    vec3 leaves;
    vec2 canopy = plantsCanopy(datum, leaves);
#else
    float h = landHeight(p);
    // The normal from central differences a texel apart.
    float hx0 = landHeight(p - vec2(t, 0.0)), hx1 = landHeight(p + vec2(t, 0.0));
    float hz0 = landHeight(p - vec2(0.0, t)), hz1 = landHeight(p + vec2(0.0, t));
    vec3 n = normalize(vec3(hx0 - hx1, 2.0 * t, hz0 - hz1));
    LandSurface s = landSurface(LandPoint(p, h, n, vec3(p.x, 0.0, p.y), vec3(0.0, 1.0, 0.0), t));
    vec3 leaves;
    vec2 canopy = plantsCanopy(p, leaves);
#endif

    ivec3 at = ivec3(texel, int(f.w));
    imageStore(landHeights, at, vec4(h, max(canopy.y, 0.0), 0.0, 0.0));
    imageStore(landSurfaces, at, vec4(max(s.albedo, vec3(0.0)), clamp(s.herbs, 0.0, 1.0)));
    vec4 c = vec4(clamp(s.cover.xy, 0.0, 1.0), clamp(s.cover.z, 0.0, 2.0), clamp(s.cover.w, 0.0, 1.0));
    imageStore(landCovers, at, c);
    imageStore(landCanopies, at, vec4(max(leaves, vec3(0.0)), clamp(canopy.x, 0.0, 1.0)));
}
