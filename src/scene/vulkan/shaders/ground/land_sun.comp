#version 450
// The land's sun (ground/land_sun_layout.h; scene/world/land_sun.h): one
// level about the eye, a texel an invocation, from the land's tiles as the
// rings read them. From the texel's ground a ray climbs toward the sun over
// the land in steps that lengthen with the way come (LS_GROWTH of it, at
// least a texel), reading the tiles a step's length fine; at each step what
// stands there (the ground, and past the plants' cast range the canopy
// risen over it as the land draws it, mesh_land.vert) less the ray's climb
// to it is a height a point here must clear to see the sun. The texel keeps
// the highest (and how far off that stands, which sets its penumbra's
// width) and stops once nothing higher can come: the ray has climbed past
// the most anything stands. It starts a texel under the ground's own
// height (as though that stood a texel off): the lit ground clears it by
// more than a receiver's soft band (scene_lighting.glsl's landSunLevels)
// however low the sun.
//
// It is the sun of a shadow the shadow pages cannot hold: a low sun runs
// along the land and along a canopy's top, and their depth offsets swallow
// both (scene_lighting.glsl's sceneLandSun reads it).

#include "ground/scene_land_layout.h"
#include "ground/land_sun_layout.h"

layout(local_size_x = LS_GROUP, local_size_y = LS_GROUP) in;

layout(set = 0, binding = 0) uniform LandDrawUBO { vec4 w[LD_WORDS / 4]; } landDraw;
layout(set = 0, binding = 1) uniform sampler2DArray landHeights;
layout(set = 0, binding = 2) uniform sampler2DArray landSurfaces;
layout(set = 0, binding = 3) uniform usampler2DArray landPage;
layout(set = 0, binding = 4) uniform sampler2DArray landCanopies;
layout(set = 0, binding = 5, rg32f) uniform writeonly image2DArray landSun;
layout(push_constant) uniform Push { vec4 w[LS_P_WORDS / 4]; } push;

#define LAND_W(i) landDraw.w[i]
#define LAND_CANOPY
#include "ground/scene_land.glsl"

// What stands at `xz` read `step` metres fine: the ground, and the canopy
// over it as far as it is risen there.
float landStanding(vec2 xz, float step, float texel0, float castRange, bool canopy) {
    int s0, s1;
    vec2 uv0, uv1;
    float f;
    if (!landTexels(xz, log2(max(step / texel0, 1.0)), s0, uv0, s1, uv1, f)) return -1e9;
    vec2 h = textureLod(landHeights, vec3(uv0, float(s0)), 0.0).rg;
    float cover = canopy ? textureLod(landCanopies, vec3(uv0, float(s0)), 0.0).a : 0.0;
    if (s1 >= 0) {
        h = mix(h, textureLod(landHeights, vec3(uv1, float(s1)), 0.0).rg, f);
        if (canopy) cover = mix(cover, textureLod(landCanopies, vec3(uv1, float(s1)), 0.0).a, f);
    }
    if (!canopy) return h.x;
    float shown = landCanopyShown(length(landPoint(xz, h.x) - landEye3()), castRange);
    return h.x + h.y * cover * shown;
}

void main() {
    ivec2 v = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(v, ivec2(LS_SIDE)))) return;
    vec4 origin = push.w[LS_P_ORIGIN / 4];
    vec4 sun = push.w[LS_P_SUN / 4];
    float texel = origin.z;
    vec2 xz = origin.xy + (vec2(v) + 0.5) * texel;
    vec4 tiles = LAND_W(LD_TILES / 4);
    float texel0 = tiles.x / tiles.y;
    bool canopy = landHasCanopy();
    float castRange = landCanopyCastRange();

    // Toward the sun across the land, and how far the ray climbs a metre.
    vec3 L = normalize(sun.xyz);
    float across = length(L.xz);
    vec2 dir = across > 1e-6 ? L.xz / across : vec2(1.0, 0.0);
    float rise = max(L.y, 0.0) / max(across, 1e-6);
    float ceiling = sun.w;

    float ground = landStanding(xz, texel, texel0, castRange, false);
    float best = ground - texel * (rise + 1.0), bestAt = texel;
    float s = texel;
    for (int n = 0; n < LS_STEPS; ++n) {
        // Nothing past here stands high enough to shade a point the best
        // so far does not.
        // (A round body's ground falls away from here as the square of the
        // distance over twice its radius.)
        float drop = landRound() ? s * s / (2.0 * landRadius()) : 0.0;
        if (ceiling - s * rise - drop <= best) break;
        float step = max(texel, LS_GROWTH * s);
        float h = landStanding(xz + dir * s, step, texel0, castRange, canopy) - s * rise - drop;
        if (h > best) {
            best = h;
            bestAt = s;
        }
        s += step;
    }
    imageStore(landSun, ivec3(v, int(origin.w)), vec4(best, bestAt, 0.0, 0.0));
}
