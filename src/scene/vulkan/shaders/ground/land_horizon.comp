#version 450
// The land's horizon about the frame's eye (world/world_horizon_layout.h;
// scene_world_horizon.h), from its tiles as the rings read them about that
// eye: a workgroup a direction, a thread a distance step. Each thread takes
// the steepest slope of the land over its step's WH_SAMPLES heights (from
// just past the last step to its own), then the workgroup's running maximum
// outward is each step's slope.

#include "ground/scene_land_layout.h"
#include "world/world_horizon_layout.h"

layout(local_size_x = WH_STEPS) in;

layout(set = 0, binding = 0) uniform LandDrawUBO { vec4 w[LD_WORDS / 4]; } landDraw;
layout(set = 0, binding = 1) uniform sampler2DArray landHeights;
layout(set = 0, binding = 2) uniform sampler2DArray landSurfaces;
layout(set = 0, binding = 3) uniform usampler2DArray landPage;
layout(std430, set = 0, binding = 4) writeonly buffer Horizon { float w[]; } horizon;
layout(push_constant) uniform Push { vec4 eye; } push;   // xyz the eye

#define LAND_W(i) landDraw.w[i]
#include "ground/scene_land.glsl"

shared float sMax[WH_STEPS];

void main() {
    uint a = gl_WorkGroupID.x, k = gl_LocalInvocationID.x;
    vec3 eye = push.eye.xyz;
    float angle = ((float(a) + 0.5) / float(WH_AZIMUTHS) - 0.5) * 6.28318531;
    vec2 dir = vec2(sin(angle), cos(angle));
    // Step k's heights: sample j at WH_NEAREST * 2^(j / (WH_PER_OCTAVE *
    // WH_SAMPLES)), j from (k - 1) * WH_SAMPLES + 1 to k * WH_SAMPLES (step
    // 0 the one at WH_NEAREST).
    float best = -1e9;
    int last = int(k) * WH_SAMPLES;
    for (int j = max(last - WH_SAMPLES + 1, 0); j <= last; ++j) {
        float d = WH_NEAREST * exp2(float(j) / (WH_PER_OCTAVE * float(WH_SAMPLES)));
        vec2 xz = eye.xz + dir * d;
        int s0, s1;
        vec2 uv0, uv1;
        float f;
        if (!landTexels(xz, landLevel(xz), s0, uv0, s1, uv1, f)) continue;
        float h = textureLod(landHeights, vec3(uv0, float(s0)), 0.0).r;
        if (s1 >= 0) h = mix(h, textureLod(landHeights, vec3(uv1, float(s1)), 0.0).r, f);
        best = max(best, (h - WH_MARGIN - eye.y) / d);
    }
    // The running maximum outward (Hillis-Steele).
    sMax[k] = best;
    barrier();
    for (uint step = 1u; step < uint(WH_STEPS); step <<= 1) {
        float before = k >= step ? sMax[k - step] : -1e9;
        barrier();
        sMax[k] = max(sMax[k], before);
        barrier();
    }
    horizon.w[WH_HEADER + k * WH_AZIMUTHS + a] = sMax[k];
    if (a == 0u && k == 0u) {
        horizon.w[WH_H_EYE] = eye.x;
        horizon.w[WH_H_EYE + 1] = eye.y;
        horizon.w[WH_H_EYE + 2] = eye.z;
        horizon.w[WH_H_VALID] = 1.0;
    }
}
