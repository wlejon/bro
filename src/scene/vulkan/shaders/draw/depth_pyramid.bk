// The farthest depth under each texel of the camera's depth, level upon
// level (vulkan/draw/pass_instance_occlusion.h): the first level a texel to
// 2 x 2 pixels, each next one a texel to 2 x 2 of the level before (a level's
// odd last row or column a texel of its own), one after another in `levels`.
// Depth is reversed, so the farthest is the least. A sphere whose nearest
// depth is behind the texels its rectangle covers shows nowhere
// (instance_cull.bk's in_sight).

struct PyramidUBO {
    a: vec4<u32>,   // the source's width and height, the level's
    b: vec4<u32>,   // the source level's first word, the level's
}

@binding(0, 0) var u: uniform<PyramidUBO>;
@binding(0, 1) var scene_depth: sampler2d<vec4<f32>>;
@binding(0, 2) var levels: buffer<f32>;

@compute @workgroup_size(8, 8, 1)
fn pyramid_first() {
    let x = global_id_x();
    let y = global_id_y();
    let w = u.a.z as i32;
    let h = u.a.w as i32;
    if (x >= w || y >= h) { return; }
    let sw = u.a.x as i32;
    let sh = u.a.y as i32;
    let x0 = min(2 * x, sw - 1);
    let x1 = min(2 * x + 1, sw - 1);
    let y0 = min(2 * y, sh - 1);
    let y1 = min(2 * y + 1, sh - 1);
    let d = min(min(scene_depth.fetch(vec2<i32>(x0, y0), 0).x, scene_depth.fetch(vec2<i32>(x1, y0), 0).x),
                min(scene_depth.fetch(vec2<i32>(x0, y1), 0).x, scene_depth.fetch(vec2<i32>(x1, y1), 0).x));
    levels[(u.b.y as i32) + y * w + x] = d;
}

@compute @workgroup_size(8, 8, 1)
fn pyramid_next() {
    let x = global_id_x();
    let y = global_id_y();
    let w = u.a.z as i32;
    let h = u.a.w as i32;
    if (x >= w || y >= h) { return; }
    let sw = u.a.x as i32;
    let sh = u.a.y as i32;
    let src = u.b.x as i32;
    let x0 = min(2 * x, sw - 1);
    let x1 = min(2 * x + 1, sw - 1);
    let y0 = min(2 * y, sh - 1);
    let y1 = min(2 * y + 1, sh - 1);
    let d = min(min(levels[src + y0 * sw + x0], levels[src + y0 * sw + x1]),
                min(levels[src + y1 * sw + x0], levels[src + y1 * sw + x1]));
    levels[(u.b.y as i32) + y * w + x] = d;
}
