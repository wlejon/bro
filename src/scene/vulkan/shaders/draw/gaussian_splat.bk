// 3D Gaussian Splatting (PassGaussianSplat): EWA splat projection of 3D
// covariance to 2D screen-space ellipse (Zwicker et al. 2001, Kerbl et al.
// 2023) and premultiplied Gaussian evaluation.
import scene;

struct SplatUBO {
    u_model: mat4f,
    u_view: mat4f,
    u_proj: mat4f,
    u_focal: vec2<f32>,
    u_viewport: vec2<f32>,
}

@binding(0, 0) var ubo: uniform<SplatUBO>;

const K_SIGMA: f32 = 3.0;

fn quat_to_mat3(q: vec4<f32>) -> mat3f {
    let x = q.x;
    let y = q.y;
    let z = q.z;
    let w = q.w;
    let xx = x * x;
    let yy = y * y;
    let zz = z * z;
    let xy = x * y;
    let xz = x * z;
    let yz = y * z;
    let wx = w * x;
    let wy = w * y;
    let wz = w * z;
    return mat3f(
        vec3<f32>(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz),       2.0 * (xz - wy)),
        vec3<f32>(2.0 * (xy - wz),       1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx)),
        vec3<f32>(2.0 * (xz + wy),       2.0 * (yz - wx),       1.0 - 2.0 * (xx + yy))
    );
}

@vertex fn gaussian_splat_vert(
    @location(0) a_corner: vec2<f32>,
    @location(1) a_center: vec3<f32>,
    @location(2) a_scale: vec3<f32>,
    @location(3) a_quat: vec4<f32>,
    @location(4) a_color: vec4<f32>
) {
    let cam = scene::mul4(ubo.u_view, scene::mul4(ubo.u_model, vec4<f32>(a_center, 1.0)));
    let clip = scene::mul4(ubo.u_proj, cam);
    if (cam.z > -0.01 || clip.w <= 0.0) {
        set_vertex_output(0, vec2<f32>(0.0, 0.0));
        set_vertex_output(1, vec4<f32>(0.0, 0.0, 0.0, 0.0));
        set_vertex_position(vec4<f32>(2.0, 2.0, 2.0, 1.0));
        return;
    }

    let r = quat_to_mat3(a_quat);
    let s = mat3f(
        vec3<f32>(a_scale.x, 0.0, 0.0),
        vec3<f32>(0.0, a_scale.y, 0.0),
        vec3<f32>(0.0, 0.0, a_scale.z)
    );
    let m = scene::mul_mat3(scene::mat3_from4(ubo.u_model), scene::mul_mat3(r, s));
    let sigma = scene::mul_mat3(m, scene::transpose3(m));

    let zz = cam.z * cam.z;
    let j = mat3f(
        vec3<f32>(ubo.u_focal.x / cam.z, 0.0, 0.0),
        vec3<f32>(0.0, ubo.u_focal.y / cam.z, 0.0),
        vec3<f32>(-(ubo.u_focal.x * cam.x) / zz, -(ubo.u_focal.y * cam.y) / zz, 0.0)
    );

    let w = scene::mat3_from4(ubo.u_view);
    let t = scene::mul_mat3(j, w);
    let cov = scene::mul_mat3(scene::mul_mat3(t, sigma), scene::transpose3(t));

    let a = cov[0].x + 0.3;
    let b = cov[1].x;
    let d = cov[1].y + 0.3;
    let det = a * d - b * b;
    if (det <= 0.0) {
        set_vertex_output(0, vec2<f32>(0.0, 0.0));
        set_vertex_output(1, vec4<f32>(0.0, 0.0, 0.0, 0.0));
        set_vertex_position(vec4<f32>(2.0, 2.0, 2.0, 1.0));
        return;
    }

    let mid = 0.5 * (a + d);
    let disc = sqrt(max(0.0, mid * mid - det));
    let l1 = mid + disc;
    let l2 = mid - disc;

    let ev = abs(l1 - a) >= abs(l1 - d) ? vec2<f32>(b, l1 - a) : vec2<f32>(l1 - d, b);
    let e1 = dot(ev, ev) > 0.0 ? normalize(ev)
                               : (a >= d ? vec2<f32>(1.0, 0.0) : vec2<f32>(0.0, 1.0));
    let e2 = vec2<f32>(-e1.y, e1.x);
    let axis_major = e1 * (K_SIGMA * sqrt(l1));
    let axis_minor = e2 * (K_SIGMA * sqrt(max(0.0, l2)));

    let offset_px = a_corner.x * axis_major + a_corner.y * axis_minor;
    let offset_ndc = offset_px * 2.0 / ubo.u_viewport;

    let ndc = clip.xyz / clip.w;
    set_vertex_output(0, a_corner * K_SIGMA);
    set_vertex_output(1, a_color);
    set_vertex_position(vec4<f32>(ndc.xy + offset_ndc, ndc.z, 1.0));
}

@fragment fn gaussian_splat_frag(
    @location(0) v_pos: vec2<f32>,
    @location(1) v_color: vec4<f32>
) {
    let power = -0.5 * dot(v_pos, v_pos);
    let alpha = exp(power) * v_color.w;
    if (alpha < (1.0 / 255.0)) {
        discard_fragment();
    }
    set_frag_output(0, vec4<f32>(v_color.xyz * alpha, alpha));
}
