// ---------------------------------------------------------------------------
// Custom Hook Shadow Caster Vertex Stages
// ---------------------------------------------------------------------------

@vertex fn shadow_hook_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    push: mesh::ShadowPush
) {
    let model = mesh::caster_model(push);
    let inv_m3 = scene::inv3(scene::mat3_from4(model));
    let wp0 = scene::mul4(model, vec4<f32>(in_pos, 1.0)).xyz;
    let pos0 = in_pos + scene::mul3(inv_m3, scene::wind_delta(wp0, in_color.x * push.params.x));
    let v = hook::vertex(mesh::make_vertex_in(model, push.params.x, pos0, in_normal, in_uv, in_color, in_tangent));
    let world_pos = scene::mul4(model, vec4<f32>(v.pos, 1.0));
    set_vertex_position(scene::mul4(push.light_view_proj, world_pos));
}

@vertex fn shadow_hook_cutout_vert(
    @location(0) in_pos: vec3<f32>,
