// ---------------------------------------------------------------------------
// Custom Hook Vertex Stages
// ---------------------------------------------------------------------------

@vertex fn mesh_hook_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    push: mesh::Push
) {
    let m3 = scene::mat3_from4(push.model);
    let inv_m3 = scene::inv3(m3);
    let wp0 = scene::mul4(push.model, vec4<f32>(in_pos, 1.0)).xyz;
    let pos0 = in_pos + scene::mul3(inv_m3, scene::wind_delta(wp0, in_color.x * push.extra.z));
    let v = hook::vertex(mesh::make_vertex_in(push.model, push.extra.z, pos0, in_normal, in_uv, in_color, in_tangent));
    let world_pos = scene::mul4(push.model, vec4<f32>(v.pos, 1.0));
    let n = normalize(scene::mul3(scene::transpose3(inv_m3), v.normal));
    let t = normalize(scene::mul3(m3, in_tangent.xyz));
    let b = cross(n, t) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    mesh::emit_standard(world_pos, n, t, b, v.uv, col, vec4<f32>(1.0));
    mesh::emit_custom(v);
}

