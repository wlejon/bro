@fragment fn mesh_bark_indirect_frag(
    @location(0) world_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec3<f32>,
    @location(5) in_bitangent: vec3<f32>,
    @location(6) in_inst_color: vec4<f32>,
    @location(7) in_veg_shade: vec4<f32>,
    push: mesh::Push
) {
    let out = mesh::shade_bark(push, world_pos, in_normal, in_uv, in_color, in_tangent, in_bitangent, in_inst_color, in_veg_shade, front_facing());
