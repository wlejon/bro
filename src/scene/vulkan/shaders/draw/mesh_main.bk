    push: mesh::Push
) {
    let v = mesh::make_frag_vertex(push, world_pos, in_normal, in_uv, in_color, in_tangent, in_bitangent, v0, v1, v2, v3, v4, v5, vi);
    let s0 = mesh::prepare_surface(push, world_pos, in_normal, in_uv, in_color, in_tangent, in_bitangent, in_inst_color, front_facing());
    let s1 = prep_light_surface(hook::fragment(v, s0));
    let s = hook::light(v, s1);
    let out = mesh::finish_surface(push, world_pos, normalize(in_normal), in_uv, s, false, 1.0);
    set_frag_output(0, out.color);
}

@fragment fn mesh_hook_light_cuts_frag(
    @location(0) world_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
