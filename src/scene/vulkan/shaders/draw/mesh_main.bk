fn prep_light_surface(s: mesh::Surface) -> mesh::Surface {
    let n = normalize(s.normal);
    let sky_n = dot(s.sky_normal, s.sky_normal) <= 0.0001 ? n : s.sky_normal;
    return mesh::Surface {
        base_color: s.base_color,
        normal: n,
        metallic: s.metallic,
        roughness: s.roughness,
        emissive: s.emissive,
        alpha: s.alpha,
        sun_visibility: s.sun_visibility,
        sky_visibility: s.sky_visibility,
        sky_normal: sky_n,
        occluder_sun: s.occluder_sun,
        sun_diffuse: s.sun_diffuse,
        to_sun: s.to_sun,
        debug: s.debug,
    };
}

