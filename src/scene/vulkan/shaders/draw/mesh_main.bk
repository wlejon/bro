// Built-in and custom-hook vertex and fragment entry points for all scene
// meshes (Static, Instanced, Skinned, Scatter, Tube, Vegetation,
// InstancedVegetation) and custom shadow-caster vertex hooks.
import scene;
import lighting;
import vegetation;
import procedural;
import bark;
import mesh;
import hook;

// ---------------------------------------------------------------------------
// Built-in Vertex Stages
// ---------------------------------------------------------------------------

@vertex fn mesh_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    push: mesh::Push
) {
    let m3 = scene::mat3_from4(push.model);
    let inv_m3 = scene::inv3(m3);
    let wp0 = scene::mul4(push.model, vec4<f32>(in_pos, 1.0)).xyz;
    let pos = in_pos + scene::mul3(inv_m3, scene::wind_delta(wp0, in_color.x * push.extra.z));
    let world_pos = scene::mul4(push.model, vec4<f32>(pos, 1.0));
    let n = normalize(scene::mul3(scene::transpose3(inv_m3), in_normal));
    let t = normalize(scene::mul3(m3, in_tangent.xyz));
    let b = cross(n, t) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    mesh::emit_standard(world_pos, n, t, b, in_uv, col, vec4<f32>(1.0));
}

@vertex fn mesh_veg_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    @location(12) in_veg0: vec4<f32>,
    @location(13) in_veg1: vec4<f32>,
    @location(14) in_veg2: vec4<f32>,
    @location(15) in_veg3: vec4<f32>,
    push: mesh::Push
) {
    let m3 = scene::mat3_from4(push.model);
    let inv_m3 = scene::inv3(m3);
    let world_pos0 = scene::mul4(push.model, vec4<f32>(in_pos, 1.0)).xyz;
    let n0 = normalize(scene::mul3(scene::transpose3(inv_m3), in_normal));
    let t0 = normalize(scene::mul3(m3, in_tangent.xyz));
    let sw = vegetation::sway(push.model, in_veg0, in_veg1, in_veg2, in_veg3, n0, world_pos0, false);
    let n = scene::mul3(sw.rot, n0);
    let t = scene::mul3(sw.rot, t0);
    let b = cross(n, t) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    let tint = vegetation::tint(push.model, in_veg0, in_veg1, in_veg2, in_veg3, in_veg3.x > 0.5);
    mesh::emit_standard(vec4<f32>(sw.world_pos, 1.0), n, t, b, in_uv, col, vec4<f32>(tint, 1.0));
    set_vertex_output(7, sw.shade);
}

@vertex fn mesh_instanced_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    @location(8) in_inst_row0: vec4<f32>,
    @location(9) in_inst_row1: vec4<f32>,
    @location(10) in_inst_row2: vec4<f32>,
    @location(11) in_inst_color: vec4<f32>,
    push: mesh::Push
) {
    let r = mesh::inst_rot(in_inst_row0, in_inst_row1, in_inst_row2);
    let trans = vec3<f32>(in_inst_row0.w, in_inst_row1.w, in_inst_row2.w);
    let world_pos = scene::mul4(push.model, vec4<f32>(scene::mul3(r, in_pos) + trans, 1.0));
    let m3 = scene::mul_mat3(scene::mat3_from4(push.model), r);
    let n = normalize(scene::mul3(scene::transpose3(scene::inv3(m3)), in_normal));
    let t = normalize(scene::mul3(m3, in_tangent.xyz));
    let b = cross(n, t) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    mesh::emit_standard(world_pos, n, t, b, in_uv, col, in_inst_color);
}

@vertex fn mesh_instanced_veg_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    @location(8) in_inst_row0: vec4<f32>,
    @location(9) in_inst_row1: vec4<f32>,
    @location(10) in_inst_row2: vec4<f32>,
    @location(11) in_inst_color: vec4<f32>,
    @location(12) in_veg0: vec4<f32>,
    @location(13) in_veg1: vec4<f32>,
    @location(14) in_veg2: vec4<f32>,
    @location(15) in_veg3: vec4<f32>,
    push: mesh::Push
) {
    let r = mesh::inst_rot(in_inst_row0, in_inst_row1, in_inst_row2);
    let trans = vec3<f32>(in_inst_row0.w, in_inst_row1.w, in_inst_row2.w);
    let world_pos0 = scene::mul4(push.model, vec4<f32>(scene::mul3(r, in_pos) + trans, 1.0)).xyz;
    let m3 = scene::mul_mat3(scene::mat3_from4(push.model), r);
    let n0 = normalize(scene::mul3(scene::transpose3(scene::inv3(m3)), in_normal));
    let t0 = normalize(scene::mul3(m3, in_tangent.xyz));
    let sw = vegetation::sway(push.model, in_veg0, in_veg1, in_veg2, in_veg3, n0, world_pos0, false);
    let n = scene::mul3(sw.rot, n0);
    let t = scene::mul3(sw.rot, t0);
    let b = cross(n, t) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    let tint = vegetation::tint(push.model, in_veg0, in_veg1, in_veg2, in_veg3, in_veg3.x > 0.5);
    let inst_col = vec4<f32>(in_inst_color.xyz * tint, in_inst_color.w);
    mesh::emit_standard(vec4<f32>(sw.world_pos, 1.0), n, t, b, in_uv, col, inst_col);
    set_vertex_output(7, sw.shade);
}

@vertex fn mesh_skinned_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    @location(5) in_joints: vec4<u32>,
    @location(6) in_weights: vec4<f32>,
    push: mesh::Push
) {
    let skin = mesh::skin_matrix(in_joints, in_weights);
    let skin_n = scene::mat3_from4(skin);
    let m3 = scene::mat3_from4(push.model);
    let inv_m3 = scene::inv3(m3);
    let p_skin = scene::mul4(skin, vec4<f32>(in_pos, 1.0)).xyz;
    let n_skin = scene::mul3(skin_n, in_normal);
    let wp0 = scene::mul4(push.model, vec4<f32>(p_skin, 1.0)).xyz;
    let pos = p_skin + scene::mul3(inv_m3, scene::wind_delta(wp0, in_color.x * push.extra.z));
    let world_pos = scene::mul4(push.model, vec4<f32>(pos, 1.0));
    let n = normalize(scene::mul3(scene::transpose3(inv_m3), n_skin));
    let t = normalize(scene::mul3(m3, scene::mul3(skin_n, in_tangent.xyz)));
    let b = cross(n, t) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    mesh::emit_standard(world_pos, n, t, b, in_uv, col, vec4<f32>(1.0));
}

@vertex fn mesh_scatter_vert(
    @location(0) in_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec4<f32>,
    push: mesh::Push
) {
    let idx = procedural::scatter_leaf_index(instance_index(), vertex_index());
    var valid: bool = idx.valid;
    var sl: procedural::ScatterLeaf = procedural::ScatterLeaf {
        valid: false,
        p: vec3<f32>(0.0),
        r: mat3f(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), vec3<f32>(0.0, 0.0, 1.0)),
        f: vec3<f32>(0.0, 0.0, 1.0),
        seg: 0,
        along: 0.0,
    };
    if (valid) {
        sl = procedural::scatter_leaf(idx.leaf);
        valid = sl.valid;
    }
    var wp: vec3<f32> = vec3<f32>(0.0);
    var nw: vec3<f32> = vec3<f32>(0.0, 1.0, 0.0);
    var tw: vec3<f32> = vec3<f32>(1.0, 0.0, 0.0);
    var veg_shade: vec4<f32> = vec4<f32>(0.0, 0.0, 0.0, 1.0);
    var inst_col: vec4<f32> = vec4<f32>(1.0);
    if (valid) {
        let m_node = scene::mat3_from4(push.model);
        let m3 = scene::mul_mat3(m_node, sl.r);
        wp = scene::mul4(push.model, vec4<f32>(scene::mul3(sl.r, in_pos) + sl.p, 1.0)).xyz;
        nw = normalize(scene::mul3(scene::transpose3(scene::inv3(m3)), in_normal));
        tw = normalize(scene::mul3(m3, in_tangent.xyz));
        if (procedural::has_vegetation()) {
            let vr = procedural::vegetation_at(sl.seg, sl.along, sl.p);
            let card_n = normalize(scene::mul3(m_node, sl.r[1]));
            let sw = vegetation::sway_axis(push.model, vr.v0, vr.v1, vr.v2, vr.v3, sl.f, card_n, wp, false);
            wp = sw.world_pos;
            veg_shade = sw.shade;
            inst_col = vec4<f32>(vegetation::tint(push.model, vr.v0, vr.v1, vr.v2, vr.v3, true), 1.0);
            nw = scene::mul3(sw.rot, nw);
            tw = scene::mul3(sw.rot, tw);
        }
    }
    let bw = cross(nw, tw) * in_tangent.w;
    let col = mesh::vertex_color_mode(push) != 0u ? in_color : vec4<f32>(1.0);
    set_vertex_position(valid ? scene::clip(wp) : vec4<f32>(2.0, 2.0, 2.0, 1.0));
    set_vertex_output(0, wp);
    set_vertex_output(1, nw);
    set_vertex_output(2, in_uv);
    set_vertex_output(3, col);
    set_vertex_output(4, tw);
    set_vertex_output(5, bw);
    set_vertex_output(6, inst_col);
    set_vertex_output(7, veg_shade);
}

@vertex fn mesh_tube_vert(push: mesh::Push) {
    let tv = procedural::tube_vertex(vertex_index());
    var pos: vec3<f32> = tv.pos;
    var out_color: vec4<f32> = vec4<f32>(1.0);
    var out_uv: vec2<f32> = vec2<f32>(0.0, -1.0);
    var veg_shade: vec4<f32> = vec4<f32>(0.0, 0.0, 0.0, 1.0);
    var inst_col: vec4<f32> = vec4<f32>(1.0);
    var wp: vec3<f32> = vec3<f32>(0.0);
    var n: vec3<f32> = vec3<f32>(0.0, 1.0, 0.0);
    var t: vec3<f32> = vec3<f32>(1.0, 0.0, 0.0);
    if (tv.valid) {
        let has_veg = procedural::has_vegetation();
        var vr: procedural::VegRecord = procedural::VegRecord {
            v0: vec4<f32>(0.0), v1: vec4<f32>(0.0), v2: vec4<f32>(0.0), v3: vec4<f32>(0.0)
        };
        if (has_veg) {
            vr = procedural::vegetation_at(tv.seg, tv.end_t, pos);
            let h0 = procedural::header(0);
            let h2 = procedural::header(2);
            let stride = h0.z > 2.5 ? 3 : 2;
            let s0 = procedural::record(tv.seg * stride);
            let s1 = procedural::record(tv.seg * stride + 1);
            let bark_rec = procedural::record(((h2.z + 0.5) as i32) + tv.seg * 4 + 2);
            let rad = mix(s0.w, s1.w, tv.end_t) * h0.y;
            let ang = tv.uv.x * procedural::TWO_PI;
            let hb = pos.y - vr.v0.y;
            let seed = fract(sin(dot(vr.v0.xz, vec2<f32>(12.9898, 78.233))) * 43758.5453);
            pos += tv.radial * (rad * bark::buttress(ang, hb, rad, seed));
            let sc = vegetation::scale_of(push.model);
            let along = bark_rec.z + tv.end_t * length(s1.xyz - s0.xyz);
            out_color = vec4<f32>(cos(ang) * rad * sc, sin(ang) * rad * sc, along * sc, rad * sc);
            out_uv = vec2<f32>(hb * sc, bark_rec.w);
        }
        wp = scene::mul4(push.model, vec4<f32>(pos, 1.0)).xyz;
        let m3 = scene::mat3_from4(push.model);
        n = normalize(scene::mul3(m3, tv.radial));
        t = normalize(scene::mul3(m3, tv.axis_dir));
        if (has_veg) {
            let sw = vegetation::sway_axis(push.model, vr.v0, vr.v1, vr.v2, vr.v3, vec3<f32>(0.0), n, wp, false);
            wp = sw.world_pos;
            veg_shade = sw.shade;
            inst_col = vec4<f32>(vegetation::tint(push.model, vr.v0, vr.v1, vr.v2, vr.v3, false), 1.0);
            n = scene::mul3(sw.rot, n);
            t = scene::mul3(sw.rot, t);
        }
    }
    let b = cross(n, t);
    set_vertex_position(tv.valid ? scene::clip(wp) : vec4<f32>(2.0, 2.0, 2.0, 1.0));
    set_vertex_output(0, wp);
    set_vertex_output(1, n);
    set_vertex_output(2, out_uv);
    set_vertex_output(3, out_color);
    set_vertex_output(4, t);
    set_vertex_output(5, b);
    set_vertex_output(6, inst_col);
    set_vertex_output(7, veg_shade);
}

// ---------------------------------------------------------------------------
// Built-in Fragment Stages
// ---------------------------------------------------------------------------

@fragment fn mesh_frag(
    @location(0) world_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec3<f32>,
    @location(5) in_bitangent: vec3<f32>,
    @location(6) in_inst_color: vec4<f32>,
    push: mesh::Push
) {
    let out = mesh::shade_builtin(push, world_pos, in_normal, in_uv, in_color, in_tangent, in_bitangent, in_inst_color, front_facing());
    set_frag_output(0, out.color);
}

@fragment fn mesh_cuts_frag(
    @location(0) world_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec3<f32>,
    @location(5) in_bitangent: vec3<f32>,
    @location(6) in_inst_color: vec4<f32>,
    push: mesh::Push
) {
    if (mesh::should_cut(push, world_pos, in_uv, in_color, in_inst_color)) {
        discard_fragment();
    }
    let out = mesh::shade_builtin(push, world_pos, in_normal, in_uv, in_color, in_tangent, in_bitangent, in_inst_color, front_facing());
    set_frag_output(0, out.color);
}

@fragment fn mesh_indirect_frag(
    @location(0) world_pos: vec3<f32>,
    @location(1) in_normal: vec3<f32>,
    @location(2) in_uv: vec2<f32>,
    @location(3) in_color: vec4<f32>,
    @location(4) in_tangent: vec3<f32>,
    @location(5) in_bitangent: vec3<f32>,
    @location(6) in_inst_color: vec4<f32>,
    push: mesh::Push
) {
    let out = mesh::shade_builtin(push, world_pos, in_normal, in_uv, in_color, in_tangent, in_bitangent, in_inst_color, front_facing());
    set_frag_output(0, out.color);
    set_frag_output(1, out.indirect);
}

