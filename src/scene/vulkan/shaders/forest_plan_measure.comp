#version 450
// The forest planner's first stage (scene_forest_gpu_plan.cpp), a thread a
// tree: the camera's measure of it, as planForest takes it (its distances
// to the tree's box and crown, its pixels per unit at each, its bark's
// classes, classifyBark), its key in the camera's order, and whether each
// shadow tile sees it.
//
// The trees are walked in the node's cell order: with push.round 1 those of
// the cells some view sees (the world cell pass's list, CELLS), else every
// tree. A tree no view's cell holds is in no view, so the plan is the same
// either way; only the trees walked are fewer. Each place measured keeps
// its tree (FP_W_TREE_OF) and its key and tile flags go at its place, so the
// stages after walk the measured alone, in cell order (whose dispatches the
// first thread writes). No far cell is planned apart yet: a far cell's trees
// come out of the rules a crown alone, as the CPU's shortcut takes them.

#include "scene_forest_plan.glsl"
#include "world_cells_layout.h"

layout(std430, set = 0, binding = 6) readonly buffer PlanCells { uint w[]; } planCells;

layout(local_size_x = FP_GROUP_SIZE) in;

shared uint sCount[FP_MAX_VIEWS];

// std::clamp(v, lo, hi): v < lo ? lo : hi < v ? hi : v (a box thinner than
// twice the reach clamps to its low side, as the CPU's does).
float clampStd(float v, float lo, float hi) { return v < lo ? lo : (hi < v ? hi : v); }

// ForestPlan::classifyBark: the camera's bark classes by each segment's own
// width at its distance from the eye, each class one past the last segment
// that needs it. Its segments are measured by the whole workgroup (classify
// below): a tree beside the eye measures every segment it has, thousands,
// and a thread a tree took the walk's measure stage 3.6 GPU ms, the
// workgroup waiting on its one near tree. Here each tree's setup: the
// segments to measure (`m`), its classes 0 (none yet) or, where the CPU
// returns before measuring, left at FP_ALL_SEGMENTS.
uint classifySetup(Spec sp, float px, float barkPx, inout uint curveEnd, inout uint fineEnd, inout uint nearEnd) {
    if (!gPerspective || sp.segCount == 0u) return 0u;
    if ((sp.segStart + sp.segCount) > su(FP_ST_SEGMENT_COUNT)) return 0u;
    float near_ = max(px, barkPx);
    precise float fine = gLod.barkFineSides * gLod.barkSidesPixels;
    float wMin = min(gLod.barkSidesPixels, fine > 0.0 ? fine : gLod.barkSidesPixels);
    precise float wDen = 2.0 * 1.25 * near_;
    float rMin = min(fdiv(kBarkCurvePixels, near_), fdiv(wMin, wDen));
    curveEnd = 0u;
    fineEnd = 0u;
    nearEnd = 0u;
    return firstUnder(sp.segStart, 0u, sp.segCount, rMin);
}

// The workgroup's trees' segments to measure, end to end: each tree's run
// (sRun, an inclusive scan of their counts), its first segment, the eye in
// its specimen's space and its metres a unit; its classes, raised by any
// thread (a class is a maximum over its segments, in any order).
shared uint sRun[FP_GROUP_SIZE];
shared uint sSeg[FP_GROUP_SIZE];
shared vec4 sEye[FP_GROUP_SIZE];
shared uint sEnd[3][FP_GROUP_SIZE];

void classify(uint lid) {
    // (Hillis-Steele: the counts' inclusive scan.)
    for (uint step = 1u; step < uint(FP_GROUP_SIZE); step <<= 1) {
        uint add = lid >= step ? sRun[lid - step] : 0u;
        barrier();
        sRun[lid] += add;
        barrier();
    }
    uint total = sRun[FP_GROUP_SIZE - 1];
    if (total == 0u) return;
    precise float fine = gLod.barkFineSides * gLod.barkSidesPixels;
    uint segs = su(FP_ST_SEGMENTS);
    for (uint w = lid; w < total; w += uint(FP_GROUP_SIZE)) {
        // The tree whose run holds `w`: the first run ending past it.
        uint lo = 0u, hi = uint(FP_GROUP_SIZE) - 1u;
        while (lo < hi) {
            uint mid = (lo + hi) >> 1;
            if (sRun[mid] > w) hi = mid; else lo = mid + 1u;
        }
        uint j = lo;
        uint i = w - (j > 0u ? sRun[j - 1u] : 0u);
        vec3 e = sEye[j].xyz;
        float unit = sEye[j].w;
        uint s = sSeg[j] + i;
        uint g = segs + s * 8u;
        vec3 a = sv3(g), b = sv3(g + 4u);
        float k0 = keepAt(s);
        precise vec3 ab = b - a;
        precise float l2 = ab.x * ab.x + ab.y * ab.y + ab.z * ab.z;
        precise vec3 ea = e - a;
        precise float dotEA = ea.x * ab.x + ea.y * ab.y + ea.z * ab.z;
        float f = l2 > 0.0 ? clamp(fdiv(dotEA, l2), 0.0, 1.0) : 0.0;
        precise vec3 onSeg = a + ab * f;
        precise vec3 off = e - onSeg;
        precise float gap = flen(off) - k0;
        precise float dRaw = gap * unit;
        float d = max(dRaw, 0.25);
        precise float pxAt = gPxAtMetre * unit;
        float pxu = fdiv(pxAt, d);
        precise float radiusPx = k0 * pxu;
        if (radiusPx > kBarkCurvePixels) atomicMax(sEnd[0][j], i + 1u);
        precise float wPx = 2.0 * 1.25 * k0 * pxu;
        if (fine > 0.0 && wPx >= fine) atomicMax(sEnd[1][j], i + 1u);
        if (wPx >= gLod.barkSidesPixels) atomicMax(sEnd[2][j], i + 1u);
    }
}

// The tree at place `p` of those measured: the cells' (the cell in view
// whose items hold it, the last starting at or before it) or the node's.
uint treeAt(uint p, bool cells) {
    uint k = p;
    if (cells) {
        uint lo = 0u, hi = planCells.w[WC_O_CELLS] - 1u;
        while (lo < hi) {
            uint mid = (lo + hi + 1u) >> 1;
            if (planCells.w[WC_O_HEADER + mid * WC_V_WORDS + WC_V_PREFIX] <= p) lo = mid; else hi = mid - 1u;
        }
        uint v = WC_O_HEADER + lo * WC_V_WORDS;
        k = planCells.w[v + WC_V_FIRST] + (p - planCells.w[v + WC_V_PREFIX]);
    }
    return su(su(FP_ST_ORDER) + k);
}

// The stages after this one walk the measured: their counts and dispatches.
void sizeStages(uint measured) {
    uint stride = (measured + uint(FP_GROUP_SIZE) - 1u) / uint(FP_GROUP_SIZE) * uint(FP_GROUP_SIZE);
    planWork.w[FP_N_MEASURED] = measured;
    planWork.w[FP_N_ITEM_STRIDE] = stride;
    planWork.w[workRun(FP_W_FLAGS) + gTiles * measured] = 0u;
    planArgs.w[FP_A_SORT_DISPATCH] = (measured + uint(FP_SCAN_BLOCK) - 1u) / uint(FP_SCAN_BLOCK);
    planArgs.w[FP_A_SORT_DISPATCH + 1] = 1u;
    planArgs.w[FP_A_SORT_DISPATCH + 2] = 1u;
    planArgs.w[FP_A_FILL_DISPATCH] = (1u + gTiles) * stride / uint(FP_GROUP_SIZE);
    planArgs.w[FP_A_FILL_DISPATCH + 1] = 1u;
    planArgs.w[FP_A_FILL_DISPATCH + 2] = 1u;
    planScanSized(gTiles * measured + 1u, FP_N_SCAN_FLAGS, FP_A_SCAN_FLAGS);
    planScanSized(uint(FP_SORT_DIGITS) * planArgs.w[FP_A_SORT_DISPATCH], FP_N_SCAN_HIST, FP_A_SCAN_HIST);
}

void main() {
    planBegin();
    uint lid = gl_LocalInvocationID.x;
    if (lid < uint(FP_MAX_VIEWS)) sCount[lid] = 0u;
    sRun[lid] = 0u;
    barrier();
    bool cells = planPush.round != 0u;
    uint measured = cells ? min(planCells.w[WC_O_ITEMS], gTrees) : gTrees;
    uint place = gl_GlobalInvocationID.x;
    uint keysA = workRun(FP_W_KEYS_A), valsA = workRun(FP_W_VALS_A);
    if (place == 0u) sizeStages(measured);
    uint i = 0u;
    if (place < measured) {
        uint key = FP_SORT_UNSEEN;
        i = treeAt(place, cells);
        {
            Tree tr = planTree(i);
            Spec sp = planSpec(tr.specimen);
            uint cam = workRun(FP_W_CAMERA) + i * FP_CAM_WORDS;
            bool seen = false;
            float px = 0.0, barkPx = 0.0, dl = -1.0, far_ = -1.0;
            uint curveEnd = FP_ALL_SEGMENTS, fineEnd = FP_ALL_SEGMENTS, nearEnd = FP_ALL_SEGMENTS;
            if (planIntersects(FP_P_FRUSTUM, tr.bmin, tr.bmax)) {
                // planForest's camera loop.
                float r = pf(FP_P_REACH);
                precise vec3 lo = tr.bmin + vec3(r);
                precise vec3 hi = tr.bmax - vec3(r);
                vec3 e = gEye;
                vec3 q = vec3(clampStd(e.x, lo.x, hi.x), clampStd(e.y, lo.y, hi.y), clampStd(e.z, lo.z, hi.z));
                precise vec3 qe = q - e;
                float d = max(flen(qe), 0.25);
                if (!(gLod.range > 0.0 && d > gLod.range)) {
                    seen = true;
                    dl = d;
                    far_ = d;
                    if (sp.clumpCount > 0u) {
                        precise vec3 local = vec3(sp.crown.x * tr.cosYaw + sp.crown.z * tr.sinYaw, sp.crown.y,
                                                  -sp.crown.x * tr.sinYaw + sp.crown.z * tr.cosYaw);
                        precise vec3 p = tr.position + local * tr.scale;
                        vec3 c = rowsPoint(FP_P_WORLD, p);
                        precise float unitK = tr.scale * gNodeScale;
                        float k = fdiv(unitK, 0.92);
                        precise float dhRaw = fhypot(e.x - c.x, e.z - c.z) - sp.crownRadius * k;
                        precise float dvRaw = abs(e.y - c.y) - sp.crownRadiusUp * k;
                        float dh = max(0.0, dhRaw), dv = max(0.0, dvRaw);
                        dl = max(fhypot(dh, dv), d);
                        precise vec3 ce = c - e;
                        precise float farD = flen(ce) + max(sp.crownRadius, sp.crownRadiusUp) * k;
                        far_ = farD;
                    }
                    precise float unit = tr.scale * gNodeScale;
                    precise float pxv = (gPerspective ? fdiv(gPxAtMetre, dl) : gPxAtMetre) * unit;
                    precise float barkv = (gPerspective ? fdiv(gPxAtMetre, d) : gPxAtMetre) * unit;
                    px = pxv;
                    barkPx = barkv;
                    uint m = classifySetup(sp, px, barkPx, curveEnd, fineEnd, nearEnd);
                    if (m > 0u) {
                        vec3 eyeNode = rowsPoint(FP_P_INV_WORLD, gEye);
                        precise vec3 rel = eyeNode - tr.position;
                        precise vec3 v = rel * fdiv(1.0, tr.scale);
                        precise vec3 es = vec3(v.x * tr.cosYaw - v.z * tr.sinYaw, v.y,
                                               v.x * tr.sinYaw + v.z * tr.cosYaw);
                        precise float unit = tr.scale * gNodeScale;
                        sRun[lid] = m;
                        sSeg[lid] = sp.segStart;
                        sEye[lid] = vec4(es, unit);
                    }
                    key = min(floatBitsToUint(centreDist(tr)) >> (32 - FP_SORT_BITS), FP_SORT_UNSEEN - 1u);
                }
            }
            planWork.w[cam + FP_CAM_SEEN] = seen ? 1u : 0u;
            planWork.w[cam + FP_CAM_PX] = floatBitsToUint(px);
            planWork.w[cam + FP_CAM_BARK_PX] = floatBitsToUint(barkPx);
            planWork.w[cam + FP_CAM_DIST] = floatBitsToUint(dl);
            planWork.w[cam + FP_CAM_FAR] = floatBitsToUint(far_);
            // (Its bark classes once the workgroup has measured them.)
            sEnd[0][lid] = curveEnd;
            sEnd[1][lid] = fineEnd;
            sEnd[2][lid] = nearEnd;
            if (seen) atomicAdd(sCount[0], 1u);
            // Each shadow tile's view of it (the camera's or not).
            uint flags = workRun(FP_W_FLAGS);
            for (uint t = 0u; t < gTiles; ++t) {
                bool in_ = planIntersects(FP_P_TILE + t * FP_TILE_WORDS + FP_TILE_FRUSTUM, tr.bmin, tr.bmax);
                planWork.w[flags + t * measured + place] = in_ ? 1u : 0u;
                if (in_) atomicAdd(sCount[1u + t], 1u);
            }
        }
        planWork.w[keysA + place] = key;
        planWork.w[valsA + place] = i;
        planWork.w[workRun(FP_W_TREE_OF) + place] = i;
    }
    barrier();
    classify(lid);
    barrier();
    if (place < measured) {
        uint cam = workRun(FP_W_CAMERA) + i * FP_CAM_WORDS;
        planWork.w[cam + FP_CAM_CURVE_END] = sEnd[0][lid];
        planWork.w[cam + FP_CAM_FINE_END] = sEnd[1][lid];
        planWork.w[cam + FP_CAM_NEAR_END] = sEnd[2][lid];
    }
    if (lid <= gTiles && sCount[lid] > 0u) atomicAdd(planWork.w[FP_N_VIEW_COUNT + lid], sCount[lid]);
}
