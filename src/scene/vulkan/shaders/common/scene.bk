// The scene's frame state as every stage composed with the engine reads it:
// set 0, the camera (SceneCameraUniforms, scene_vk_descriptors.h), and the
// math the stages share.
//
// Everything is CAMERA-RELATIVE (scene/vulkan/frame/scene_view.h): model
// matrices arrive with the eye subtracted, so a "world" position in any scene
// stage is world - eye, the eye sits at the origin, and view / view_proj take
// such positions. eye_world is the one absolute position, for what is a
// function of where the camera really is (height fog, the atmosphere).
module scene;

import wind;

pub struct Camera {
    view: mat4f,
    proj: mat4f,
    view_proj: mat4f,
    inv_view: mat4f,
    inv_proj: mat4f,
    eye_world: vec4<f32>,
    viewport: vec4<f32>,     // x: width, y: height, z: near, w: far
    fog_params: vec4<f32>,   // x: start, y: end, z: density, w: start distance
    fog_color: vec4<f32>,    // rgb, a: height falloff
    wind: vec4<f32>,         // xyz: direction, w: strength
    // x: time (s), y: frequency, z: the eye's phase (dot(eye.xz, (0.3, 0.5))
    // mod 2 pi), w: the oscillator clock, time mod the wind clock's period.
    wind_params: vec4<f32>,
    // The wind field (common/wind.bk): xy its horizontal direction
    // (x, z; unit, drifting), z its steady speed (m/s), w the gusts' travel
    // speed (m/s).
    wind_field: vec4<f32>,
    wind_gust: vec4<f32>,    // x: gust amount, y: 1 / band length along the wind, z: 1 / across it
    // x: the render's index mod 65536, for noise that changes every render
    // (a volume's jitter, which the volumes' reconstruction averages).
    // y: the debug view shown (scene/debug_views.h), 0 for none.
    frame: vec4<f32>,
}

@binding(0, 0) pub var camera: uniform<Camera>;

pub const PI: f32 = 3.14159265359;

// What the scene's HDR target holds at most (RGBA16F's largest finite value,
// rounded down): a lit surface's output is clamped to it, so a highlight of a
// sun in lux saturates rather than turning the pixel infinite.
pub const HDR_MAX: f32 = 64000.0;

// The debug view shown (SceneRenderer::setDebugView), 0 for none: a stage's
// SCENE_DEBUG(name) tests it against name's id (scene/debug_views.h).
pub fn debug_view() -> i32 {
    return (camera.frame.y + 0.5) as i32;
}

// m * v, m column-major (a matrix is its columns).
pub fn mul4(m: mat4f, v: vec4<f32>) -> vec4<f32> {
    return m[0] * v.x + m[1] * v.y + m[2] * v.z + m[3] * v.w;
}
pub fn mul3(m: mat3f, v: vec3<f32>) -> vec3<f32> {
    return m[0] * v.x + m[1] * v.y + m[2] * v.z;
}
// transpose(m) * v: v into the frame whose axes are m's columns.
pub fn mul3t(m: mat3f, v: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(dot(m[0], v), dot(m[1], v), dot(m[2], v));
}

// The pixel's ray through window position `frag` (camera-relative, unit),
// from the inverse projection and view.
pub fn view_ray(frag: vec2<f32>) -> vec3<f32> {
    let uv = frag / camera.viewport.xy;
    let v = mul4(camera.inv_proj, vec4<f32>(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, 0.5, 1.0));
    let w = mul4(camera.inv_view, vec4<f32>(v.x / v.w, v.y / v.w, v.z / v.w, 0.0));
    return normalize(w.xyz);
}

// A hash of two integers to [0, 1).
pub fn hash2(x: u32, y: u32) -> f32 {
    var h: u32 = x * 1973u + y * 9277u;
    h = (h ^ (h >> 13u)) * 0x5bd1e995u;
    return ((h ^ (h >> 15u)) & 1023u) as f32 / 1024.0;
}

// transpose(inverse(mat3(m0, m1, m2))) * v for transforming normals.
pub fn mul_normal(m0: vec3<f32>, m1: vec3<f32>, m2: vec3<f32>, v: vec3<f32>) -> vec3<f32> {
    let c0 = cross(m1, m2);
    let c1 = cross(m2, m0);
    let c2 = cross(m0, m1);
    let det = dot(m0, c0);
    let inv_det = select(det != 0.0, 1.0 / det, 0.0);
    return (c0 * v.x + c1 * v.y + c2 * v.z) * inv_det;
}

pub fn mat3_from4(m: mat4f) -> mat3f {
    return mat3f(m[0].xyz, m[1].xyz, m[2].xyz);
}

pub fn mul_mat3(a: mat3f, b: mat3f) -> mat3f {
    return mat3f(mul3(a, b[0]), mul3(a, b[1]), mul3(a, b[2]));
}

pub fn transpose3(m: mat3f) -> mat3f {
    return mat3f(vec3<f32>(m[0].x, m[1].x, m[2].x),
                 vec3<f32>(m[0].y, m[1].y, m[2].y),
                 vec3<f32>(m[0].z, m[1].z, m[2].z));
}

pub fn inv3(m: mat3f) -> mat3f {
    let c0 = cross(m[1], m[2]);
    let c1 = cross(m[2], m[0]);
    let c2 = cross(m[0], m[1]);
    let det = dot(m[0], c0);
    let inv_det = select(det != 0.0, 1.0 / det, 0.0);
    return transpose3(mat3f(c0 * inv_det, c1 * inv_det, c2 * inv_det));
}

pub fn clip(world_pos: vec3<f32>) -> vec4<f32> {
    return mul4(camera.view_proj, vec4<f32>(world_pos, 1.0));
}

pub fn view_pos(world_pos: vec3<f32>) -> vec3<f32> {
    return mul4(camera.view, vec4<f32>(world_pos, 1.0)).xyz;
}

// Vertex wind displacement.
pub fn wind_delta(pos: vec3<f32>, bend: f32) -> vec3<f32> {
    if camera.wind.w <= 0.0 || bend <= 0.0 { return vec3<f32>(0.0, 0.0, 0.0); }
    let phase = sin(camera.wind_params.x * camera.wind_params.y + camera.wind_params.z +
                    dot(pos.xz, vec2<f32>(0.3, 0.5)));
    return camera.wind.xyz * (phase * camera.wind.w * bend);
}

// --- The wind field (common/wind.bk), at the camera block's state ----------

pub fn wind_gust_at_time(xz: vec2<f32>, t: f32, fine: bool) -> f32 {
    return wind::wind_gust(xz, t, camera.wind_field.xy, camera.wind_field.w, camera.wind_gust.x,
                           camera.wind_gust.yz, fine);
}

const WIND_CLOCK_PERIOD: f32 = 256.0;

pub fn wind_cycles(hz: f32) -> f32 {
    let f = floor(hz * WIND_CLOCK_PERIOD + 0.5) / WIND_CLOCK_PERIOD;
    return fract(f * camera.wind_params.w);
}

pub fn wind_gust_at(xz: vec2<f32>) -> f32 {
    return wind_gust_at_time(xz, camera.wind_params.x, true);
}

pub fn wind_at(pos: vec3<f32>) -> vec4<f32> {
    return wind::wind_velocity(pos.xz + camera.eye_world.xz, camera.wind_params.x, camera.wind_field.xy,
                               camera.wind_field.z, camera.wind_field.w, camera.wind_gust.x, camera.wind_gust.yz);
}
