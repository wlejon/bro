// Set 1 of every lit scene stage: the lights, the shadow pages, the
// environment and the atmosphere's tables (LightingUBO and the lighting set
// layout, scene_vk_descriptors.h / .cpp), and what the stages ask of them.
module lighting;

import scene;
import atmosphere;
from scene import camera;

pub const MAX_LIGHTS: i32 = 32;
const MAX_SHADOW_MAPS: i32 = 32;   // shadow_pages_layout.h SP_MAX_MAPS

pub struct Light {
    position: vec4<f32>,      // xyz camera-relative position, w type (0 directional)
    direction: vec4<f32>,     // xyz unit direction (light -> scene), w range (0 = unbounded)
    color: vec4<f32>,         // rgb linear, a intensity
    shadow: vec4<f32>,        // x cos(inner), y cos(outer), z first shadow map (-1 = none), w map count
    shadow_reach: vec4<f32>,  // x how far from the eye it shadows (0: no limit)
}

// A virtual shadow map (scene/world/shadow_pages.h, ShadowMapGpu).
pub struct ShadowMap {
    matrix: mat4f,
    info: vec4<f32>,
    bias: vec4<f32>,
    depth: vec4<f32>,
}

pub struct Lighting {
    sun_direction: vec4<f32>,  // the dominant directional light (decals), w its index + 1 (0: none)
    sun_color: vec4<f32>,      // rgb, a intensity
    ambient_color: vec4<f32>,  // rgb flat ambient
    params: vec4<f32>,         // x the light count, y the PCF grid's side, z 1 / the pool's side, w the pool's columns
    shadow_view: vec4<f32>,
    shadow_soft: vec4<f32>,
    lights: array<Light, 32>,
    shadow_maps: array<ShadowMap, 32>,
    probe_world_to_local: mat4f,
    probe_local_to_world: mat4f,
    probe_pos: vec4<f32>,
    probe_box_size: vec4<f32>,
    probe_params: vec4<f32>,
    shade_origin: vec4<f32>,
    shade_params: vec4<f32>,
    ibl_params: vec4<f32>,     // x enabled, y intensity, z rotation, w the prefilter's last LOD
    ground_bounce: vec4<f32>,  // rgb the ground's bounce, as irradiance over pi and intensity (0: none)
    atm: atmosphere::Atmosphere,   // the atmosphere, atm.sun_dir.w on
}

@binding(1, 0) pub var lighting: uniform<Lighting>;
@binding(1, 1) var shadow_pool: texture2d_shadow;
@binding(1, 2) var probe_map: texture_cube<vec4<f32>>;
@binding(1, 3) var shade_map: texture2d<vec4<f32>>;
@binding(1, 4) var irradiance_map: texture_cube<vec4<f32>>;
@binding(1, 5) var prefilter_map: texture_cube<vec4<f32>>;
@binding(1, 6) var brdf_lut: texture2d<vec4<f32>>;
@binding(1, 7) pub var sky_map: texture_cube<vec4<f32>>;
// One sampler for the set's images (linear, clamped).
@binding(1, 8) pub var linear: sampler;
@binding(1, 9) pub var atm_transmittance: texture2d<vec4<f32>>;
@binding(1, 10) pub var atm_sky_view: texture2d<vec4<f32>>;
@binding(1, 11) var atm_inscatter: texture3d<vec4<f32>>;
@binding(1, 12) var atm_air_transmittance: texture3d<vec4<f32>>;
@binding(1, 13) var atm_sky_light: texture3d<vec4<f32>>;
@binding(1, 14) var shadow_table: read_buffer<u32>;
@binding(1, 15) var shadow_overlay: texture2d_shadow;
@binding(1, 16) var shadow_compare: sampler;

pub fn atmosphere_on() -> bool {
    return lighting.atm.sun_dir.w > 0.5;
}

// The sun's light at camera-relative `pos`, for a sun of 1 at the top of the
// air: what the air and the planet's shadow leave of it.
pub fn sun_transmittance(pos: vec3<f32>) -> vec3<f32> {
    let atm = lighting.atm;
    let p = atmosphere::origin(atm, pos);
    let r = length(p);
    return atmosphere::sun_transmittance(atm, atm_transmittance, linear, r, dot(p, atm.sun_dir.xyz) / r);
}

// `d` turned about +Y by `a` radians: the environment's rotation.
pub fn rotate_y(d: vec3<f32>, a: f32) -> vec3<f32> {
    let c = cos(a);
    let s = sin(a);
    return vec3<f32>(c * d.x + s * d.z, d.y, -s * d.x + c * d.z);
}

// The open sky's irradiance over pi on a surface at `pos` facing `n`, as if
// nothing stood about it: the atmosphere's sky light, else the environment's
// irradiance with the ground's bounce below (the light a level ground sends
// back, seen by the lower (1 - n.y) / 2 of the surface's hemisphere), else
// the flat ambient.
pub fn open_sky_irradiance(pos: vec3<f32>, n: vec3<f32>) -> vec3<f32> {
    if (atmosphere_on()) {
        return atmosphere::sh_irradiance(atmosphere::sky_light_sh(lighting.atm, atm_sky_light, linear, pos), n);
    }
    if (lighting.ibl_params.x > 0.5) {
        let e = irradiance_map.sample(linear, rotate_y(n, lighting.ibl_params.z)).xyz;
        return (e + lighting.ground_bounce.xyz * (0.5 - 0.5 * n.y)) * lighting.ibl_params.y;
    }
    return lighting.ambient_color.xyz;
}

// The sun: the atmosphere's while it is on, else the first directional
// light; -1 with neither.
pub fn sun_index() -> i32 {
    if (atmosphere_on()) {
        return lighting.atm.ground.w as i32;
    }
    let count = min(lighting.params.x as i32, MAX_LIGHTS);
    for (var i: i32 = 0; i < count; i += 1) {
        if (lighting.lights[i].position.w < 0.5) {
            return i;
        }
    }
    return -1;
}

// Unit, toward the sun (straight up the view's y with none).
pub fn to_sun() -> vec3<f32> {
    let i = sun_index();
    if (i < 0) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return normalize(-lighting.lights[i].direction.xyz);
}

// The sun's illuminance at camera-relative `pos` (its light's colour times
// intensity): what the air and the planet's shadow leave of it when it is
// the atmosphere's sun. Black without a sun.
pub fn sun_light(pos: vec3<f32>) -> vec3<f32> {
    let i = sun_index();
    if (i < 0) {
        return vec3<f32>(0.0, 0.0, 0.0);
    }
    let c = lighting.lights[i].color;
    if (atmosphere_on() && i == (lighting.atm.ground.w as i32)) {
        return c.xyz * c.w * sun_transmittance(pos);
    }
    return c.xyz * c.w;
}

// Fog in [0, 1] for a point `cam_dist` from the eye at world height
// `world_y`: exponential-squared height fog when the density is set, else
// the linear start / end ramp, else none.
fn fog_factor(cam_dist: f32, world_y: f32) -> f32 {
    var density: f32 = camera.fog_params.z;
    if (density > 0.0) {
        let d = max(cam_dist - camera.fog_params.w, 0.0);
        let falloff = camera.fog_color.w;
        if (falloff > 0.0) {
            density *= exp(-falloff * world_y);
        }
        let x = density * d;
        return 1.0 - exp(-x * x);
    }
    let fog_end = camera.fog_params.y;
    if (fog_end > 0.0) {
        let f = clamp((cam_dist - camera.fog_params.x) / (fog_end - camera.fog_params.x), 0.0, 1.0);
        return f * f;
    }
    return 0.0;
}

// The air between the eye and a point, as what survives of the point's
// colour and what the air adds; `fade` is how far a surface's alpha fades
// out (fog only).
pub struct Air {
    transmittance: vec3<f32>,
    inscatter: vec3<f32>,
    fade: f32,
}

// The air between this view's eye and camera-relative `pos`, from the
// atmosphere's tables. Inside the main camera's frustum: its aerial-
// perspective volume (froxels over the frustum, slices squared in depth, a
// point nearer than the first slice taking the share of it its distance is),
// read across slices by a cubic B-spline (two linear lookups at the pairs'
// weighted centres, Sigg and Hadwiger 2005): linear between slices, a slow
// gradient shows each slice's edge. Outside it, and from high in the air
// where a slice is deeper than the air under the eye (the froxels' share,
// sky_view.w, 1 low in the air and 0 above): the transmittance from the
// transmittance table (the ratio of the two points' to the top) and the
// in-scatter as the sky-view table's radiance along the ray, by the share of
// the ray's air that lies before the point.
fn atmosphere_air(pos: vec3<f32>) -> Air {
    let atm = lighting.atm;
    let e = atm.sun_illuminance.xyz / atmosphere::TABLE_SCALE;   // both tables read here are scaled
    let p = pos + atm.froxel.xyz;   // relative to the froxel camera
    let clip = scene::mul4(atm.froxel_view_proj, vec4<f32>(p, 1.0));
    var ndc: vec2<f32> = vec2<f32>(2.0, 2.0);
    if (clip.w > 0.0) {
        ndc = clip.xy / clip.w;
    }
    var froxels: f32 = atm.sky_view.w;
    var f_t: vec3<f32> = vec3<f32>(1.0, 1.0, 1.0);
    var f_l: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    if (froxels > 0.0 && abs(ndc.x) <= 1.02 && abs(ndc.y) <= 1.02) {
        let wn = atmosphere::froxel_w(atm.froxel.w, length(p));
        let n = atmosphere::FROXEL_SLICES;
        let x = clamp(wn.x, 0.5 / n, 1.0 - 0.5 / n) * n - 0.5;
        let i = floor(x);
        let f = x - i;
        let g = 1.0 - f;
        let f2 = f * f;
        let f3 = f2 * f;
        let bx = g * g * g / 6.0;
        let by = (3.0 * f3 - 6.0 * f2 + 4.0) / 6.0;
        let bz = (-3.0 * f3 + 3.0 * f2 + 3.0 * f + 1.0) / 6.0;
        let bw = f3 / 6.0;
        let g0 = bx + by;
        let g1 = bz + bw;
        let w0 = clamp((i - 1.0 + by / g0 + 0.5) / n, 0.5 / n, 1.0 - 0.5 / n);
        let w1 = clamp((i + 1.0 + bw / g1 + 0.5) / n, 0.5 / n, 1.0 - 0.5 / n);
        let uv = ndc * 0.5 + 0.5;
        let l = atm_inscatter.sample_lod(linear, vec3<f32>(uv, w0), 0.0).xyz * g0 +
                atm_inscatter.sample_lod(linear, vec3<f32>(uv, w1), 0.0).xyz * g1;
        let t = atm_air_transmittance.sample_lod(linear, vec3<f32>(uv, w0), 0.0).xyz * g0 +
                atm_air_transmittance.sample_lod(linear, vec3<f32>(uv, w1), 0.0).xyz * g1;
        f_l = l * wn.y * e;
        f_t = mix(vec3<f32>(1.0, 1.0, 1.0), t, wn.y);
        if (froxels >= 1.0) {
            return Air { transmittance: f_t, inscatter: f_l, fade: 0.0 };
        }
    } else {
        froxels = 0.0;
    }
    let d = length(pos);
    let ro = atmosphere::origin(atm, vec3<f32>(0.0, 0.0, 0.0));
    let rd = pos / max(d, 0.0001);
    let pp = ro + pos;
    let r0 = length(ro);
    let r1 = length(pp);
    let mu0 = dot(ro, rd) / r0;
    let mu1 = dot(pp, rd) / r1;
    let t_ground = atmosphere::ground_hit(atm, ro, rd);
    var t_full: vec3<f32> = vec3<f32>(1.0, 1.0, 1.0);
    var t_ray: vec3<f32> = vec3<f32>(1.0, 1.0, 1.0);
    if (t_ground >= 0.0) {
        // Toward the ground: the reversed ray, from the point back up past
        // the eye (a = T(point..eye) * b); the sky view's ray ends at the
        // ground, so its air is the eye's to there (t_full), not all of it.
        let a = atmosphere::transmittance_to_top(atm, atm_transmittance, linear, r1, -mu1);
        let b = atmosphere::transmittance_to_top(atm, atm_transmittance, linear, r0, -mu0);
        let pg = ro + rd * t_ground;
        let gt = atmosphere::transmittance_to_top(atm, atm_transmittance, linear, atm.shell.x, -dot(pg, rd) / length(pg));
        let bb = max(b, vec3<f32>(0.000001, 0.000001, 0.000001));
        t_ray = clamp(a / bb, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));
        t_full = clamp(gt / bb, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));
    } else {
        let a = atmosphere::transmittance_to_top(atm, atm_transmittance, linear, r0, mu0);
        let b = atmosphere::transmittance_to_top(atm, atm_transmittance, linear, r1, mu1);
        t_ray = clamp(a / max(b, vec3<f32>(0.000001, 0.000001, 0.000001)), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));
        t_full = a;
    }
    let up = ro / r0;
    let sf = atmosphere::sun_frame(atm, up);
    let h = vec2<f32>(dot(rd, sf.axes[0]), dot(rd, sf.axes[1]));
    let hl = length(h);
    let cos_az = hl > 0.00001 ? h.x / hl : 1.0;
    let sky = atm_sky_view.sample_lod(linear, atmosphere::sky_view_uv(atm, atm.sky_view.x, dot(rd, up), cos_az), 0.0).xyz;
    let share = clamp((1.0 - t_ray) / max(1.0 - t_full, vec3<f32>(0.0001, 0.0001, 0.0001)),
                      vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));
    return Air { transmittance: mix(t_ray, f_t, froxels), inscatter: mix(sky * share * e, f_l, froxels), fade: 0.0 };
}

// The air between the eye and a point at camera-relative `pos`, `cam_dist`
// away: the atmosphere's transmittance and in-scatter (aerial perspective,
// integrated with the sky's own model, so distant ground fades into the sky
// behind it) when it is on, else the fog. Aerial perspective supersedes fog;
// both model the same air.
pub fn air(pos: vec3<f32>, cam_dist: f32) -> Air {
    if (atmosphere_on()) {
        return atmosphere_air(pos);
    }
    let fog = fog_factor(cam_dist, pos.y + camera.eye_world.y);
    return Air { transmittance: vec3<f32>(1.0 - fog, 1.0 - fog, 1.0 - fog), inscatter: camera.fog_color.xyz * fog, fade: fog };
}

// ---------------------------------------------------------------------------
// Cached shadow pages (shadow/shadow_pages_layout.h)
// ---------------------------------------------------------------------------

pub const SP_PAGE: i32 = 128;
pub const SP_BORDER: i32 = 4;
pub const SP_STRIDE: i32 = 136;
pub const SP_WINDOW: i32 = 64;
pub const SP_LOCAL: i32 = 8;
pub const SP_LOCAL_MIPS: i32 = 4;
pub const SP_RESIDENT: u32 = 0x80000000u;
pub const SP_PHYSICAL_MASK: u32 = 0xFFFFu;
pub const SP_OVERLAY_BITS: u32 = 12u;
pub const SP_OVERLAY_MASK: u32 = 0xFFFu;
pub const SP_KIND_CLIPMAP: i32 = 0;
pub const SP_KIND_LOCAL: i32 = 1;

pub fn sp_local_mip_first(m: i32) -> i32 {
    if m == 0 { return 0; }
    if m == 1 { return 64; }
    if m == 2 { return 80; }
    return 84;
}

pub fn shadow_clipmap_entry(map: ShadowMap, page: vec2<i32>) -> i32 {
    let ox = map.info.z as i32;
    let oy = map.info.w as i32;
    let sx = (ox + page.x) & (SP_WINDOW - 1);
    let sy = (oy + page.y) & (SP_WINDOW - 1);
    return (map.info.x as i32) + sy * SP_WINDOW + sx;
}

pub fn shadow_local_entry(map: ShadowMap, mip: i32, page: vec2<i32>) -> i32 {
    let n = SP_LOCAL >> mip;
    return (map.info.x as i32) + sp_local_mip_first(mip) + page.y * n + page.x;
}

pub fn shadow_cube_face(to_frag: vec3<f32>) -> i32 {
    let a = abs(to_frag);
    if a.x >= a.y && a.x >= a.z { return select(to_frag.x > 0.0, 0, 1); }
    if a.y >= a.z { return select(to_frag.y > 0.0, 2, 3); }
    return select(to_frag.z > 0.0, 4, 5);
}

struct ShadowHit {
    valid: bool,
    in_page: vec2<f32>,
    page: u32,
    overlay: u32,
    depth: f32,
    z_eye: f32,
    ref_z: f32,
}

fn no_shadow_hit() -> ShadowHit {
    return ShadowHit {
        valid: false,
        in_page: vec2<f32>(0.0, 0.0),
        page: 0u,
        overlay: 0u,
        depth: 0.0,
        z_eye: 1.0,
        ref_z: 0.0,
    };
}

fn shadow_locate(m: i32, mip: i32, pos: vec3<f32>) -> ShadowHit {
    let map = lighting.shadow_maps[m];
    let sc = scene::mul4(map.matrix, vec4<f32>(pos, 1.0));
    if sc.w <= 0.0 { return no_shadow_hit(); }
    let z_eye = sc.w;
    let ndc = sc.xyz / sc.w;
    let clipmap = (map.info.y as i32) == SP_KIND_CLIPMAP;
    let n = select(clipmap, SP_WINDOW, SP_LOCAL >> mip);
    let pc = ndc.xy * (n as f32);
    if pc.x < 0.0 || pc.y < 0.0 || pc.x >= (n as f32) || pc.y >= (n as f32) {
        return no_shadow_hit();
    }
    let p = min(vec2<i32>(floor(pc)), vec2<i32>(n - 1, n - 1));
    let e = select(clipmap, shadow_clipmap_entry(map, p), shadow_local_entry(map, mip, p));
    return ShadowHit {
        valid: true,
        in_page: (pc - vec2<f32>(p)) * (SP_PAGE as f32),
        page: shadow_table[2 * e],
        overlay: shadow_table[2 * e + 1],
        depth: ndc.z,
        z_eye: z_eye,
        ref_z: 0.0,
    };
}

fn shadow_filter_page(first: vec2<f32>, texel: vec2<f32>, inv: f32, ref_z: f32, spread: f32) -> f32 {
    let base = texel * inv;
    let min_uv = (first - (SP_BORDER as f32) + 1.0) * inv;
    let max_uv = (first + ((SP_PAGE + SP_BORDER) as f32) - 1.0) * inv;
    let hk = ((lighting.params.y as i32) - 1) / 2;
    if hk <= 0 || spread == 0.0 {
        return shadow_pool.compare(shadow_compare, clamp(base, min_uv, max_uv), ref_z);
    }
    if spread < 0.0 {
        let o = vec2<f32>(inv * (-spread * 0.5 * (hk as f32)), inv * (-spread * 0.5 * (hk as f32)));
        return 0.25 * (shadow_pool.compare(shadow_compare, clamp(base + vec2<f32>(-o.x, -o.y), min_uv, max_uv), ref_z) +
                       shadow_pool.compare(shadow_compare, clamp(base + vec2<f32>( o.x, -o.y), min_uv, max_uv), ref_z) +
                       shadow_pool.compare(shadow_compare, clamp(base + vec2<f32>(-o.x,  o.y), min_uv, max_uv), ref_z) +
                       shadow_pool.compare(shadow_compare, clamp(base + vec2<f32>( o.x,  o.y), min_uv, max_uv), ref_z));
    }
    var s: f32 = 0.0;
    let step_uv = vec2<f32>(inv * spread, inv * spread);
    for (var y: i32 = -hk; y <= hk; y += 1) {
        for (var x: i32 = -hk; x <= hk; x += 1) {
            let uv = clamp(base + vec2<f32>(x as f32, y as f32) * step_uv, min_uv, max_uv);
            s += shadow_pool.compare(shadow_compare, uv, ref_z);
        }
    }
    let side = (2 * hk + 1) as f32;
    return s / (side * side);
}

fn shadow_filter_overlay(first: vec2<f32>, texel: vec2<f32>, inv: f32, ref_z: f32, spread: f32) -> f32 {
    let base = texel * inv;
    let min_uv = (first - (SP_BORDER as f32) + 1.0) * inv;
    let max_uv = (first + ((SP_PAGE + SP_BORDER) as f32) - 1.0) * inv;
    let hk = ((lighting.params.y as i32) - 1) / 2;
    if hk <= 0 || spread == 0.0 {
        return shadow_overlay.compare(shadow_compare, clamp(base, min_uv, max_uv), ref_z);
    }
    if spread < 0.0 {
        let o = vec2<f32>(inv * (-spread * 0.5 * (hk as f32)), inv * (-spread * 0.5 * (hk as f32)));
        return 0.25 * (shadow_overlay.compare(shadow_compare, clamp(base + vec2<f32>(-o.x, -o.y), min_uv, max_uv), ref_z) +
                       shadow_overlay.compare(shadow_compare, clamp(base + vec2<f32>( o.x, -o.y), min_uv, max_uv), ref_z) +
                       shadow_overlay.compare(shadow_compare, clamp(base + vec2<f32>(-o.x,  o.y), min_uv, max_uv), ref_z) +
                       shadow_overlay.compare(shadow_compare, clamp(base + vec2<f32>( o.x,  o.y), min_uv, max_uv), ref_z));
    }
    var s: f32 = 0.0;
    let step_uv = vec2<f32>(inv * spread, inv * spread);
    for (var y: i32 = -hk; y <= hk; y += 1) {
        for (var x: i32 = -hk; x <= hk; x += 1) {
            let uv = clamp(base + vec2<f32>(x as f32, y as f32) * step_uv, min_uv, max_uv);
            s += shadow_overlay.compare(shadow_compare, uv, ref_z);
        }
    }
    let side = (2 * hk + 1) as f32;
    return s / (side * side);
}

fn shadow_probe(m: i32, mip: i32, texel_w: f32, pos: vec3<f32>, n: vec3<f32>, n_dot_l: f32) -> ShadowHit {
    let map = lighting.shadow_maps[m];
    let sin_t = sqrt(max(1.0 - n_dot_l * n_dot_l, 0.0));
    let n_off = map.bias.y + texel_w * (0.5 + sin_t);
    let b_world = texel_w * (0.3 + 0.5 * sin_t);
    let h = shadow_locate(m, mip, pos + n * n_off);
    if !h.valid { return h; }
    let span = max(map.depth.y - map.depth.x, 0.000001);
    let b01 = select(map.depth.z > 0.5, b_world / span,
                     b_world * map.depth.x * map.depth.y / (span * h.z_eye * h.z_eye));
    let ref_z = min(h.depth - map.bias.x - b01, 1.0);
    return ShadowHit {
        valid: true,
        in_page: h.in_page,
        page: h.page,
        overlay: h.overlay,
        depth: h.depth,
        z_eye: h.z_eye,
        ref_z: ref_z,
    };
}

fn shadow_page_first(hit: ShadowHit) -> vec2<f32> {
    let phys = (hit.page & SP_PHYSICAL_MASK) as f32;
    let row = floor((phys + 0.5) / lighting.params.w);
    return vec2<f32>(phys - row * lighting.params.w, row) * (SP_STRIDE as f32) + (SP_BORDER as f32);
}

fn shadow_page_at(hit: ShadowHit, ref_z: f32, spread: f32) -> f32 {
    let first = shadow_page_first(hit);
    return shadow_filter_page(first, first + hit.in_page, lighting.params.z, ref_z, spread);
}

fn shadow_blocked_at(hit: ShadowHit, ref_z: f32) -> f32 {
    let first = shadow_page_first(hit);
    let inv = lighting.params.z;
    let uv = clamp((first + hit.in_page) * inv, (first - (SP_BORDER as f32) + 1.0) * inv,
                   (first + ((SP_PAGE + SP_BORDER) as f32) - 1.0) * inv);
    return 1.0 - dot(shadow_pool.gather(shadow_compare, uv, ref_z), vec4<f32>(0.25, 0.25, 0.25, 0.25));
}

fn shadow_overlay_at(hit: ShadowHit, ref_z: f32, spread: f32) -> f32 {
    if (hit.overlay & SP_RESIDENT) == 0u { return 1.0; }
    let first = vec2<f32>((hit.overlay & SP_OVERLAY_MASK) as f32,
                          ((hit.overlay >> SP_OVERLAY_BITS) & SP_OVERLAY_MASK) as f32);
    return shadow_filter_overlay(first, first + hit.in_page, 1.0 / (shadow_overlay.size(0).x as f32), ref_z, -abs(spread));
}

struct SunProbe {
    p: vec3<f32>,
    n: vec3<f32>,
    sin_t: f32,
}

fn sun_probe(first: i32, pos: vec3<f32>, n: vec3<f32>, n_dot_l: f32) -> SunProbe {
    let m = lighting.shadow_maps[first].matrix;
    return SunProbe {
        p: scene::mul4(m, vec4<f32>(pos, 1.0)).xyz,
        n: scene::mul4(m, vec4<f32>(n, 0.0)).xyz,
        sin_t: sqrt(max(1.0 - n_dot_l * n_dot_l, 0.0)),
    };
}

fn sun_locate(first: i32, level: i32, sp: SunProbe) -> ShadowHit {
    let map0 = lighting.shadow_maps[first];
    let scale = exp2(-(level as f32));
    let texel_w = map0.bias.z / scale;
    let n_off = map0.bias.y + texel_w * (0.5 + sp.sin_t);
    let b_world = texel_w * (0.3 + 0.5 * sp.sin_t);
    let q = sp.p + sp.n * n_off;
    let map = lighting.shadow_maps[first + level];
    let pc = (q.xy * scale + (map.matrix[3].xy - scale * map0.matrix[3].xy)) * (SP_WINDOW as f32);
    if pc.x < 0.0 || pc.y < 0.0 || pc.x >= (SP_WINDOW as f32) || pc.y >= (SP_WINDOW as f32) {
        return no_shadow_hit();
    }
    let p = min(vec2<i32>(floor(pc)), vec2<i32>(SP_WINDOW - 1, SP_WINDOW - 1));
    let e = shadow_clipmap_entry(map, p);
    let ref_z = min(q.z - map0.bias.x - b_world / max(map0.depth.y - map0.depth.x, 0.000001), 1.0);
    return ShadowHit {
        valid: true,
        in_page: (pc - vec2<f32>(p)) * (SP_PAGE as f32),
        page: shadow_table[2 * e],
        overlay: shadow_table[2 * e + 1],
        depth: q.z,
        z_eye: 1.0,
        ref_z: ref_z,
    };
}

pub fn light_shadow(i: i32, pos: vec3<f32>, cam_dist: f32, light_dist: f32, n: vec3<f32>, n_dot_l: f32, spread: f32) -> f32 {
    let light = lighting.lights[i];
    let first = light.shadow.z as i32;
    if first < 0 { return 1.0; }
    let count = light.shadow.w as i32;
    let footprint = select(lighting.shadow_view.x > 0.0, cam_dist * lighting.shadow_view.x, lighting.shadow_view.y);
    var hit = no_shadow_hit();
    if (light.position.w as i32) == 0 {
        var lf: f32 = log2(max(footprint / lighting.shadow_view.z, 1e-9));
        let sp = sun_probe(first, pos, n, n_dot_l);
        let scale_last = exp2(-((count - 1) as f32));
        let pc_last = (sp.p.xy * scale_last + (lighting.shadow_maps[first + count - 1].matrix[3].xy -
                                                scale_last * lighting.shadow_maps[first].matrix[3].xy)) * (SP_WINDOW as f32);
        if pc_last.x < -1.0 || pc_last.y < -1.0 || pc_last.x > ((SP_WINDOW + 1) as f32) || pc_last.y > ((SP_WINDOW + 1) as f32) {
            return 1.0;
        }
        let search = lighting.shadow_soft.z as i32;
        if search >= 0 && search < count && lf < (search as f32) {
            let sh = sun_locate(first, search, sp);
            if sh.valid && (sh.page & SP_RESIDENT) != 0u {
                hit = sh;
                let map0 = lighting.shadow_maps[first];
                let still = lighting.shadow_soft.y / (lighting.shadow_soft.x * max(map0.depth.y - map0.depth.x, 0.000001));
                let f0 = shadow_blocked_at(hit, hit.ref_z - still);
                if f0 > 0.0 {
                    let lp = log2(lighting.shadow_soft.y / (4.0 * lighting.shadow_view.z)) +
                             shadow_blocked_at(hit, hit.ref_z - 2.0 * still) + shadow_blocked_at(hit, hit.ref_z - 4.0 * still);
                    lf = max(lf, mix(lf, lp, f0));
                }
            }
        }
        let want = clamp(floor(lf) as i32, 0, count - 1);
        var level: i32 = want;
        while level < count {
            let lh = sun_locate(first, level, sp);
            if lh.valid && (lh.page & SP_RESIDENT) != 0u {
                hit = lh;
                break;
            }
            level += 1;
        }
        if level >= count {
            level = want - 1;
            while level >= 0 {
                let lh = sun_locate(first, level, sp);
                if lh.valid && (lh.page & SP_RESIDENT) != 0u {
                    hit = lh;
                    break;
                }
                level -= 1;
            }
            if level < 0 { return 1.0; }
        }
        var s: f32 = shadow_page_at(hit, hit.ref_z, spread * exp2(clamp(lf - (level as f32), 0.0, 1.0)));
        let sway = min(lighting.shadow_view.w as i32, count - 1);
        if s > 0.0 && sway >= 0 {
            if level < sway {
                let sw_hit = sun_locate(first, sway, sp);
                if sw_hit.valid {
                    hit = sw_hit;
                } else {
                    hit = ShadowHit { valid: hit.valid, in_page: hit.in_page, page: hit.page, overlay: 0u, depth: hit.depth, z_eye: hit.z_eye, ref_z: hit.ref_z };
                }
            }
            s *= shadow_overlay_at(hit, hit.ref_z, spread);
        }
        let reach = light.shadow_reach.x;
        if reach > 0.0 {
            s = mix(s, 1.0, smoothstep(0.9 * reach, reach, cam_dist));
        }
        return s;
    }
    let to_frag = pos - light.position.xyz;
    let m = first + select(count == 6, shadow_cube_face(to_frag), 0);
    let texel0 = lighting.shadow_maps[m].bias.w * light_dist;
    var mip: i32 = clamp(floor(log2(max(footprint / max(texel0, 1e-9), 1e-9))) as i32, 0, SP_LOCAL_MIPS - 1);
    while mip < SP_LOCAL_MIPS {
        let ph = shadow_probe(m, mip, texel0 * exp2(mip as f32), pos, n, n_dot_l);
        if ph.valid && (ph.page & SP_RESIDENT) != 0u {
            hit = ph;
            break;
        }
        mip += 1;
    }
    if mip >= SP_LOCAL_MIPS { return 1.0; }
    let s = shadow_page_at(hit, hit.ref_z, spread);
    return select(s > 0.0 && lighting.shadow_view.w >= 0.0, s * shadow_overlay_at(hit, hit.ref_z, spread), s);
}

// ---------------------------------------------------------------------------
// Cook-Torrance PBR + IBL + Probe + Shade Map
// ---------------------------------------------------------------------------

pub struct Surface {
    position: vec3<f32>,
    normal: vec3<f32>,
    view: vec3<f32>,
    cam_dist: f32,
    base_color: vec3<f32>,
    metallic: f32,
    roughness: f32,
    receives_shadow: bool,
    two_sided: bool,
    subsurface: f32,
    translucency: f32,
    sun_visibility: f32,
    sky_visibility: f32,
    sky_normal: vec3<f32>,
    occluder_sun: f32,
    sun_diffuse: f32,
}

fn distribution_ggx(n_dot_h: f32, roughness: f32) -> f32 {
    let a = roughness * roughness;
    let a2 = a * a;
    let denom = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0;
    return a2 / max(scene::PI * denom * denom, 0.0000001);
}

fn geometry_schlick_ggx(n_dot_v: f32, roughness: f32) -> f32 {
    let r = roughness + 1.0;
    let k = (r * r) / 8.0;
    return n_dot_v / (n_dot_v * (1.0 - k) + k);
}

fn geometry_smith(n_dot_v: f32, n_dot_l: f32, roughness: f32) -> f32 {
    return geometry_schlick_ggx(n_dot_v, roughness) * geometry_schlick_ggx(n_dot_l, roughness);
}

fn fresnel_schlick(cos_theta: f32, f0: vec3<f32>) -> vec3<f32> {
    return f0 + (1.0 - f0) * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
}

fn fresnel_schlick_roughness(cos_theta: f32, f0: vec3<f32>, roughness: f32) -> vec3<f32> {
    let r1 = vec3<f32>(1.0 - roughness, 1.0 - roughness, 1.0 - roughness);
    return f0 + (max(r1, f0) - f0) * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
}

fn distance_attenuation(dist: f32, range: f32) -> f32 {
    if range <= 0.0 { return 1.0; }
    let t = dist / range;
    let win = clamp(1.0 - t * t * t * t, 0.0, 1.0);
    return win * win / (dist * dist + 1.0);
}

pub fn multi_bounce(visibility: f32, albedo: vec3<f32>) -> vec3<f32> {
    let a = 2.0404 * albedo - 0.3324;
    let b = -4.7951 * albedo + 0.6417;
    let c = 2.7552 * albedo + 0.6903;
    return max(vec3<f32>(visibility, visibility, visibility), ((visibility * a + b) * visibility + c) * visibility);
}

pub fn specular_occlusion(n_dot_v: f32, visibility: f32, roughness: f32) -> f32 {
    return clamp(pow(n_dot_v + visibility, exp2(-16.0 * roughness - 1.0)) - 1.0 + visibility, 0.0, 1.0);
}

pub fn direct_light(s: Surface) -> vec3<f32> {
    let n = s.normal;
    let v = s.view;
    let n_dot_v = max(dot(n, v), 0.0001);
    let f0 = mix(vec3<f32>(0.04, 0.04, 0.04), s.base_color, s.metallic);
    var lo: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    let sun = select(s.sun_visibility < 1.0, sun_index(), -1);
    let count = min(lighting.params.x as i32, MAX_LIGHTS);
    for (var i: i32 = 0; i < count; i += 1) {
        let light = lighting.lights[i];
        let ltype = light.position.w as i32;
        var l: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
        var atten: f32 = 1.0;
        var light_dist: f32 = 0.0;
        if ltype == 0 {
            l = -light.direction.xyz;
        } else {
            let to_light = light.position.xyz - s.position;
            let d = length(to_light);
            if d < 0.0001 { continue; }
            light_dist = d;
            l = to_light / d;
            atten = distance_attenuation(d, light.direction.w);
            if ltype == 2 {
                let c = dot(-l, light.direction.xyz);
                let t = clamp((c - light.shadow.y) / max(light.shadow.x - light.shadow.y, 0.0001), 0.0, 1.0);
                atten *= t * t * (3.0 - 2.0 * t);
            }
            if atten <= 0.0 { continue; }
        }

        var radiance: vec3<f32> = light.color.xyz * light.color.w * atten;
        if atmosphere_on() && i == (lighting.atm.ground.w as i32) {
            radiance *= sun_transmittance(s.position);
        }
        if i == sun {
            radiance *= s.sun_visibility;
            if s.sun_visibility <= 0.0 { continue; }
        }
        if s.two_sided && s.subsurface > 0.0 && s.translucency <= 0.0 {
            let wrap = max(0.0, dot(-n, l) + s.subsurface) * s.subsurface;
            lo += s.base_color * radiance * wrap * 0.6;
        }
        let leafy = s.translucency > 0.0;
        let nl = dot(n, l);
        var leaf_shadow: f32 = 1.0;
        if leafy && s.receives_shadow {
            let tn = select(nl < 0.0, -n, n);
            let vis = light_shadow(i, s.position, s.cam_dist, light_dist, tn, max(abs(nl), 0.2), -2.0);
            leaf_shadow = 0.1 + 0.9 * vis;
        }
        if leafy {
            let through = smoothstep(-0.3, 0.4, 0.3 - nl);
            let back = pow(max(dot(-v, l), 0.0), 3.0);
            let amount = s.translucency * through * (0.1 + 0.9 * back);
            let tcol = sqrt(max(s.base_color, vec3<f32>(0.0, 0.0, 0.0))) * vec3<f32>(0.75, 0.95, 0.35) * 0.55;
            lo += tcol * radiance * amount * leaf_shadow;
        }

        let n_dot_l = max(nl, 0.0);
        let diff_nl = select(leafy, clamp((nl + 0.3) / 1.3, 0.0, 1.0), n_dot_l);
        if diff_nl <= 0.0 { continue; }
        let h = normalize(v + l);
        let d_term = distribution_ggx(max(dot(n, h), 0.0), s.roughness);
        let g_term = geometry_smith(n_dot_v, n_dot_l, s.roughness);
        let f_term = fresnel_schlick(max(dot(v, h), 0.0), f0);
        let specular = (d_term * g_term * f_term) / max(4.0 * n_dot_v * n_dot_l, 0.0001);
        let diffuse = (vec3<f32>(1.0, 1.0, 1.0) - f_term) * (1.0 - s.metallic) * s.base_color / scene::PI;

        var shadow: f32 = 1.0;
        if leafy {
            shadow = leaf_shadow;
        } else if s.receives_shadow {
            shadow = light_shadow(i, s.position, s.cam_dist, light_dist, n, n_dot_l, 1.0);
        }
        lo += shadow * (diffuse * diff_nl + specular * n_dot_l) * radiance;
    }
    return lo;
}

fn probe_radiance(pos: vec3<f32>, r: vec3<f32>, rough: f32) -> vec4<f32> {
    let lp = scene::mul4(lighting.probe_world_to_local, vec4<f32>(pos, 1.0)).xyz;
    let edge_dist = (vec3<f32>(0.5, 0.5, 0.5) - abs(lp)) * lighting.probe_box_size.xyz;
    let dmin = min(min(edge_dist.x, edge_dist.y), edge_dist.z);
    let blend_dist = lighting.probe_params.y;
    let w = select(blend_dist > 0.0, clamp(dmin / blend_dist, 0.0, 1.0), step(0.0, dmin));
    var dir: vec3<f32> = r;
    if lighting.probe_box_size.w > 0.5 {
        let w2l = lighting.probe_world_to_local;
        var ld: vec3<f32> = w2l[0].xyz * r.x + w2l[1].xyz * r.y + w2l[2].xyz * r.z;
        ld = vec3<f32>(select(abs(ld.x) < 1e-6, 1e-6, ld.x),
                       select(abs(ld.y) < 1e-6, 1e-6, ld.y),
                       select(abs(ld.z) < 1e-6, 1e-6, ld.z));
        let inv_d = 1.0 / ld;
        let tm = max((vec3<f32>(-0.5, -0.5, -0.5) - lp) * inv_d, (vec3<f32>(0.5, 0.5, 0.5) - lp) * inv_d);
        let t_hit = min(min(tm.x, tm.y), tm.z);
        let hit = scene::mul4(lighting.probe_local_to_world, vec4<f32>(lp + ld * t_hit, 1.0)).xyz;
        let d2 = hit - lighting.probe_pos.xyz;
        if dot(d2, d2) > 1e-8 { dir = d2; }
    }
    let rad = probe_map.sample_lod(linear, dir, rough * lighting.probe_params.z).xyz;
    return vec4<f32>(rad, w);
}

pub fn sky_along(dir: vec3<f32>) -> vec3<f32> {
    let atm = lighting.atm;
    let ro = atmosphere::origin(atm, vec3<f32>(0.0, 0.0, 0.0));
    let up = normalize(ro);
    let sf = atmosphere::sun_frame(atm, up);
    let h = vec2<f32>(dot(dir, sf.axes[0]), dot(dir, sf.axes[1]));
    let hl = length(h);
    let cos_az = select(hl > 0.00001, h.x / hl, 1.0);
    let uv = atmosphere::sky_view_uv(atm, atm.sky_view.x, dot(dir, up), cos_az);
    return atm_sky_view.sample_lod(linear, uv, 0.0).xyz * (atm.sun_illuminance.xyz / atmosphere::TABLE_SCALE);
}

pub fn ambient(s: Surface) -> vec3<f32> {
    let min_nv = select(s.translucency > 0.0, 0.6, 0.0001);
    let n_dot_v = max(dot(s.normal, s.view), min_nv);
    let f0 = mix(vec3<f32>(0.04, 0.04, 0.04), s.base_color, s.metallic);
    let f = fresnel_schlick_roughness(n_dot_v, f0, s.roughness);
    let r = reflect(-s.view, s.normal);
    let brdf = brdf_lut.sample(linear, vec2<f32>(n_dot_v, s.roughness)).xy;

    var probe_w: f32 = 0.0;
    var probe_spec: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    if lighting.probe_pos.w > 0.5 {
        let raw = probe_radiance(s.position, r, s.roughness);
        probe_w = raw.w;
        probe_spec = raw.xyz * (f * brdf.x + brdf.y) * lighting.probe_params.x;
    }
    var kd: vec3<f32> = (1.0 - f) * (1.0 - s.metallic);
    let kd_open = kd;
    let ni = s.sky_normal;
    var diffuse_occ: vec3<f32> = vec3<f32>(1.0, 1.0, 1.0);
    var specular_occ: f32 = 1.0;
    var bounce: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    if s.sky_visibility < 1.0 {
        diffuse_occ = multi_bounce(s.sky_visibility, s.base_color);
        specular_occ = specular_occlusion(n_dot_v, s.sky_visibility, s.roughness);
        kd *= diffuse_occ;
        probe_spec *= specular_occ;
        let sun = sun_index();
        if sun >= 0 && s.occluder_sun > 0.0 {
            var e: vec3<f32> = lighting.lights[sun].color.xyz * lighting.lights[sun].color.w;
            if atmosphere_on() && sun == (lighting.atm.ground.w as i32) {
                e *= sun_transmittance(s.position);
            }
            let up = select(atmosphere_on(), normalize(atmosphere::origin(lighting.atm, s.position)), vec3<f32>(0.0, 1.0, 0.0));
            let mu = max(dot(up, to_sun()), 0.0);
            bounce = (1.0 - s.sky_visibility) * s.occluder_sun * mu / 3.14159265 * s.base_color * e;
        }
    }
    var glow: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    if s.sun_diffuse > 0.0 {
        let sun = sun_index();
        if sun >= 0 {
            var e: vec3<f32> = lighting.lights[sun].color.xyz * lighting.lights[sun].color.w;
            if atmosphere_on() && sun == (lighting.atm.ground.w as i32) {
                e *= sun_transmittance(s.position);
            }
            let up = select(atmosphere_on(), normalize(atmosphere::origin(lighting.atm, s.position)), vec3<f32>(0.0, 1.0, 0.0));
            let mu = max(dot(up, to_sun()), 0.0);
            glow = e * (mu * s.sun_diffuse * 0.5 * (1.0 + dot(ni, up)) / 3.14159265);
        }
    }
    if atmosphere_on() {
        let sh = atmosphere::sky_light_sh(lighting.atm, atm_sky_light, linear, s.position);
        let irradiance = atmosphere::sh_irradiance(sh, ni) + glow;
        var sky: vec3<f32> = atmosphere::sh_radiance(sh, r);
        let sharp = (1.0 - smoothstep(0.12, 0.4, s.roughness)) * lighting.atm.sky_view.w;
        if sharp > 0.0 {
            sky = mix(sky, sky_along(r), sharp);
        }
        let specular = sky * (f * brdf.x + brdf.y) * specular_occ;
        return (kd * irradiance + kd_open * bounce) * s.base_color + mix(specular, probe_spec, probe_w);
    }
    if lighting.ibl_params.x > 0.5 {
        let rotation = lighting.ibl_params.z;
        let intensity = lighting.ibl_params.y;
        let irradiance = open_sky_irradiance(s.position, ni) + glow;
        let prefiltered = prefilter_map.sample_lod(linear, rotate_y(r, rotation), s.roughness * lighting.ibl_params.w).xyz;
        let specular = prefiltered * (f * brdf.x + brdf.y) * intensity * specular_occ;
        return (kd * irradiance + kd_open * bounce) * s.base_color + mix(specular, probe_spec, probe_w);
    }
    return ((lighting.ambient_color.xyz + glow) * diffuse_occ + bounce) * s.base_color * (1.0 - s.metallic) + probe_spec * probe_w;
}

pub fn cell_shade(pos: vec3<f32>, geom_normal: vec3<f32>) -> f32 {
    let r_cell = max(lighting.shade_params.x, 0.000001);
    let nudged = pos - geom_normal * (0.05 * r_cell);
    let p = nudged.xz - lighting.shade_origin.xz;
    var cx: i32 = 0;
    var cy: i32 = 0;
    if lighting.shade_params.y > 0.5 {
        let r = p.y / (1.5 * r_cell);
        let q = p.x / (1.7320508 * r_cell) - r * 0.5;
        let x = q;
        let z = r;
        let y = -x - z;
        var rx: f32 = floor(x + 0.5);
        var ry: f32 = floor(y + 0.5);
        var rz: f32 = floor(z + 0.5);
        let dx = abs(rx - x);
        let dy = abs(ry - y);
        let dz = abs(rz - z);
        if dx > dy && dx > dz {
            rx = -ry - rz;
        } else if dy > dz {
            ry = -rx - rz;
        } else {
            rz = -rx - ry;
        }
        let hq = rx as i32;
        let hr = rz as i32;
        cy = hr;
        cx = hq + (hr - (hr & 1)) / 2;
    } else {
        cx = floor(p.x / r_cell) as i32;
        cy = floor(p.y / r_cell) as i32;
    }
    if cx < 0 || cy < 0 || cx >= (lighting.shade_params.z as i32) || cy >= (lighting.shade_params.w as i32) {
        return 1.0;
    }
    return shade_map.fetch(vec2<i32>(cx, cy), 0).x;
}
