// Sparse Voxel DAG traversal, carving queries, and pixel-cone LOD filtering.
// All GPU storage buffers are passed explicitly as generic parameters so this
// module introduces no descriptor set bindings of its own and can be imported
// alongside both PassVoxelDag (set 2) and custom mesh/tile hooks (set 4).
module voxeldag;

pub const DAG_INVALID: u32 = 0xFFFFFFFFu;
pub const DAG_ANIM_BIT: u32 = 0x80000000u;

pub const DAG_FLAG_UNIFORM_CARVE: u32 = 1u;
pub const DAG_FLAG_EMISSIVE: u32 = 2u;

pub const DAG_BRICK_UNIFORM_ATTR: u32 = 1u;
pub const DAG_BRICK_UNIFORM_CARVE: u32 = 2u;

pub const REGION_ENABLED: u32 = 1u;
pub const REGION_HAS_CARVE: u32 = 2u;
pub const REGION_CAST_SHADOW: u32 = 4u;
pub const REGION_FOLIAGE: u32 = 8u;

// vec4s a region takes in the regions buffer (GpuVoxelRegion): [6] the
// plant it sways as (its root in the region's [0, 1]^3, height m), [7] its
// trunk word (0: still) and scale.
pub const REGION_STRIDE: u32 = 8u;

// Fixed-point bits a region's [0, 1) axis is walked with: 16 node levels
// and a 4^3 brick's 2, with room under f32's 24-bit mantissa.
const PATH_BITS: u32 = 22u;
const PATH_SCALE: f32 = 4194304.0;

// A region's content bounds in its [0, 1]^3 (min > max: empty), from the
// unorm16 pairs in its sixth vec4.
pub struct ContentBox {
    lo: vec3<f32>,
    hi: vec3<f32>,
}

pub fn content_box(r5: vec4<f32>) -> ContentBox {
    let a = bitcast<u32>(r5.x);
    let b = bitcast<u32>(r5.y);
    let c = bitcast<u32>(r5.z);
    let k = 1.0 / 65535.0;
    return ContentBox {
        lo: vec3<f32>((a & 0xFFFFu) as f32, (a >> 16u) as f32, (b & 0xFFFFu) as f32) * k,
        hi: vec3<f32>((b >> 16u) as f32, (c & 0xFFFFu) as f32, (c >> 16u) as f32) * k,
    };
}

fn in_content(u: vec3<f32>, cb: ContentBox) -> bool {
    return u.x >= cb.lo.x && u.y >= cb.lo.y && u.z >= cb.lo.z &&
           u.x <= cb.hi.x && u.y <= cb.hi.y && u.z <= cb.hi.z;
}

pub struct TraceHit {
    hit: bool,
    t: f32,
    pos: vec3<f32>,
    normal: vec3<f32>,
    color: vec3<f32>,
    roughness: f32,
    emissive: f32,
    voxel_size: f32,
    // The opacity of what was hit: a voxel's alpha, or under 1 where the ray
    // ended in coarse cells it saw partly through.
    opacity: f32,
}

// A voxel's own number in [0, 1), from its cell in a region and the region.
fn voxel_hash01(x: u32, y: u32, z: u32, s: u32) -> f32 {
    var h: u32 = (x * 0x8da6b343u) ^ (y * 0xd8163841u) ^ (z * 0xcb1ab31fu) ^ (s * 0x165667b1u);
    h ^= h >> 15u;
    h *= 0x2c1b3c6du;
    h ^= h >> 12u;
    h *= 0x297a2d39u;
    h ^= h >> 15u;
    return ((h >> 8u) as f32) * (1.0 / 16777216.0);
}

pub fn no_hit() -> TraceHit {
    return TraceHit {
        hit: false,
        t: 1e30,
        pos: vec3<f32>(0.0, 0.0, 0.0),
        normal: vec3<f32>(0.0, 1.0, 0.0),
        color: vec3<f32>(0.0, 0.0, 0.0),
        roughness: 0.8,
        emissive: 0.0,
        voxel_size: 1.0,
        opacity: 1.0,
    };
}

pub fn popcount32(v0: u32) -> u32 {
    var v: u32 = v0 - ((v0 >> 1u) & 0x55555555u);
    v = (v & 0x33333333u) + ((v >> 2u) & 0x33333333u);
    return (((v + (v >> 4u)) & 0x0F0F0F0Fu) * 0x01010101u) >> 24u;
}

pub fn popcount_below32(mask: u32, bit: u32) -> u32 {
    if (bit == 0u) {
        return 0u;
    }
    if (bit >= 32u) {
        return popcount32(mask);
    }
    return popcount32(mask & ((1u << bit) - 1u));
}

pub fn popcount64_below(lo: u32, hi: u32, bit: u32) -> u32 {
    if (bit == 0u) {
        return 0u;
    }
    if (bit < 32u) {
        return popcount32(lo & ((1u << bit) - 1u));
    }
    if (bit == 32u) {
        return popcount32(lo);
    }
    if (bit >= 64u) {
        return popcount32(lo) + popcount32(hi);
    }
    return popcount32(lo) + popcount32(hi & ((1u << (bit - 32u)) - 1u));
}

pub fn bit64_set(lo: u32, hi: u32, bit: u32) -> bool {
    if (bit < 32u) {
        return ((lo >> bit) & 1u) != 0u;
    }
    return ((hi >> (bit - 32u)) & 1u) != 0u;
}

pub fn unpack_rgba8(p: u32) -> vec4<f32> {
    let inv = 1.0 / 255.0;
    return vec4<f32>(
        ((p) & 0xFFu) as f32 * inv,
        ((p >> 8u) & 0xFFu) as f32 * inv,
        ((p >> 16u) & 0xFFu) as f32 * inv,
        ((p >> 24u) & 0xFFu) as f32 * inv
    );
}

fn sign_nz(v: f32) -> f32 {
    return v >= 0.0 ? 1.0 : -1.0;
}

fn safe_normalize(v: vec3<f32>, fallback: vec3<f32>) -> vec3<f32> {
    let len2 = dot(v, v);
    let len = max(sqrt(max(len2, 1e-12)), 1e-6);
    let inv_len = 1.0 / len;
    return len2 > 1e-12 ? v * inv_len : fallback;
}

fn safe_inv_dir(d: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(
        sign_nz(d.x) / max(abs(d.x), 1e-6),
        sign_nz(d.y) / max(abs(d.y), 1e-6),
        sign_nz(d.z) / max(abs(d.z), 1e-6)
    );
}

pub fn unpack_oct_normal(p: u32) -> vec3<f32> {
    let fx = (((p) & 0xFFu) as f32 / 255.0) * 2.0 - 1.0;
    let fy = (((p >> 8u) & 0xFFu) as f32 / 255.0) * 2.0 - 1.0;
    let fz = 1.0 - abs(fx) - abs(fy);
    var rx: f32 = fx;
    var ry: f32 = fy;
    if (fz < 0.0) {
        rx = (1.0 - abs(fy)) * sign_nz(fx);
        ry = (1.0 - abs(fx)) * sign_nz(fy);
    }
    return safe_normalize(vec3<f32>(rx, ry, fz), vec3<f32>(0.0, 1.0, 0.0));
}

pub fn unpack_roughness(p: u32) -> f32 {
    return ((p >> 16u) & 0xFFu) as f32 / 255.0;
}

pub fn unpack_emissive(p: u32) -> f32 {
    return ((p >> 24u) & 0xFFu) as f32 / 255.0;
}

pub fn resolve_child<BClip, BF>(raw_ref: u32, tick: u32, clips: BClip, frames: BF) -> u32 {
    if ((raw_ref & DAG_ANIM_BIT) == 0u) {
        return raw_ref;
    }
    let clip_idx = (raw_ref >> 16u) & 0x7FFFu;
    let phase = raw_ref & 0xFFFFu;
    let clip = clips[clip_idx as i32];
    if (clip.y == 0u) {
        return DAG_INVALID;
    }
    let fidx = clip.x + ((tick + phase) % max(clip.y, 1u));
    return frames[fidx as i32];
}

// Static point query against all active regions carrying subtractive Carve masks
// using only 4 storage buffers (omitting animation clip/frame buffers).
pub fn is_carved_static_at<BReg, BN, BC, BB>(
    world_pos: vec3<f32>,
    region_count: u32,
    regions: BReg,
    nodes: BN,
    children: BC,
    bricks: BB
) -> bool {
    var ri: u32 = 0u;
    while (ri < region_count) {
        let base = (ri * REGION_STRIDE) as i32;
        let r0 = regions[base];
        let r4 = regions[base + 4];
        let flags = bitcast<u32>(r4.z);
        let root = bitcast<u32>(r4.x);
        if ((flags & (REGION_ENABLED | REGION_HAS_CARVE)) != (REGION_ENABLED | REGION_HAS_CARVE) ||
            root == DAG_INVALID || r0.w <= 0.0) {
            ri += 1u;
            continue;
        }
        let r1 = regions[base + 1];
        let r2 = regions[base + 2];
        let r3 = regions[base + 3];
        let rel = world_pos - r0.xyz;
        let inv_ext = 1.0 / max(r0.w, 1e-6);
        let u = vec3<f32>(dot(rel, r1.xyz), dot(rel, r2.xyz), dot(rel, r3.xyz)) * inv_ext;
        if (u.x < 0.0 || u.x >= 1.0 || u.y < 0.0 || u.y >= 1.0 || u.z < 0.0 || u.z >= 1.0 ||
            !in_content(u, content_box(regions[base + 5]))) {
            ri += 1u;
            continue;
        }

        var p: vec3<f32> = u;
        var cur: u32 = root;
        var lvl: u32 = 0u;
        while (lvl < 16u) {
            let n = nodes[cur as i32];
            let masks = n.x;
            let node_flags = (masks >> 24u) & 0xFFu;
            if ((node_flags & DAG_FLAG_UNIFORM_CARVE) != 0u) {
                return true;
            }
            let carve_mask = (masks >> 8u) & 0xFFu;
            if (carve_mask == 0u) {
                break;
            }
            let sp = p * 2.0;
            let ox = sp.x >= 1.0 ? 1u : 0u;
            let oy = sp.y >= 1.0 ? 1u : 0u;
            let oz = sp.z >= 1.0 ? 1u : 0u;
            let oct = ox | (oy << 1u) | (oz << 2u);
            let bit = 1u << oct;
            if ((carve_mask & bit) == 0u) {
                break;
            }

            let valid_mask = (masks & 0xFFu) | carve_mask;
            let slot = popcount_below32(valid_mask, oct);
            let raw_ref = children[(n.y + slot) as i32];
            if ((raw_ref & DAG_ANIM_BIT) != 0u || raw_ref == DAG_INVALID) {
                break;
            }

            let child_p = vec3<f32>(
                sp.x - (ox as f32),
                sp.y - (oy as f32),
                sp.z - (oz as f32)
            );
            let leaf_mask = (masks >> 16u) & 0xFFu;
            if ((leaf_mask & bit) != 0u) {
                let b0 = bricks[(raw_ref * 2u) as i32];
                let b1 = bricks[(raw_ref * 2u + 1u) as i32];
                if ((b1.w & DAG_BRICK_UNIFORM_CARVE) != 0u) {
                    return true;
                }
                let bp = clamp(floor(child_p * 4.0), vec3<f32>(0.0), vec3<f32>(3.0));
                let bidx = (bp.x as u32) + ((bp.y as u32) << 2u) + ((bp.z as u32) << 4u);
                if (bit64_set(b0.z, b0.w, bidx)) {
                    return true;
                }
                break;
            }
            cur = raw_ref;
            p = child_p;
            lvl += 1u;
        }
        ri += 1u;
    }
    return false;
}

// Point query against all active regions carrying subtractive Carve masks.
// Safe to call directly from terrain / tile fragment hooks (`discard_fragment`).
pub fn is_carved_at<BReg, BN, BC, BB, BClip, BF>(
    world_pos: vec3<f32>,
    region_count: u32,
    anim_tick: u32,
    regions: BReg,
    nodes: BN,
    children: BC,
    bricks: BB,
    clips: BClip,
    frames: BF
) -> bool {
    var ri: u32 = 0u;
    while (ri < region_count) {
        let base = (ri * REGION_STRIDE) as i32;
        let r0 = regions[base];
        let r4 = regions[base + 4];
        let flags = bitcast<u32>(r4.z);
        let root = bitcast<u32>(r4.x);
        if ((flags & (REGION_ENABLED | REGION_HAS_CARVE)) != (REGION_ENABLED | REGION_HAS_CARVE) ||
            root == DAG_INVALID || r0.w <= 0.0) {
            ri += 1u;
            continue;
        }
        let r1 = regions[base + 1];
        let r2 = regions[base + 2];
        let r3 = regions[base + 3];
        let tick_off = bitcast<u32>(r4.w);
        let rel = world_pos - r0.xyz;
        let inv_ext = 1.0 / max(r0.w, 1e-6);
        let u = vec3<f32>(dot(rel, r1.xyz), dot(rel, r2.xyz), dot(rel, r3.xyz)) * inv_ext;
        if (u.x < 0.0 || u.x >= 1.0 || u.y < 0.0 || u.y >= 1.0 || u.z < 0.0 || u.z >= 1.0 ||
            !in_content(u, content_box(regions[base + 5]))) {
            ri += 1u;
            continue;
        }

        let eff_tick = anim_tick + tick_off;
        var p: vec3<f32> = u;
        var cur: u32 = root;
        var lvl: u32 = 0u;
        while (lvl < 16u) {
            let n = nodes[cur as i32];
            let masks = n.x;
            let node_flags = (masks >> 24u) & 0xFFu;
            if ((node_flags & DAG_FLAG_UNIFORM_CARVE) != 0u) {
                return true;
            }
            let carve_mask = (masks >> 8u) & 0xFFu;
            if (carve_mask == 0u) {
                break;
            }
            let sp = p * 2.0;
            let ox = sp.x >= 1.0 ? 1u : 0u;
            let oy = sp.y >= 1.0 ? 1u : 0u;
            let oz = sp.z >= 1.0 ? 1u : 0u;
            let oct = ox | (oy << 1u) | (oz << 2u);
            let bit = 1u << oct;
            if ((carve_mask & bit) == 0u) {
                break;
            }

            let valid_mask = (masks & 0xFFu) | carve_mask;
            let slot = popcount_below32(valid_mask, oct);
            let raw_ref = children[(n.y + slot) as i32];
            let resolved = resolve_child(raw_ref, eff_tick, clips, frames);
            if (resolved == DAG_INVALID) {
                break;
            }

            let child_p = vec3<f32>(
                sp.x - (ox as f32),
                sp.y - (oy as f32),
                sp.z - (oz as f32)
            );
            let leaf_mask = (masks >> 16u) & 0xFFu;
            if ((leaf_mask & bit) != 0u) {
                let b0 = bricks[(resolved * 2u) as i32];
                let b1 = bricks[(resolved * 2u + 1u) as i32];
                if ((b1.w & DAG_BRICK_UNIFORM_CARVE) != 0u) {
                    return true;
                }
                let bp = clamp(floor(child_p * 4.0), vec3<f32>(0.0), vec3<f32>(3.0));
                let bidx = (bp.x as u32) + ((bp.y as u32) << 2u) + ((bp.z as u32) << 4u);
                if (bit64_set(b0.z, b0.w, bidx)) {
                    return true;
                }
                break;
            }
            cur = resolved;
            p = child_p;
            lvl += 1u;
        }
        ri += 1u;
    }
    return false;
}

fn box_exit_t(
    ro_n: vec3<f32>,
    rd_sx: f32,
    rd_sy: f32,
    rd_sz: f32,
    inv_d: vec3<f32>,
    bmin: vec3<f32>,
    bmax: vec3<f32>
) -> f32 {
    let ex = ((rd_sx > 0.0 ? bmax.x : bmin.x) - ro_n.x) * inv_d.x;
    let ey = ((rd_sy > 0.0 ? bmax.y : bmin.y) - ro_n.y) * inv_d.y;
    let ez = ((rd_sz > 0.0 ? bmax.z : bmin.z) - ro_n.z) * inv_d.z;
    return min(min(ex, ey), ez);
}

fn box_entry_normal(
    ro_n: vec3<f32>,
    rd_sx: f32,
    rd_sy: f32,
    rd_sz: f32,
    inv_d: vec3<f32>,
    bmin: vec3<f32>,
    bmax: vec3<f32>
) -> vec3<f32> {
    let tx = ((rd_sx > 0.0 ? bmin.x : bmax.x) - ro_n.x) * inv_d.x;
    let ty = ((rd_sy > 0.0 ? bmin.y : bmax.y) - ro_n.y) * inv_d.y;
    let tz = ((rd_sz > 0.0 ? bmin.z : bmax.z) - ro_n.z) * inv_d.z;
    if (tx >= ty && tx >= tz) {
        return vec3<f32>(rd_sx > 0.0 ? -1.0 : 1.0, 0.0, 0.0);
    }
    if (ty >= tz) {
        return vec3<f32>(0.0, rd_sy > 0.0 ? -1.0 : 1.0, 0.0);
    }
    return vec3<f32>(0.0, 0.0, rd_sz > 0.0 ? -1.0 : 1.0);
}

// Hierarchical raymarch of one mounted region with continuous cone-filtered LOD,
// dithered min/max distance transitions, empty/carve octant skipping, O(1) cyclic animation lookup, and 4x4x4 leaf DDA.
// `bend` leans the region: a point at height y (the region's [0, 1]^3) is
// drawn bend.xyz * (y - bend.w) away, in those units (0: as stored).
pub fn trace_region_dithered<BReg, BN, BC, BB, BA, BClip, BF>(
    ro: vec3<f32>,
    rd: vec3<f32>,
    t_max_world: f32,
    pixel_cone: f32,
    lod_scale: f32,
    max_steps: u32,
    anim_tick: u32,
    ri: u32,
    dither_u: f32,
    bend: vec4<f32>,
    regions: BReg,
    nodes: BN,
    children: BC,
    bricks: BB,
    attrs: BA,
    clips: BClip,
    frames: BF
) -> TraceHit {
    return trace_region_core(
        ro, rd, t_max_world, pixel_cone, lod_scale, 0.0, true, max_steps, anim_tick, ri, dither_u, 0u, bend,
        regions, nodes, children, bricks, attrs, clips, frames
    );
}

// A region's content along a ray from the light, as a shadow map sees it:
// the camera's distance bands do not apply (what is drawn far off still
// shadows what is near), and a cell `lod_world` metres or smaller (the
// map's texel) ends the ray. `texel_seed` (the texel's own number) makes
// which partly opaque voxels stop the ray differ texel to texel, so a voxel
// of opacity a shadows a of its texels and the map's filter softens it.
pub fn trace_region_caster<BReg, BN, BC, BB, BA, BClip, BF>(
    ro: vec3<f32>,
    rd: vec3<f32>,
    t_max_world: f32,
    lod_world: f32,
    max_steps: u32,
    anim_tick: u32,
    ri: u32,
    texel_seed: u32,
    regions: BReg,
    nodes: BN,
    children: BC,
    bricks: BB,
    attrs: BA,
    clips: BClip,
    frames: BF
) -> TraceHit {
    return trace_region_core(
        ro, rd, t_max_world, 0.0, 1.0, lod_world, false, max_steps, anim_tick, ri, 0.5, texel_seed,
        vec4<f32>(0.0, 0.0, 0.0, 0.0), regions, nodes, children, bricks, attrs, clips, frames
    );
}

fn trace_region_core<BReg, BN, BC, BB, BA, BClip, BF>(
    ro: vec3<f32>,
    rd: vec3<f32>,
    t_max_world: f32,
    pixel_cone: f32,
    lod_scale: f32,
    lod_world: f32,
    banded: bool,
    max_steps: u32,
    anim_tick: u32,
    ri: u32,
    dither_u: f32,
    hash_seed: u32,
    bend: vec4<f32>,
    regions: BReg,
    nodes: BN,
    children: BC,
    bricks: BB,
    attrs: BA,
    clips: BClip,
    frames: BF
) -> TraceHit {
    let base = (ri * REGION_STRIDE) as i32;
    let r0 = regions[base];
    let r4 = regions[base + 4];
    let flags = bitcast<u32>(r4.z);
    let root = bitcast<u32>(r4.x);
    let extent = r0.w;
    if ((flags & REGION_ENABLED) == 0u || root == DAG_INVALID || extent <= 0.0) {
        return no_hit();
    }

    let r1 = regions[base + 1];
    let r2 = regions[base + 2];
    let r3 = regions[base + 3];
    let max_dist = r2.w;
    let fade_start = r3.w;
    let min_dist = (bitcast<u32>(r4.y) >> 5u) as f32;
    let min_fade_end = regions[base + 5].w;
    let u_d = clamp(dither_u, 0.0, 1.0);
    let eff_tick = anim_tick + bitcast<u32>(r4.w);

    let rel = ro - r0.xyz;
    let inv_ext = 1.0 / max(extent, 1e-6);
    let ro_b = vec3<f32>(dot(rel, r1.xyz), dot(rel, r2.xyz), dot(rel, r3.xyz)) * inv_ext;
    let rd_b = vec3<f32>(dot(rd, r1.xyz), dot(rd, r2.xyz), dot(rd, r3.xyz));
    // The ray leant back by the region's bend, an affine map: it stays
    // straight, and t along it is t along the drawn ray.
    let ro_n = ro_b - bend.xyz * (ro_b.y - bend.w);
    let rd_n = rd_b - bend.xyz * rd_b.y;
    let rd_sx = rd_n.x >= 0.0 ? max(rd_n.x, 1e-6) : min(rd_n.x, -1e-6);
    let rd_sy = rd_n.y >= 0.0 ? max(rd_n.y, 1e-6) : min(rd_n.y, -1e-6);
    let rd_sz = rd_n.z >= 0.0 ? max(rd_n.z, 1e-6) : min(rd_n.z, -1e-6);
    let inv_d = safe_inv_dir(rd_n);

    // Entry and exit of the content bounds, not the whole box: the sky over
    // a region's forest is never marched.
    let cb = content_box(regions[base + 5]);
    if (cb.lo.x > cb.hi.x || cb.lo.y > cb.hi.y || cb.lo.z > cb.hi.z) {
        return no_hit();
    }
    let t0 = (cb.lo - ro_n) * inv_d;
    let t1 = (cb.hi - ro_n) * inv_d;
    let tsmall = min(t0, t1);
    let tbig = max(t0, t1);
    var t_enter: f32 = max(max(tsmall.x, tsmall.y), max(tsmall.z, 0.0));
    if (banded && min_dist > 0.0) {
        let eff_min = mix(min_dist, min_fade_end, u_d);
        t_enter = max(t_enter, eff_min * inv_ext);
    }
    var t_cap: f32 = t_max_world * inv_ext;
    if (banded && max_dist > 0.0) {
        let eff_max = (fade_start > 0.0 && fade_start < max_dist)
            ? mix(fade_start, max_dist, u_d)
            : max_dist;
        t_cap = min(t_cap, eff_max * inv_ext);
    }
    let t_exit = min(min(min(tbig.x, tbig.y), tbig.z), t_cap);
    if (t_enter >= t_exit) {
        return no_hit();
    }

    let cone_k = max(pixel_cone * lod_scale, 0.0);
    let lod_n = max(lod_world, 0.0) * inv_ext;
    var t: f32 = t_enter + max(1e-6, t_enter * 2e-5);
    var accum_rgb: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    var accum_n: vec3<f32> = vec3<f32>(0.0, 0.0, 0.0);
    var accum_a: f32 = 0.0;
    var accum_rough: f32 = 0.0;
    var accum_emis: f32 = 0.0;
    var accum_op: f32 = 0.0;
    var first_t: f32 = 1e30;
    var first_vox: f32 = r1.w;

    // The path from the root to where the ray is, one node a level: a step
    // resumes from the deepest cell still holding the new point, not the root.
    // Cells are read off the point's fixed-point coordinates (PATH_BITS a
    // axis), so a level's cell is its coordinates' top bits.
    var path: array<u32, 17>;
    path[0] = root;
    var lvl: u32 = 0u;
    var pix: u32 = 0u;
    var piy: u32 = 0u;
    var piz: u32 = 0u;

    var step: u32 = 0u;
    while (step < max_steps && t < t_exit) {
        let p = clamp(ro_n + rd_n * t, vec3<f32>(0.0), vec3<f32>(0.999999));
        let ix = (p.x * PATH_SCALE) as u32;
        let iy = (p.y * PATH_SCALE) as u32;
        let iz = (p.z * PATH_SCALE) as u32;
        while (lvl > 0u) {
            let sh = PATH_BITS - lvl;
            if ((ix >> sh) == (pix >> sh) && (iy >> sh) == (piy >> sh) && (iz >> sh) == (piz >> sh)) {
                break;
            }
            lvl -= 1u;
        }
        pix = ix;
        piy = iy;
        piz = iz;
        var cur: u32 = path[lvl];

        while (lvl < 16u) {
            let n = nodes[cur as i32];
            let masks = n.x;
            let solid_mask = masks & 0xFFu;
            let sh = PATH_BITS - 1u - lvl;
            let ox = (ix >> sh) & 1u;
            let oy = (iy >> sh) & 1u;
            let oz = (iz >> sh) & 1u;
            let oct = ox | (oy << 1u) | (oz << 2u);
            let sub_size = ((1u << sh) as f32) * (1.0 / PATH_SCALE);
            let sub_min = vec3<f32>(((ix >> sh) << sh) as f32, ((iy >> sh) << sh) as f32,
                                    ((iz >> sh) << sh) as f32) * (1.0 / PATH_SCALE);
            let sub_max = sub_min + vec3<f32>(sub_size, sub_size, sub_size);
            let t_sub_exit = box_exit_t(ro_n, rd_sx, rd_sy, rd_sz, inv_d, sub_min, sub_max);
            let step_eps = max(max(1e-6, t * 2e-5), sub_size * 1e-4);

            let bit = 1u << oct;
            if ((solid_mask & bit) == 0u) {
                t = max(t_sub_exit + step_eps, t + step_eps);
                break;
            }

            let valid_mask = (masks & 0xFFu) | ((masks >> 8u) & 0xFFu);
            let slot = popcount_below32(valid_mask, oct);
            let raw_ref = children[(n.y + slot) as i32];
            let leaf_mask = (masks >> 16u) & 0xFFu;
            let is_leaf = (leaf_mask & bit) != 0u;
            let resolved = resolve_child(raw_ref, eff_tick, clips, frames);
            if (resolved == DAG_INVALID) {
                t = max(t_sub_exit + step_eps, t + step_eps);
                break;
            }

            // Continuous pixel-cone LOD termination when octant projects smaller than cone threshold.
            if ((cone_k > 0.0 || lod_n > 0.0) && sub_size <= t * cone_k + lod_n) {
                var pco: u32 = 0u;
                var pnm: u32 = 0u;
                var is_emissive: bool = false;
                if (is_leaf) {
                    let b1 = bricks[(resolved * 2u + 1u) as i32];
                    pco = b1.y;
                    pnm = b1.z;
                    is_emissive = (pnm >> 24u) != 0u;
                } else {
                    let cn = nodes[resolved as i32];
                    pco = cn.z;
                    pnm = cn.w;
                    is_emissive = (((cn.x >> 24u) & 0xFFu) & DAG_FLAG_EMISSIVE) != 0u;
                }
                let col_a = unpack_rgba8(pco);
                let ln = unpack_oct_normal(pnm);
                var wn: vec3<f32> = r1.xyz * ln.x + r2.xyz * ln.y + r3.xyz * ln.z;
                if (dot(wn, -rd) < -0.1) {
                    let fn_loc = box_entry_normal(ro_n, rd_sx, rd_sy, rd_sz, inv_d, sub_min, sub_max);
                    wn = r1.xyz * fn_loc.x + r2.xyz * fn_loc.y + r3.xyz * fn_loc.z;
                }
                wn = safe_normalize(wn, -rd);
                let w = (1.0 - accum_a) * col_a.w;
                if (first_t > 1e29 && w > 0.01) {
                    first_t = t;
                    first_vox = sub_size * extent;
                }
                accum_rgb += col_a.xyz * w;
                accum_n += wn * w;
                accum_rough += unpack_roughness(pnm) * w;
                let em = is_emissive ? unpack_emissive(pnm) * 4.0 : 0.0;
                accum_emis += em * w;
                accum_op += col_a.w * w;
                accum_a += w;

                if (accum_a >= 0.95) {
                    let inv_a = 1.0 / max(accum_a, 1e-4);
                    let safe_n = safe_normalize(accum_n, -rd);
                    let w_dist = first_t * extent;
                    return TraceHit {
                        hit: true,
                        t: w_dist,
                        pos: ro + rd * w_dist,
                        normal: safe_n,
                        color: accum_rgb * inv_a,
                        roughness: accum_rough * inv_a,
                        emissive: accum_emis * inv_a,
                        voxel_size: first_vox,
                        opacity: accum_op * inv_a,
                    };
                }
                t = max(t_sub_exit + step_eps, t + step_eps);
                break;
            }

            if (is_leaf) {
                let b0 = bricks[(resolved * 2u) as i32];
                let b1 = bricks[(resolved * 2u + 1u) as i32];
                let vox_size = sub_size * 0.25;
                let inv_sub = 1.0 / max(sub_size, 1e-6);
                let brick_end = min(t_exit, t_sub_exit);
                var bt: f32 = t;
                var bstep: u32 = 0u;
                while (bstep < 16u && bt < brick_end) {
                    let rp = clamp((ro_n + rd_n * bt - sub_min) * inv_sub, vec3<f32>(0.0), vec3<f32>(0.999999)) * 4.0;
                    let vx = min(floor(rp.x) as u32, 3u);
                    let vy = min(floor(rp.y) as u32, 3u);
                    let vz = min(floor(rp.z) as u32, 3u);
                    let bidx = vx + (vy << 2u) + ((vz << 4u));
                    let vox_min = sub_min + vec3<f32>(vx as f32, vy as f32, vz as f32) * vox_size;
                    let vox_max = vox_min + vec3<f32>(vox_size, vox_size, vox_size);
                    var attr0: u32 = b1.y;
                    var attr1: u32 = b1.z;
                    var solid_here: bool = bit64_set(b0.x, b0.y, bidx);
                    if (solid_here) {
                        if ((b1.w & DAG_BRICK_UNIFORM_ATTR) == 0u) {
                            let rank = popcount64_below(b0.x, b0.y, bidx);
                            let aidx = ((b1.x + rank) * 2u) as i32;
                            attr0 = attrs[aidx];
                            attr1 = attrs[aidx + 1];
                        }
                        // A voxel's alpha is its opacity: the ray passes one
                        // with probability 1 - alpha, the same voxels for
                        // every pixel (a hash of where it is), so a crown of
                        // leaves has the holes the leaves leave.
                        let op = unpack_rgba8(attr0).w;
                        if (op < 0.999) {
                            let gx = ((ix >> sh) << 2u) + vx;
                            let gy = ((iy >> sh) << 2u) + vy;
                            let gz = ((iz >> sh) << 2u) + vz;
                            solid_here = voxel_hash01(gx, gy, gz, ri ^ hash_seed) < op;
                        }
                    }
                    if (solid_here) {
                        let col_a = unpack_rgba8(attr0);
                        let ln = unpack_oct_normal(attr1);
                        var wn: vec3<f32> = r1.xyz * ln.x + r2.xyz * ln.y + r3.xyz * ln.z;
                        if (dot(wn, -rd) < -0.1) {
                            let fn_loc = box_entry_normal(ro_n, rd_sx, rd_sy, rd_sz, inv_d, vox_min, vox_max);
                            wn = r1.xyz * fn_loc.x + r2.xyz * fn_loc.y + r3.xyz * fn_loc.z;
                        }
                        wn = safe_normalize(wn, -rd);
                        let em = unpack_emissive(attr1) * 4.0;
                        let w = 1.0 - accum_a;
                        let hit_t = first_t < 1e29 ? first_t : bt;
                        let final_rgb = accum_rgb + col_a.xyz * w;
                        let sum_n = accum_n + wn * w;
                        let final_n = safe_normalize(sum_n, wn);
                        let final_r = accum_rough + unpack_roughness(attr1) * w;
                        let final_em = accum_emis + em * w;
                        let w_dist = hit_t * extent;
                        return TraceHit {
                            hit: true,
                            t: w_dist,
                            pos: ro + rd * w_dist,
                            normal: final_n,
                            color: final_rgb,
                            roughness: final_r,
                            emissive: final_em,
                            voxel_size: vox_size * extent,
                            opacity: col_a.w,
                        };
                    }
                    let t_vx_exit = box_exit_t(ro_n, rd_sx, rd_sy, rd_sz, inv_d, vox_min, vox_max);
                    let beps = max(max(1e-6, bt * 2e-5), vox_size * 1e-3);
                    bt = max(t_vx_exit + beps, bt + beps);
                    bstep += 1u;
                }
                t = max(t_sub_exit + step_eps, t + step_eps);
                break;
            }

            cur = resolved;
            lvl += 1u;
            path[lvl] = resolved;
        }
        step += 1u;
    }

    if (accum_a >= 0.35 && first_t < 1e29) {
        let inv_a = 1.0 / max(accum_a, 1e-4);
        let safe_n = safe_normalize(accum_n, -rd);
        let w_dist = first_t * extent;
        return TraceHit {
            hit: true,
            t: w_dist,
            pos: ro + rd * w_dist,
            normal: safe_n,
            color: accum_rgb * inv_a,
            roughness: accum_rough * inv_a,
            emissive: accum_emis * inv_a,
            voxel_size: first_vox,
            opacity: accum_op * inv_a,
        };
    }
    return no_hit();
}

// Convenience wrapper with centered dither threshold (0.5) for non-dithered callers.
pub fn trace_region<BReg, BN, BC, BB, BA, BClip, BF>(
    ro: vec3<f32>,
    rd: vec3<f32>,
    t_max_world: f32,
    pixel_cone: f32,
    lod_scale: f32,
    max_steps: u32,
    anim_tick: u32,
    ri: u32,
    regions: BReg,
    nodes: BN,
    children: BC,
    bricks: BB,
    attrs: BA,
    clips: BClip,
    frames: BF
) -> TraceHit {
    return trace_region_dithered(
        ro, rd, t_max_world, pixel_cone, lod_scale, max_steps, anim_tick, ri, 0.5,
        vec4<f32>(0.0, 0.0, 0.0, 0.0), regions, nodes, children, bricks, attrs, clips, frames
    );
}
