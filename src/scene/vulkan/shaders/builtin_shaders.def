// The scene's built-in shaders: one line each, read by the build and by C++.
//
//   BRO_SCENE_SHADER(Enum, "generated name", "source file", "stage", "DEFINES")
//
// src/scene/CMakeLists.txt reads the lines (a regex per line, so keep each on
// one line) and compiles each source with bro_spirv_embed into
// <generated name>.spv.cpp, the DEFINES (space separated) #defined to 1 after
// the #version line. The source file is its path under vulkan/shaders, as
// every #include in it is. scene_vk_shader_compiler.h makes the Enum names
// into BuiltinSceneShader, and under BRO_SCENE_SHADER_SOURCE the scene
// compiles the same source with the same DEFINES at run time
// (docs/hot-reload.md). Adding a shader is adding a line here.

BRO_SCENE_SHADER(PostFxVert,               "postfx.vert",                 "post/postfx.vert",                   "vert", "")
BRO_SCENE_SHADER(TonemapFrag,              "tonemap.frag",                "post/tonemap.frag",                  "frag", "")
BRO_SCENE_SHADER(FxaaFrag,                 "fxaa.frag",                   "post/fxaa.frag",                     "frag", "")
BRO_SCENE_SHADER(BillboardVert,            "billboard.vert",              "draw/billboard.vert",                "vert", "")
BRO_SCENE_SHADER(BillboardFrag,            "billboard.frag",              "draw/billboard.frag",                "frag", "")
BRO_SCENE_SHADER(ParticlesVert,            "particles.vert",              "draw/particles.vert",                "vert", "")
BRO_SCENE_SHADER(ParticlesFrag,            "particles.frag",              "draw/particles.frag",                "frag", "")
BRO_SCENE_SHADER(DecalVert,                "decal.vert",                  "draw/decal.vert",                    "vert", "")
BRO_SCENE_SHADER(DecalFrag,                "decal.frag",                  "draw/decal.frag",                    "frag", "")
// A volume's triangle over the view (pass_volume.cpp); volume.frag is compiled with its chunk at run time.
BRO_SCENE_SHADER(VolumeVert,               "volume.vert",                 "draw/volume.vert",                   "vert", "")
BRO_SCENE_SHADER(VolumeResolveFrag,        "volume_resolve.frag",         "post/volume_resolve.frag",           "frag", "")
BRO_SCENE_SHADER(VolumeCompositeFrag,      "volume_composite.frag",       "post/volume_composite.frag",         "frag", "")
BRO_SCENE_SHADER(BlurFrag,                 "blur.frag",                   "post/blur.frag",                     "frag", "")
BRO_SCENE_SHADER(SsaoFrag,                 "ssao.frag",                   "post/ssao.frag",                     "frag", "")
BRO_SCENE_SHADER(SsrFrag,                  "ssr.frag",                    "post/ssr.frag",                      "frag", "")
BRO_SCENE_SHADER(DofFrag,                  "dof.frag",                    "post/dof.frag",                      "frag", "")
BRO_SCENE_SHADER(ApplyAoFrag,              "apply_ao.frag",               "post/apply_ao.frag",                 "frag", "")
BRO_SCENE_SHADER(GaussianSplatVert,        "gaussian_splat.vert",         "draw/gaussian_splat.vert",           "vert", "")
BRO_SCENE_SHADER(GaussianSplatFrag,        "gaussian_splat.frag",         "draw/gaussian_splat.frag",           "frag", "")
BRO_SCENE_SHADER(BloomBrightFrag,          "bloom_bright.frag",           "post/bloom_bright.frag",             "frag", "")
BRO_SCENE_SHADER(TiltCompositeFrag,        "tilt_composite.frag",         "post/tilt_composite.frag",           "frag", "")
// Exposure (scene_exposure.cpp): the frame's luminance histogram, metered and
// adapted by its last workgroup.
BRO_SCENE_SHADER(ExposureComp,             "exposure.comp",               "post/exposure.comp",                 "comp", "")
