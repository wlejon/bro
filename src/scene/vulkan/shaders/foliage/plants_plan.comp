#version 450
// The plants' GPU plan (scene_plants_gpu_plan.cpp): what each plant of the
// cells in view is drawn with in every view, the camera's and each shadow
// tile's, written as the chunk records the draws read and their indirect
// commands. Three dependent stages:
//   PLANTS_COUNT   a thread a plant of the cells in view (the world cell
//                  pass's items): each view's pick of it (pick() below),
//                  its chunks added to its slot's counts, and the stats
//   PLANTS_LAYOUT  one thread: the slots laid end to end (the camera's
//                  bands nearest first, then each tile's leaves and its
//                  crown discs; then the wood likewise; then the discs'
//                  records), the draws' commands and the pose stage's
//                  dispatch, all cut to the room there is
//   PLANTS_PLACE   a thread a plant again, a view at a time: its pick again,
//                  a place in its slot (a workgroup takes its share of the
//                  slot at once) and its chunk records written
// Within a camera band the plants go in no order; the bands, 4 an octave of
// distance, keep what is near ahead of what is behind it for the early depth
// test. A tile's casters go in no order at all.
//
// pick() is the choice, plant by plant: the camera's plants within
// range and frustum, each with as many elements as keep one `pixels` across
// (never under a floor that covers its crown on screen); each tile's casters
// within shadowRange and its frustum, each kept to `shadowTexels` of its
// texels, a crown a few of those across cast as one disc; trunks within
// woodRange, limbs nearer still.

#include "foliage/scene_plants_plan_layout.h"
#include "world/world_cells_layout.h"

layout(local_size_x = PP_GROUP_SIZE) in;

layout(std430, set = 0, binding = 0) readonly buffer Static { vec4 header[4]; vec4 records[]; } st;
layout(std430, set = 0, binding = 1) readonly buffer Params { uint w[]; } params;
layout(std430, set = 0, binding = 2) readonly buffer Cells { uint w[]; } cells;
layout(std430, set = 0, binding = 3) buffer Work { uint w[]; } work;
layout(std430, set = 0, binding = 4) writeonly buffer Chunks { vec4 c[]; } chunks;
layout(std430, set = 0, binding = 5) writeonly buffer Args { uint w[]; } args;

float pf(uint i) { return uintBitsToFloat(params.w[i]); }
uint tiles() { return min(params.w[PP_P_TILES], uint(PP_MAX_TILES)); }

// A slot's place among the work's runs: the camera's band `b`, or tile t's.
uint cameraSlot(uint b) { return b; }
uint tileSlot(uint t) { return uint(PP_BANDS) + t; }

#if !defined(PLANTS_LAYOUT)
// bromath::fintersects(frustum, box), as the cell pass's.
bool intersects(uint planes, vec3 bmin, vec3 bmax) {
    for (uint i = 0u; i < 6u; ++i) {
        uint at = planes + 4u * i;
        vec4 p = vec4(pf(at), pf(at + 1u), pf(at + 2u), pf(at + 3u));
        vec3 v = vec3(p.x >= 0.0 ? bmax.x : bmin.x, p.y >= 0.0 ? bmax.y : bmin.y, p.z >= 0.0 ? bmax.z : bmin.z);
        precise float d = p.x * v.x + p.y * v.y + p.z * v.z + p.w;
        if (d < 0.0) return false;
    }
    return true;
}

// The plant at place `p` among the items of the cells in view (the cell
// whose items hold it: the last starting at or before it), and the views
// that see its cell. The plants are in cell order, so its index is its
// cell's first and its place in the cell.
uint plantAtPlace(uint p, out uvec2 mask) {
    uint lo = 0u, hi = cells.w[WC_O_CELLS] - 1u;
    while (lo < hi) {
        uint mid = (lo + hi + 1u) >> 1;
        if (cells.w[WC_O_HEADER + mid * WC_V_WORDS + WC_V_PREFIX] <= p) lo = mid; else hi = mid - 1u;
    }
    uint v = WC_O_HEADER + lo * WC_V_WORDS;
    mask = uvec2(cells.w[v + WC_V_MASK], cells.w[v + WC_V_MASK + 1u]);
    return cells.w[v + WC_V_FIRST] + (p - cells.w[v + WC_V_PREFIX]);
}
bool seenBy(uvec2 mask, uint v) { return v < 32u ? (mask.x & (1u << v)) != 0u : (mask.y & (1u << (v - 32u))) != 0u; }

// What the plan needs of a plant: its sphere (PlantsNode's), and of its
// species (the engine's share of its record, scene_plant_records.glsl's
// PlantSpecies) the full count, its element's length and crown's radius at
// its scale, its crown's middle above its foot, its limbs.
struct PlantInfo {
    vec3 centre;
    float radius;
    float full, leaf, crown, mid;
    uint limbs;
};

PlantInfo plantInfo(uint i) {
    vec4 a = st.records[uint(st.header[1].x) + i * 2u];
    vec4 b = st.records[uint(st.header[1].x) + i * 2u + 1u];
    int species = int(b.y);
    if (species < 0 || species >= int(st.header[0].y)) species = 0;
    uint r = uint(st.header[0].w) + uint(species) * 8u;
    vec4 s0 = st.records[r], s1 = st.records[r + 1u];
    float scale = b.x;
    PlantInfo o;
    precise float height = s0.x * scale;
    o.centre = vec3(a.x, a.y + 0.5 * height, a.z);
    precise float reach = sqrt(0.25 * s0.x * s0.x + s0.z * s0.z) + 0.15 * s0.z;
    o.radius = reach * scale + 0.3;
    o.full = max(s0.w, 1.0);
    o.leaf = s1.x * scale;
    o.crown = s0.z * scale;
    o.mid = 0.5 * (1.0 + s0.y) * height;
    o.limbs = uint(clamp(int(s1.y), 0, PP_MAX_LIMBS));
    return o;
}

// A view's pick of a plant: whether it is drawn there, in which slot, with
// how many elements (0: a caster's crown disc), and its chunks; a plant of
// few elements packed (pack: its class + 1) with others in shared chunks.
struct Pick {
    bool on;
    uint slot;
    float elements;
    bool disc;
    uint pack;
    uint leafChunks, woodChunks, limbs;
};

// The pack class of a plant of `n` elements: 2^c slots hold it.
uint packClass(uint n) { return n <= 1u ? 0u : uint(findMSB(n - 1u)) + 1u; }

// Its elements at `across` pixels (or texels) a metre, each kept to `kept`
// of them, never under `least`.
float elementCount(PlantInfo pl, float across, float kept, float least) {
    precise float leaf = pl.leaf * across;
    precise float f = (leaf * leaf) / (kept * kept);
    precise float n = pl.full * min(1.0, f);
    return clamp(n, min(least, pl.full), pl.full);
}

Pick pick(PlantInfo pl, uint v) {
    Pick k;
    k.on = false;
    k.slot = 0u;
    k.disc = false;
    k.pack = 0u;
    k.elements = 0.0;
    k.leafChunks = k.woodChunks = k.limbs = 0u;
    vec3 eye = vec3(pf(PP_P_EYE), pf(PP_P_EYE + 1u), pf(PP_P_EYE + 2u));
    precise vec3 dv = pl.centre - eye;
    precise float d = sqrt(dv.x * dv.x + dv.y * dv.y + dv.z * dv.z);
    vec3 bmin = pl.centre - vec3(pl.radius), bmax = pl.centre + vec3(pl.radius);
    float woodRange = pf(PP_P_WOOD_RANGE);
    float minElements = pf(PP_P_MIN_ELEMENTS);
    bool wood = d - pl.radius < woodRange;
    if (v == 0u) {
        if (d - pl.radius > pf(PP_P_RANGE) || !intersects(PP_P_FRUSTUM, bmin, bmax)) return k;
        // Pixels across a metre at the plant's near side; never fewer than
        // minElements, nor than it takes elements `pixels` across to cover
        // its crown on screen (a tree at the horizon: one).
        precise float across = pf(PP_P_FOCAL) / max(d - 0.5 * pl.radius, 0.5);
        precise float crown = pl.crown * across / pf(PP_P_PIXELS);
        precise float least = clamp(3.14159 * crown * crown, 1.0, minElements);
        k.elements = elementCount(pl, across, pf(PP_P_PIXELS), least);
        k.slot = cameraSlot(min(uint(PP_BANDS) - 1u, uint(log2(1.0 + d) * 4.0)));
        k.limbs = d < 0.4 * woodRange ? pl.limbs + 1u : 1u;
    } else {
        uint t = v - 1u;
        uint at = PP_P_TILE + t * PP_TILE_WORDS;
        if (d - pl.radius > pf(PP_P_SHADOW_RANGE) || !intersects(at + PP_TILE_FRUSTUM, bmin, bmax)) return k;
        // The sun's views part the crowns: one whose penumbra on the ground
        // under it is wider than stillPenumbra hides its sway, cast still.
        uint part = params.w[at + PP_TILE_PLANTS];
        bool still = pf(at + PP_TILE_PENUMBRA) * pl.mid > pf(PP_P_STILL_PENUMBRA);
        if ((part == PP_PLANTS_SWAYING && still) || (part == PP_PLANTS_STILL && !still)) return k;
        // Texels across a metre (a perspective tile's at about the eye's
        // distance); a still crown's no finer than the lit shaders blur
        // its shadow, an element about as wide as its penumbra. A crown a
        // few daubs across casts its outline, a disc.
        precise float texel = max(params.w[at + PP_TILE_ORTHO] != 0u ? pf(at + PP_TILE_TEXEL_CONST)
                                                                      : pf(at + PP_TILE_TEXEL_PER_METRE) * max(d, 1.0),
                                  1e-4);
        if (still) texel = max(texel, pf(at + PP_TILE_PENUMBRA) * pl.mid / pf(PP_P_SHADOW_TEXELS));
        precise float crown = pl.radius / (texel * pf(PP_P_SHADOW_TEXELS));
        k.slot = tileSlot(t);
        if (crown < 1.5) {
            k.on = true;
            k.disc = true;
            return k;
        }
        precise float least = clamp(3.14159 * crown * crown, 2.0, minElements);
        k.elements = elementCount(pl, 1.0 / texel, pf(PP_P_SHADOW_TEXELS), least);
        k.limbs = d < 0.15 * woodRange ? pl.limbs + 1u : 1u;
    }
    k.on = true;
    uint n = max(uint(ceil(k.elements)), 1u);
    if (n <= uint(PP_PACK_MOST)) {
        k.pack = packClass(n) + 1u;
        k.leafChunks = 0u;
    } else {
        k.leafChunks = (n + uint(PP_LEAVES_PER_CHUNK) - 1u) / uint(PP_LEAVES_PER_CHUNK);
    }
    if (!wood) k.limbs = 0u;
    k.woodChunks = (k.limbs + uint(PP_LIMBS_PER_CHUNK) - 1u) / uint(PP_LIMBS_PER_CHUNK);
    return k;
}
#endif

#if defined(PLANTS_COUNT)
shared uint sLeaf[PP_SLOTS], sWood[PP_SLOTS], sDisc[PP_MAX_TILES], sPack[PP_PACK_WORDS];
shared uint sStats[4];

void main() {
    uint lid = gl_LocalInvocationID.x;
    for (uint i = lid; i < uint(PP_SLOTS); i += uint(PP_GROUP_SIZE)) {
        sLeaf[i] = 0u;
        sWood[i] = 0u;
        if (i < uint(PP_MAX_TILES)) sDisc[i] = 0u;
    }
    for (uint i = lid; i < uint(PP_PACK_WORDS); i += uint(PP_GROUP_SIZE)) sPack[i] = 0u;
    if (lid < 4u) sStats[lid] = 0u;
    barrier();
    uint place = gl_GlobalInvocationID.x;
    if (place < cells.w[WC_O_ITEMS]) {
        uvec2 mask;
        PlantInfo pl = plantInfo(plantAtPlace(place, mask));
        uint views = 1u + tiles();
        for (uint v = 0u; v < views; ++v) {
            if (!seenBy(mask, v)) continue;
            Pick k = pick(pl, v);
            if (!k.on) continue;
            if (k.disc) {
                atomicAdd(sDisc[k.slot - uint(PP_BANDS)], 1u);
                atomicAdd(sStats[3], 1u);
                continue;
            }
            if (k.pack > 0u) atomicAdd(sPack[k.slot * uint(PP_PACK_CLASSES) + k.pack - 1u], 1u);
            if (k.leafChunks > 0u) atomicAdd(sLeaf[k.slot], k.leafChunks);
            if (k.woodChunks > 0u) atomicAdd(sWood[k.slot], k.woodChunks);
            uint n = uint(ceil(k.elements));
            if (v == 0u) {
                atomicAdd(sStats[0], 1u);
                atomicAdd(sStats[1], n);
                atomicAdd(sStats[2], k.limbs);
            } else {
                atomicAdd(sStats[3], max(n, 1u));
            }
        }
    }
    barrier();
    for (uint i = lid; i < uint(PP_SLOTS); i += uint(PP_GROUP_SIZE)) {
        if (sLeaf[i] > 0u) atomicAdd(work.w[PP_N_LEAF + i], sLeaf[i]);
        if (sWood[i] > 0u) atomicAdd(work.w[PP_N_WOOD + i], sWood[i]);
        if (i >= uint(PP_BANDS) && sDisc[i - uint(PP_BANDS)] > 0u)
            atomicAdd(work.w[PP_N_DISC + i], sDisc[i - uint(PP_BANDS)]);
    }
    for (uint i = lid; i < uint(PP_PACK_WORDS); i += uint(PP_GROUP_SIZE))
        if (sPack[i] > 0u) atomicAdd(work.w[PP_N_PACK + i], sPack[i]);
    if (lid < 4u && sStats[lid] > 0u) atomicAdd(work.w[PP_N_STATS + lid], sStats[lid]);
}

#elif defined(PLANTS_LAYOUT)
// [start, start + n) cut to `cap`: how much of it there is room for.
uint fits(uint start, uint n, uint cap) { return start >= cap ? 0u : min(n, cap - start); }

void putIndexed(uint command, uint first, uint count) {
    uint a = PP_A_COMMANDS + command * PP_A_COMMAND_WORDS;
    args.w[a] = uint(PP_LEAVES_PER_CHUNK * PP_LEAF_INDICES);
    args.w[a + 1u] = count;
    args.w[a + 2u] = 0u;
    args.w[a + 3u] = 0u;
    args.w[a + 4u] = first;
}
void putDraw(uint command, uint first, uint count) {
    uint a = PP_A_COMMANDS + command * PP_A_COMMAND_WORDS;
    args.w[a] = uint(PP_LIMBS_PER_CHUNK * PP_TUBE_VERTS);
    args.w[a + 1u] = count;
    args.w[a + 2u] = 0u;
    args.w[a + 3u] = first;
}

// Slot s's packed chunks from `at`, class by class; past them.
uint layPacks(uint s, uint at) {
    for (uint c = 0u; c < uint(PP_PACK_CLASSES); ++c) {
        uint i = s * uint(PP_PACK_CLASSES) + c;
        uint per = uint(PP_LEAVES_PER_CHUNK) >> c;
        work.w[PP_N_PACK_CHUNK + i] = at;
        at += (work.w[PP_N_PACK + i] + per - 1u) / per;
    }
    return at;
}

void main() {
    if (gl_LocalInvocationID.x != 0u) return;
    uint chunkCap = params.w[PP_P_CHUNK_CAP];
    uint leafCap = min(params.w[PP_P_LEAF_CAP], chunkCap);
    uint nt = tiles();
    // The leaf chunks: the camera's bands (each its own then its packed),
    // then each tile's leaves, its packed and its discs' chunks.
    uint at = 0u;
    for (uint b = 0u; b < uint(PP_BANDS); ++b) {
        work.w[PP_N_LEAF_START + b] = at;
        at += work.w[PP_N_LEAF + b];
        at = layPacks(cameraSlot(b), at);
    }
    uint cameraLeaves = at;
    for (uint t = 0u; t < nt; ++t) {
        uint s = tileSlot(t);
        work.w[PP_N_LEAF_START + s] = at;
        at += work.w[PP_N_LEAF + s];
        at = layPacks(s, at);
        work.w[PP_N_DISC_CHUNK + s] = at;
        at += (work.w[PP_N_DISC + s] + uint(PP_LEAVES_PER_CHUNK) - 1u) / uint(PP_LEAVES_PER_CHUNK);
    }
    uint leafArea = at;
    // The wood, likewise.
    for (uint b = 0u; b < uint(PP_BANDS); ++b) {
        work.w[PP_N_WOOD_START + b] = at;
        at += work.w[PP_N_WOOD + b];
    }
    uint cameraWood = at - leafArea;
    for (uint t = 0u; t < nt; ++t) {
        uint s = tileSlot(t);
        work.w[PP_N_WOOD_START + s] = at;
        at += work.w[PP_N_WOOD + s];
    }
    // The discs' records, each tile's those that fit.
    for (uint t = 0u; t < nt; ++t) {
        uint s = tileSlot(t);
        work.w[PP_N_DISC_START + s] = at;
        work.w[PP_N_DISC_FIT + s] = fits(at, work.w[PP_N_DISC + s], chunkCap);
        at += work.w[PP_N_DISC + s];
    }
    // The packed plants' records, each slot's classes' those that fit.
    for (uint i = 0u; i < uint(PP_PACK_WORDS); ++i) {
        if (i / uint(PP_PACK_CLASSES) >= uint(PP_BANDS) + nt) break;
        work.w[PP_N_PACK_START + i] = at;
        work.w[PP_N_PACK_FIT + i] = fits(at, work.w[PP_N_PACK + i], chunkCap);
        at += work.w[PP_N_PACK + i];
    }
    work.w[PP_N_STATS + PP_S_RECORDS] = at;
    work.w[PP_N_STATS + PP_S_LEAF_CHUNKS] = leafArea;

    // The poses: every leaf chunk there is room for (a disc chunk's
    // workgroup returns at once).
    args.w[PP_A_POSE] = min(leafArea, leafCap);
    args.w[PP_A_POSE + 1u] = 1u;
    args.w[PP_A_POSE + 2u] = 1u;
    putIndexed(0u, 0u, fits(0u, cameraLeaves, leafCap));
    putDraw(1u, leafArea, fits(leafArea, cameraWood, chunkCap));
    for (uint t = 0u; t < uint(PP_MAX_TILES); ++t) {
        uint s = tileSlot(t);
        uint leaves = 0u, first = 0u, woodFirst = 0u, wood = 0u;
        if (t < nt) {
            first = work.w[PP_N_LEAF_START + s];
            leaves = fits(first, work.w[PP_N_DISC_CHUNK + s] - first +
                                     (work.w[PP_N_DISC + s] + uint(PP_LEAVES_PER_CHUNK) - 1u) / uint(PP_LEAVES_PER_CHUNK),
                          leafCap);
            woodFirst = work.w[PP_N_WOOD_START + s];
            wood = fits(woodFirst, work.w[PP_N_WOOD + s], chunkCap);
        }
        putIndexed(2u + 2u * t, first, leaves);
        putDraw(3u + 2u * t, woodFirst, wood);
    }
}

#else   // PLANTS_PLACE
// A view's counts in this workgroup, then (in place) its share's first
// place in each slot: the camera's bands, or a tile's one (index 0).
shared uint sLeaf[PP_BANDS], sWood[PP_BANDS], sDisc;
shared uint sPack[PP_BANDS * PP_PACK_CLASSES];   // a band's (a tile's: band 0's) classes

// Write chunk record `index` if it lies in its slot's run [start, end) and
// under `cap` (a pick a bit apart from the count's never spills into the
// next slot).
void putChunk(uint index, uint end, uint cap, vec4 record) {
    if (index < end && index < cap) chunks.c[index] = record;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint place = gl_GlobalInvocationID.x;
    uint chunkCap = params.w[PP_P_CHUNK_CAP];
    uint leafCap = min(params.w[PP_P_LEAF_CAP], chunkCap);
    bool any = place < cells.w[WC_O_ITEMS];
    uvec2 mask = uvec2(0u);
    uint plant = 0u;
    PlantInfo pl;
    if (any) {
        plant = plantAtPlace(place, mask);
        pl = plantInfo(plant);
    }
    uint views = 1u + tiles();
    for (uint v = 0u; v < views; ++v) {
        if (lid < uint(PP_BANDS)) {
            sLeaf[lid] = 0u;
            sWood[lid] = 0u;
        }
        if (lid == 0u) sDisc = 0u;
        uint packs = (v == 0u ? uint(PP_BANDS) : 1u) * uint(PP_PACK_CLASSES);
        for (uint i = lid; i < packs; i += uint(PP_GROUP_SIZE)) sPack[i] = 0u;
        barrier();
        Pick k;
        k.on = false;
        k.slot = 0u;
        k.pack = 0u;
        if (any && seenBy(mask, v)) k = pick(pl, v);
        uint band = v == 0u ? k.slot : 0u;
        uint myLeaf = 0u, myWood = 0u, myDisc = 0u, myPack = 0u;
        if (k.on) {
            if (k.disc) {
                myDisc = atomicAdd(sDisc, 1u);
            } else {
                if (k.pack > 0u) myPack = atomicAdd(sPack[band * uint(PP_PACK_CLASSES) + k.pack - 1u], 1u);
                myLeaf = atomicAdd(sLeaf[band], k.leafChunks);
                myWood = atomicAdd(sWood[band], k.woodChunks);
            }
        }
        barrier();
        // The workgroup's share of each slot, from its cursors.
        if (lid < (v == 0u ? uint(PP_BANDS) : 1u)) {
            uint s = v == 0u ? cameraSlot(lid) : tileSlot(v - 1u);
            if (sLeaf[lid] > 0u) sLeaf[lid] = atomicAdd(work.w[PP_N_CURSOR + s], sLeaf[lid]);
            if (sWood[lid] > 0u) sWood[lid] = atomicAdd(work.w[PP_N_CURSOR + PP_SLOTS + s], sWood[lid]);
            if (lid == 0u && v > 0u && sDisc > 0u) sDisc = atomicAdd(work.w[PP_N_CURSOR + 2 * PP_SLOTS + s], sDisc);
        }
        for (uint i = lid; i < packs; i += uint(PP_GROUP_SIZE)) {
            uint s = v == 0u ? cameraSlot(i / uint(PP_PACK_CLASSES)) : tileSlot(v - 1u);
            uint g = s * uint(PP_PACK_CLASSES) + i % uint(PP_PACK_CLASSES);
            if (sPack[i] > 0u) sPack[i] = atomicAdd(work.w[PP_N_PACK_CURSOR + g], sPack[i]);
        }
        barrier();
        if (k.on) {
            uint s = k.slot;
            float caster = v == 0u ? 0.0 : 1.0;
            if (k.pack > 0u) {
                // Its record in its class's list, and the shared chunk it
                // begins (every chunk written, as the discs' are).
                uint c = k.pack - 1u;
                uint g = s * uint(PP_PACK_CLASSES) + c;
                uint d = sPack[band * uint(PP_PACK_CLASSES) + c] + myPack;
                uint fit = work.w[PP_N_PACK_FIT + g];
                uint first = work.w[PP_N_PACK_START + g];
                uint per = uint(PP_LEAVES_PER_CHUNK) >> c;
                if (d < fit) chunks.c[first + d] = vec4(float(plant), k.elements, 0.0, 0.0);
                if (d % per == 0u && d < work.w[PP_N_PACK + g]) {
                    uint at = work.w[PP_N_PACK_CHUNK + g] + d / per;
                    uint n = d < fit ? min(fit - d, per) : 0u;
                    if (at < leafCap) chunks.c[at] = vec4(float(first + d), float(n), float(1u << c), 3.0 + caster);
                }
            }
            if (k.disc) {
                // Its record in the tile's disc list, and the chunk of the
                // discs it begins (every chunk written, those past the room
                // with none, so the poses and draws read no stale chunk).
                uint d = sDisc + myDisc;
                uint fit = work.w[PP_N_DISC_FIT + s];
                uint first = work.w[PP_N_DISC_START + s];
                if (d < fit) chunks.c[first + d] = vec4(float(plant), 0.0, 0.0, 0.0);
                if (d % uint(PP_LEAVES_PER_CHUNK) == 0u && d < work.w[PP_N_DISC + s]) {
                    uint c = work.w[PP_N_DISC_CHUNK + s] + d / uint(PP_LEAVES_PER_CHUNK);
                    uint n = d < fit ? min(fit - d, uint(PP_LEAVES_PER_CHUNK)) : 0u;
                    if (c < leafCap) chunks.c[c] = vec4(float(first + d), float(n), 0.0, 2.0);
                }
            } else {
                uint start = work.w[PP_N_LEAF_START + s];
                uint end = start + work.w[PP_N_LEAF + s];
                uint at = start + sLeaf[band] + myLeaf;
                for (uint c = 0u; c < k.leafChunks; ++c)
                    putChunk(at + c, end, leafCap,
                             vec4(float(plant), float(c * uint(PP_LEAVES_PER_CHUNK)), k.elements, caster));
                start = work.w[PP_N_WOOD_START + s];
                end = start + work.w[PP_N_WOOD + s];
                at = start + sWood[band] + myWood;
                for (uint c = 0u; c < k.woodChunks; ++c)
                    putChunk(at + c, end, chunkCap,
                             vec4(float(plant), float(c * uint(PP_LIMBS_PER_CHUNK)), float(k.limbs), 0.0));
            }
        }
        barrier();
    }
}
#endif
