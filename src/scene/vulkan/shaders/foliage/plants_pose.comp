#version 450
// Plants' element poses (scene_plants.glsl): each element built once a
// frame by its world's plant module (plantElement), so the points
// plants.vert and shadow_plants.vert draw only read it. A workgroup a chunk
// of elements, dispatched over the plan's leaf chunks (its indirect
// dispatch), the slot of a chunk's element e being
// chunk * PLANT_LEAVES_PER_CHUNK + e.

layout(local_size_x = 32) in;

#define PLANT_BUILD 1
#include "common/scene_camera.glsl"
#include "foliage/scene_plants.glsl"

layout(std430, set = 3, binding = 3) writeonly buffer PlantPoses {
    uvec4 poses[];
} plantPoses;

void main() {
    int e = int(gl_LocalInvocationID.x);
    int chunkIndex = int(gl_WorkGroupID.x);
    vec4 chunk = plantChunks.chunks[chunkIndex];
    if (chunk.w > 1.5) return;   // crown discs: built where they are drawn
    PlantElement pose;
    PlantCrown cr;
    int species;
    // (chunk.w: 1 a shadow view's caster.)
    bool drawn = plantElementAt(int(chunk.x), int(chunk.y) + e, chunk.z, chunk.w > 0.5, pose, cr, species);
    uvec4 a, b, c, d;
    if (drawn) {
        plantPackPose(pose, cr, species, true, a, b, c, d);
    } else {
        a = c = d = uvec4(0u);
        b = uvec4(0u);
    }
    int slot = (chunkIndex * PLANT_LEAVES_PER_CHUNK + e) * PLANT_POSE_UVEC4;
    plantPoses.poses[slot] = a;
    plantPoses.poses[slot + 1] = b;
    plantPoses.poses[slot + 2] = c;
    plantPoses.poses[slot + 3] = d;
}

#include "foliage/plant_module.glsl"
