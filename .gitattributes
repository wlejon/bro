# Shell scripts and Linux config must stay LF so they work inside
# Docker/WSL/Linux even when checked out on Windows.
*.sh        text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# GLSL shaders are embedded verbatim as null-terminated byte arrays at build
# time (src/scene/CMakeLists.txt). They must stay LF on every platform: CRLF
# would change the embedded bytes and, worse, break the `\n` substring anchors
# that makeMeshInstancedFragSrc uses to derive the instanced shader from
# mesh.frag (silently dropping per-instance tinting on a CRLF checkout).
src/scene/shaders/* text eol=lf
