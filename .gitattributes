# Shell scripts and Linux config must stay LF so they work inside
# Docker/WSL/Linux even when checked out on Windows.
*.sh        text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# GLSL shaders are embedded verbatim as null-terminated byte arrays at build
# time (src/scene/CMakeLists.txt), the sources custom shaders and
# BRO_SCENE_SHADER_SOURCE compile at run time. They stay LF on every
# platform, so the embedded bytes are the same on every checkout.
src/scene/vulkan/shaders/** text eol=lf

# Patches apply to upstream sources byte for byte: a CRLF checkout turns a
# blank context line into "\r" and git apply calls the patch corrupt (the
# libvpx overlay port broke every Windows nightly that way).
*.patch     -text
